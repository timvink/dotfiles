###########
# Aliases
###########
#
# On Omarchy this file is sourced from ~/.bashrc after Omarchy's own aliases,
# so a name defined here overrides Omarchy's. Sections that Omarchy already
# covers, or that need something not yet ported, are fenced off with
# `ne $machine "omarchy"` (see DECISIONS.md); porting one means dropping its fence.

# Git stuff
alias gst='git status'
alias gp='git pull'
alias gc='git commit -m'
alias gco='git checkout'
alias gaa='git add --all && gst'
alias gl='git log --graph'
alias gpo='git push origin'
# git worktrees -- cd to main branch of worktree
gt_cdmain() {
    local common_dir
    common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
        echo "gt_cdmain: not inside a git repository" >&2
        return 1
    }
    cd "${common_dir}/.."
}

# File system
# alias ls='ls -lash'
alias grep='grep --color=auto'
alias cd2="cd ../.."
alias cd3="cd ../../.."
alias ...="cd ../.."
alias ....="cd ../../.."

# Bash commands
# `e` = leave this tmux tab. Plain `exit` only pops one shell level, so nested
# shells (a `chezmoi cd` subshell, a stacked `zsh`, etc.) need several `exit`s
# before the tab finally closes. `tmux kill-pane` destroys the pane's entire
# process tree at once, so one `e` always closes the tab. Outside tmux it just
# exits the shell. Matches the Claude Code `e` hook (see dot_claude/
# modify_settings.json), which kill-panes too. Note: over SSH ($TMUX is unset on
# the remote) `e` exits the remote shell first, as you'd want.
#
# If kill-pane can't reach the server (e.g. its /tmp socket was deleted, leaving
# the server orphaned), fall back to `exit` — that still closes the pane, since
# pane teardown happens over the pty, not the socket. The 2>/dev/null hides the
# "error connecting …" noise in that case.
e() {
    if [ -n "$TMUX" ]; then
        tmux kill-pane -t "${TMUX_PANE:-}" 2>/dev/null || exit
    else
        exit
    fi
}
# Overrides Omarchy's `c` (opencode).
alias c="clear"

{{ if ne $machine "omarchy" -}}
# Keep tmux's socket out of /tmp (macOS's periodic cleaner deletes it out from
# under a running server). The canonical export lives in ~/.zshenv so EVERY zsh
# — including non-interactive ones that may launch tmux — agrees on the socket;
# this copy just covers interactive bash, which never reads .zshenv. Keep the
# two in sync. See dot_zshenv for the full rationale.
# Not on Omarchy: its theme switch (omarchy-theme-set-tmux, and my tmux-theme
# hook) and omarchy-restart-tmux run outside any shell and look for the server
# on the default socket, and no cleaner touches /tmp there.
export TMUX_TMPDIR="${TMUX_TMPDIR:-$HOME/.cache/tmux}"
[ -d "$TMUX_TMPDIR" ] || mkdir -p "$TMUX_TMPDIR"
{{- end }}

# Reap a stale per-tab agent dot when the bash prompt returns: bash's twin of
# _agent_dot_reap in dot_zshrc.tmpl (see there for why; zsh also sources this
# file, hence the bash-only guard). Codex has no SessionEnd and a killed agent
# fires no hook, so their dot would otherwise linger. The sentinel path MUST
# match executable_agent-state's formula. Appended after starship's precmd and
# passes $? through, so the prompt still shows the last command's status.
if [ -n "${BASH_VERSION:-}" ]; then
    _agent_dot_reap_bash() {
        local rc=$?
        if [[ -n ${TMUX_PANE:-} && -e ${TMPDIR:-/tmp}/agent-dot-${TMUX_PANE#%} ]]; then
            "$HOME/.local/bin/agent-state" none
        fi
        return $rc
    }
    # A newline joins it on, which also works after a trailing `;`. Where
    # PROMPT_COMMAND is an array (bash 5.1+, as on Omarchy) this extends its
    # first element, which runs first.
    case "${PROMPT_COMMAND:-}" in
        *_agent_dot_reap_bash*) ;;
        *) PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND
}_agent_dot_reap_bash" ;;
    esac
fi

# tmux — get me into my persistent dev server. If any session is running, attach
# to the most-recently-used one (every other session/tab is one prefix+w or
# prefix+s away). Only when the server is completely empty — all sessions and
# tabs closed — bootstrap a fresh 'chezmoi' workspace: this machine's primary
# coding agent in tab 1, a plain shell in tab 2, both rooted in the chezmoi
# source dir.
# Tab 1 launches cc or co per the `codingAgent` chezmoi var (set at init); tmux
# automatic-rename then names the tab "claude" or "codex" off the running process.
#
# Deliberately NOT tied to a session named 'main': `tmux new -A -s main` hardcodes
# that name, so renaming or killing your top session strands you on a fresh empty
# `main` even though the rest of your work is still alive in the server. Attaching
# by no name instead means t always resumes wherever you left off, and only
# bootstraps when there is literally nothing to attach to (the server exits once
# its last session closes, so `tmux ls` failing is that signal).
#
# Never start tmux with plain `tmux` — that runs `new-session` and spawns a new
# numbered session every time, orphaning your running work. Always use `t`.
#
# The agent is the pane's own command, `$SHELL -ic '<agent>; exec $SHELL'`. $SHELL,
# not a bare zsh: Homebrew's zsh comes first on PATH, and a version different from
# the login shell's makes compinit rebuild its dump in both (~200ms). -i loads
# .zshrc so cc (a function) / co (an alias) and the private env exist, and the
# trailing exec drops you at a working shell once the agent quits. Not send-keys
# into a fresh shell: that waits for zsh to draw its first (starship) prompt and
# made the agent ~700ms slower to accept input. Per-project workspaces live in
# alt+f (the fuzzy project finder).
# Drop Omarchy's `t` alias first: bash would expand it inside `t() {`.
unalias t 2>/dev/null
t() {
    [ -n "$TMUX" ] && return                     # already inside tmux
    if tmux ls >/dev/null 2>&1; then             # server up → resume where I left off
        tmux attach
    else                                         # server empty → bootstrap chezmoi
        local dir="$HOME/.local/share/chezmoi"
        tmux new-session -d -s chezmoi -c "$dir" "$SHELL -ic '{{ if eq (dig "codingAgent" "claude" .) "codex" }}co{{ else }}cc{{ end }}; exec $SHELL'"
        tmux new-window -d -t chezmoi -c "$dir"
        tmux attach -t chezmoi:1
    fi
}

# Wrap `make` and `just` so serve*/docs* show a green port chip on the tab (next to the
# agent dot — see dot_tmux.conf) for the lifetime of the foreground server, then
# clears it on exit. A background server-port-watch sniffs out the listening
# port and fills it in. Other targets pass straight through. The subshell's
# EXIT trap clears the chip without changing the calling shell's traps;
# `command` avoids recursing into the wrappers. The watcher is launched in a
# subshell — `( … & )` — so the shell
# prints no "[1] 12345" job line; it self-exits when @server_state leaves
# running (set below), so there's no PID to track or kill. Only tracks
# foreground servers — a target that detaches (docker compose up -d) returns
# immediately, so the chip clears even though the container stays up. See
# dot_local/bin/executable_server-state.
run_tracked_server() (
    local runner=$1
    shift
    # Glob, not exact: catches serve_test, serve-prod, etc. — any serve*/docs*
    # variant. server-port-watch is name-agnostic (it diffs listening ports), so
    # this gate is the only thing coupled to the target name.
    case "${1:-}" in serve*|docs*) ;; *) command "$runner" "$@"; exit $? ;; esac
    server-state running
    trap 'server-state off' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    ( server-port-watch & )
    command "$runner" "$@"
    exit $?
)

make() {
    run_tracked_server make "$@"
}

just() {
    run_tracked_server just "$@"
}

# LLMs
#
# Inside tmux, Claude Code runs behind agent-pty (agent-pty/agent-pty.c): Claude
# reports its own state over OSC 7501 (working / blocked / done / idle, plus its
# subagents), but only to a terminal that answers the protocol's probe, and tmux
# doesn't. The shim answers it and turns the reports into the tab dot. Off a
# terminal, outside tmux, or where the shim didn't build, it's plain `claude`.
# Every wrapper below goes through this function.
claude() {
    local shim="$HOME/.local/libexec/agent-pty/claude"
    if [ -n "${TMUX_PANE:-}" ] && [ -t 0 ] && [ -t 1 ] && [ -x "$shim" ]; then
        "$shim" claude "$@"
    else
        command claude "$@"
    fi
}
cc() {
    if [ $# -eq 0 ]; then
        claude --dangerously-skip-permissions
    else
        claude --dangerously-skip-permissions -p "$@"
    fi
}
ccc() {
    if [ $# -eq 0 ]; then
        claude --dangerously-skip-permissions --chrome
    else
        claude --dangerously-skip-permissions --chrome -p "$@"
    fi
}
ccp() {
    if [[ -f "$1" ]]; then
        # We pass the file content to cc, which handles the -p flag
        cc "$(cat "$1")"
    else
        echo "Error: File '$1' not found."
        return 1
    fi
}
# Codex, fully auto-run (the cc → claude analogue: co → codex). `--yolo` (=
# --dangerously-bypass-approvals-and-sandbox) never prompts and drops the
# sandbox entirely. The earlier `-a never --sandbox workspace-write` setup was
# meant to keep writes confined, but the sandbox got in the way more than it
# helped — codex constantly tripped over blocked writes/network and needed
# escalations, so it's not worth it. Mirrors `cc`'s --dangerously-skip-
# permissions: trust the agent, lean on git to undo. A plain alias suffices —
# codex takes a positional prompt natively, so `co`, `co "<prompt>"` and
# `co exec "<prompt>"` all just work.
# Codex 0.166's shared server inherits TMUX_PANE from its first launcher, so
# hooks and agent-note from later tabs update that first tab. Keep each launch's
# server local to its process so the per-tab dots and notes stay with its pane.
alias co='codex --no-daemon --yolo'
# Claude Code via Azure AI Foundry (Sweden Central) instead of the
# Anthropic subscription — routes inference + billing through the platform's
# `aif-nwf-claude` Foundry account, authenticating with your `az login` token
# (Entra ID, no API key). Opt-in: plain `cc` still uses the Anthropic plan.
# Needs `az login` in the warmtefonds tenant first; the account is defined in
# nwf-ai-platform-infra (infra/global/platform.bicep). Subshell keeps the
# Foundry env out of the parent shell.
cca() {
    (
        export CLAUDE_CODE_USE_FOUNDRY=1
        export ANTHROPIC_FOUNDRY_RESOURCE=aif-nwf-claude
        if [ $# -eq 0 ]; then
            claude --dangerously-skip-permissions --model opus
        else
            claude --dangerously-skip-permissions --model opus -p "$@"
        fi
    )
}

{{ if ne $machine "omarchy" -}}
# Not on Omarchy yet: needs the rbw vault config (ssh/rbw port).
# pi (the Earendil coding agent) against my OpenRouter credits. pi takes the key
# from OPENROUTER_API_KEY or from ~/.pi/agent/auth.json, and both leave it lying
# around in plaintext — in the environment of every process pi spawns, or on
# disk in a file chezmoi can't manage because pi rewrites it at runtime. Reading
# it from the vault per launch keeps it to pi's own environment, and a new
# machine needs nothing pasted: `rbw unlock` and it works. Machines off the
# vault mesh (work devbox — no rbw) fall through to whatever pi finds itself.
pi() {
    local key
    if ! command -v rbw >/dev/null 2>&1; then
        command pi "$@"
        return
    fi
    if ! key=$(rbw get openrouter_api_key 2>/dev/null); then
        echo "pi: no OpenRouter key — vault locked? run: rbw unlock" >&2
        return 1
    fi
    OPENROUTER_API_KEY="$key" command pi "$@"
}
{{- end }}

## Home server
# `homelab` and `devbox` (SSH sessions with an image-paste window marker and a
# ~/Downloads mount) are scripts in ~/.local/bin; shared helpers in
# ~/.local/lib/remote-session.sh.

# Unlock the encrypted ZFS dataset on the homelab after a reboot and
# restart services that mount paths under /media/storage/private/.
# Runs locally if on the homelab, otherwise SSH-es into `homelab`.
zfs_unlock() {
    local repo=/media/storage/private/timvink-homelab
    # The list of services to (re)start lives inside the repo (which is on
    # the encrypted dataset), so it is read AFTER the dataset is mounted.
    # See $repo/post-unlock-services.txt — single source of truth.
    local stty_state
    printf "Enter ZFS passphrase for homelab: " >&2
    stty_state=$(stty -g 2>/dev/null || true)
    [ -n "$stty_state" ] && stty -echo
    IFS= read -r zfs_pass
    [ -n "$stty_state" ] && stty "$stty_state"
    printf "\n" >&2
    local cmd='
        set -e
        repo=/media/storage/private/timvink-homelab
        sudo zfs load-key raidpool/private
        sudo zfs mount raidpool/private
        while IFS= read -r svc; do
            [ -z "$svc" ] && continue
            case "$svc" in \#*) continue ;; esac
            [ -f "$repo/$svc/docker-compose.yml" ] &&
            docker compose --env-file "$repo/.env" -f "$repo/$svc/docker-compose.yml" up -d
        done < "$repo/post-unlock-services.txt"
        echo "Success!"
    '
    local rc
    if [ "$(hostname)" = "homelab" ]; then
        printf '%s\n' "$zfs_pass" | bash -c "$cmd"
        rc=$?
    else
        printf '%s\n' "$zfs_pass" | ssh -tt homelab "bash -c '$cmd'"
        rc=$?
    fi
    unset zfs_pass
    return $rc
}

