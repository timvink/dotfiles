# Bash commands
# `e` = leave this tmux tab. Plain `exit` only pops one shell level, so nested
# shells (a `chezmoi cd` subshell, a stacked `zsh`, etc.) need several `exit`s
# before the tab finally closes. `tmux kill-pane` destroys the pane's entire
# process tree at once, so one `e` always closes the tab. Outside tmux it just
# exits the shell. Matches the Claude Code `e` hook (see dot_claude/
# modify_settings.json), which kill-panes too. Note: over SSH ($TMUX is unset on
# the remote) `e` exits the remote shell first, as you'd want.
#
# If kill-pane can't reach the server (e.g. its /tmp socket was deleted, leaving
# the server orphaned), fall back to `exit` — that still closes the pane, since
# pane teardown happens over the pty, not the socket. The 2>/dev/null hides the
# "error connecting …" noise in that case.
e() {
    if [ -n "$TMUX" ]; then
        tmux kill-pane -t "${TMUX_PANE:-}" 2>/dev/null || exit
    else
        exit
    fi
}
alias c="clear"

# Keep tmux's socket out of /tmp (macOS's periodic cleaner deletes it out from
# under a running server). The canonical export lives in ~/.zshenv so EVERY zsh
# — including non-interactive ones that may launch tmux — agrees on the socket;
# this copy just covers interactive bash, which never reads .zshenv. Keep the
# two in sync. See dot_zshenv for the full rationale.
export TMUX_TMPDIR="${TMUX_TMPDIR:-$HOME/.cache/tmux}"
[ -d "$TMUX_TMPDIR" ] || mkdir -p "$TMUX_TMPDIR"

# tmux — get me into my persistent dev server. If any session is running, attach
# to the most-recently-used one (every other session/tab is one prefix+w or
# prefix+s away). Only when the server is completely empty — all sessions and
# tabs closed — bootstrap a fresh 'chezmoi' workspace: this machine's primary
# coding agent in tab 1, nvim in tab 2, both rooted in the chezmoi source dir.
# Tab 1 launches cc or co per the `codingAgent` chezmoi var (set at init); tmux
# automatic-rename then names the tab "claude" or "codex" off the running process.
#
# Deliberately NOT tied to a session named 'main': `tmux new -A -s main` hardcodes
# that name, so renaming or killing your top session strands you on a fresh empty
# `main` even though the rest of your work is still alive in the server. Attaching
# by no name instead means t always resumes wherever you left off, and only
# bootstraps when there is literally nothing to attach to (the server exits once
# its last session closes, so `tmux ls` failing is that signal).
#
# Never start tmux with plain `tmux` — that runs `new-session` and spawns a new
# numbered session every time, orphaning your running work. Always use `t`.
#
# The agent launcher (cc/co) and nvim go through send-keys into an interactive
# shell: cc is a shell function and co an alias, neither on PATH; nvim so that
# quitting it drops you at a working shell, not a dead pane. Per-project
# workspaces live in prefix+f (the fuzzy project finder).
t() {
    [ -n "$TMUX" ] && return                     # already inside tmux
    if tmux ls >/dev/null 2>&1; then             # server up → resume where I left off
        tmux attach
    else                                         # server empty → bootstrap chezmoi
        local dir="$HOME/.local/share/chezmoi"
        tmux new-session -d -s chezmoi -c "$dir"
        tmux send-keys  -t chezmoi {{ if eq (dig "codingAgent" "claude" .) "codex" }}co{{ else }}cc{{ end }} Enter
        tmux new-window -t chezmoi -c "$dir"
        tmux send-keys  -t chezmoi nvim Enter
        tmux select-window -t chezmoi:1
        tmux attach -t chezmoi
    fi
}

# Python
alias venv='source .venv/bin/activate'

# Wrap `make` so `make serve`/`make docs` show a green port chip on the tab (next to the
# agent dot — see dot_tmux.conf) for the lifetime of the foreground server, then
# clears it on exit. A background server-port-watch sniffs out the listening
# port and fills it in. Every other make target passes straight through. The
# INT/TERM trap clears the chip on Ctrl-C; `command make` avoids recursing into
# this wrapper. The watcher is launched in a subshell — `( … & )` — so the shell
# prints no "[1] 12345" job line; it self-exits when @server_state leaves
# running (set below), so there's no PID to track or kill. Only tracks
# foreground servers — a target that detaches (docker compose up -d) returns
# immediately, so the chip clears even though the container stays up. See
# dot_local/bin/executable_server-state.
make() {
    # Glob, not exact: catches serve_test, serve-prod, etc. — any serve*/docs*
    # variant. server-port-watch is name-agnostic (it diffs listening ports), so
    # this gate is the only thing coupled to the target name.
    case "$1" in serve*|docs*) ;; *) command make "$@"; return ;; esac
    server-state running
    ( server-port-watch & )
    trap 'server-state off' INT TERM
    command make "$@"; local rc=$?
    server-state off
    trap - INT TERM
    return $rc
}

# LLMs
cc() {
    if [ $# -eq 0 ]; then
        claude --dangerously-skip-permissions
    else
        claude --dangerously-skip-permissions -p "$@"
    fi
}
ccc() {
    if [ $# -eq 0 ]; then
        claude --dangerously-skip-permissions --chrome
    else
        claude --dangerously-skip-permissions --chrome -p "$@"
    fi
}
ccp() {
    if [[ -f "$1" ]]; then
        # We pass the file content to cc, which handles the -p flag
        cc "$(cat "$1")"
    else
        echo "Error: File '$1' not found."
        return 1
    fi
}
# Start Claude in an isolated git worktree under .claude/worktrees/<name>/.
# Native worktree support handles branch creation, .worktreeinclude copying
# and cleanup on exit, so this is just a thin wrapper (cc() can't take flags —
# it folds every arg into -p). No name → Claude generates one (and we can't
# rename the tab since we don't know it). Inside tmux, name the tab "cc <name>"
# so the worktree stands out in the prefix+w tree and prefix+o montage; the
# manual rename also disables automatic-rename-format, which would relabel it
# "claude" the moment the agent starts.
ccw() {
    if [ -n "$TMUX" ] && [ -n "$1" ]; then
        tmux rename-window "cc $1"
    fi
    claude --dangerously-skip-permissions --worktree "$@"
}
# Codex, fully auto-run (the cc → claude analogue: co → codex). `--yolo` (=
# --dangerously-bypass-approvals-and-sandbox) never prompts and drops the
# sandbox entirely. The earlier `-a never --sandbox workspace-write` setup was
# meant to keep writes confined, but the sandbox got in the way more than it
# helped — codex constantly tripped over blocked writes/network and needed
# escalations, so it's not worth it. Mirrors `cc`'s --dangerously-skip-
# permissions: trust the agent, lean on git to undo. A plain alias suffices —
# codex takes a positional prompt natively, so `co`, `co "<prompt>"` and
# `co exec "<prompt>"` all just work.
alias co='codex --yolo'
# Claude Code via Azure AI Foundry (Opus 4.8, Sweden Central) instead of the
# Anthropic subscription — routes inference + billing through the platform's
# `aif-nwf-claude` Foundry account, authenticating with your `az login` token
# (Entra ID, no API key). Opt-in: plain `cc` still uses the Anthropic plan.
# Needs `az login` in the warmtefonds tenant first; the account is defined in
# nwf-ai-platform-infra (infra/global/platform.bicep). opus-only account, so all
# three model aliases point at the one deployment — that way background tasks
# (title gen, etc.) don't 404 on a missing Sonnet/Haiku. Subshell keeps the
# Foundry env out of the parent shell.
cca() {
    (
        export CLAUDE_CODE_USE_FOUNDRY=1
        export ANTHROPIC_FOUNDRY_RESOURCE=aif-nwf-claude
        export ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-8
        export ANTHROPIC_DEFAULT_SONNET_MODEL=claude-opus-4-8
        export ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-opus-4-8
        if [ $# -eq 0 ]; then
            claude --dangerously-skip-permissions --model opus
        else
            claude --dangerously-skip-permissions --model opus -p "$@"
        fi
    )
}

# pi (the Earendil coding agent) against my OpenRouter credits. pi takes the key
# from OPENROUTER_API_KEY or from ~/.pi/agent/auth.json, and both leave it lying
# around in plaintext — in the environment of every process pi spawns, or on
# disk in a file chezmoi can't manage because pi rewrites it at runtime. Reading
# it from the vault per launch keeps it to pi's own environment, and a new
# machine needs nothing pasted: `rbw unlock` and it works. Machines off the
# vault mesh (work devbox — no rbw) fall through to whatever pi finds itself.
pi() {
    local key
    if ! command -v rbw >/dev/null 2>&1; then
        command pi "$@"
        return
    fi
    if ! key=$(rbw get openrouter_api_key 2>/dev/null); then
        echo "pi: no OpenRouter key — vault locked? run: rbw unlock" >&2
        return 1
    fi
    OPENROUTER_API_KEY="$key" command pi "$@"
}

# Mark a remote SSH session as live, so Ghostty's ⌘V knows to upload a clipboard
# image to the box instead of handing it to a local app. Pass 1 on connect, 0 on
# disconnect. ssh-image-paste tests for this file.
#
# Why a file and not the ControlMaster socket it uploads over: ControlPersist
# keeps that socket warm for 30m AFTER you disconnect, so probing it alone would
# treat a local Ghostty window as remote for half an hour and type a path into it
# that nothing local can open. The socket answers "which host", this answers
# "am I in a session at all".
#
# It sits next to the cm-*.sock files it pairs with. Both devbox() and homelab()
# also clear it via a signal trap, so an abruptly-killed session (terminal window
# closed → SIGHUP) can't leave it stuck and hijack ⌘V in local Ghostty windows.
# See ~/.local/bin/ssh-image-paste.
REMOTE_SSH_FLAG="$HOME/.ssh/remote-session-active"
_remote_ssh_flag() {
  if [ "$1" = 1 ]; then : > "$REMOTE_SSH_FLAG"; else rm -f "$REMOTE_SSH_FLAG"; fi
}

## Home server
# SSH into the homelab and drop into the timvink-homelab repo. A function, not an
# alias, so — like devbox() below — it can flag the image-paste session (see
# _remote_ssh_flag) for the duration of the connection. The upload rides the
# reusable ControlMaster socket set up in ~/.ssh/config's `Host homelab` block.
homelab() {
  _remote_ssh_flag 1
  # Auto-mount ~/Downloads (read-write) at homelab:~/mac-downloads for this session
  # (see the reverse-mount helpers below); the backgrounded waiter brings it up once
  # the master is live, and it's torn down on exit. $_mnt is that waiter, killed in
  # case it's still polling when we leave.
  _revmount_bg homelab homelab &
  local _mnt=$!
  # Reset the flag and unmount even if the session dies abruptly (terminal closed →
  # SIGHUP, or killed) and skips the normal cleanup below; the handler clears itself
  # so the trap never leaks into the interactive shell. INT/TERM/HUP behave the same
  # in bash and zsh.
  trap "_remote_ssh_flag 0; kill $_mnt 2>/dev/null; _revumount homelab homelab; trap - INT TERM HUP" INT TERM HUP
  ssh -t homelab "cd /media/storage/private/timvink-homelab/ && exec \$SHELL -l"
  kill "$_mnt" 2>/dev/null
  _revumount homelab homelab
  trap - INT TERM HUP
  _remote_ssh_flag 0
}

# Unlock the encrypted ZFS dataset on the homelab after a reboot and
# restart services that mount paths under /media/storage/private/.
# Runs locally if on the homelab, otherwise SSH-es into `homelab`.
zfs_unlock() {
    local repo=/media/storage/private/timvink-homelab
    # The list of services to (re)start lives inside the repo (which is on
    # the encrypted dataset), so it is read AFTER the dataset is mounted.
    # See $repo/post-unlock-services.txt — single source of truth.
    local stty_state
    printf "Enter ZFS passphrase for homelab: " >&2
    stty_state=$(stty -g 2>/dev/null || true)
    [ -n "$stty_state" ] && stty -echo
    IFS= read -r zfs_pass
    [ -n "$stty_state" ] && stty "$stty_state"
    printf "\n" >&2
    local cmd='
        set -e
        repo=/media/storage/private/timvink-homelab
        sudo zfs load-key raidpool/private
        sudo zfs mount raidpool/private
        while IFS= read -r svc; do
            [ -z "$svc" ] && continue
            case "$svc" in \#*) continue ;; esac
            [ -f "$repo/$svc/docker-compose.yml" ] &&
            docker compose --env-file "$repo/.env" -f "$repo/$svc/docker-compose.yml" up -d
        done < "$repo/post-unlock-services.txt"
        echo "Success!"
    '
    local rc
    if [ "$(hostname)" = "homelab" ]; then
        printf '%s\n' "$zfs_pass" | bash -c "$cmd"
        rc=$?
    else
        printf '%s\n' "$zfs_pass" | ssh -tt homelab "bash -c '$cmd'"
        rc=$?
    fi
    unset zfs_pass
    return $rc
}

## Azure
# SSH into my Azure devbox VM. Two tunnels ride the connection:
#   -D 1080  SOCKS proxy → view any dev server as http://devbox:<port> (the PAC
#            in ~/.config/proxy.pac routes the `devbox` host through it; the box
#            resolves `devbox` to its own loopback).
#   -R 2489  reverse tunnel → the box's xdg-open shim sends URLs back to the
#            open-url-listener here so links open in this Mac's browser.
# A third option rides it too: -o ControlMaster lets `ssh-image-paste` reuse this
# connection to stream a clipboard image into the box's /tmp on ⌘V. `devbox` is a
# function (not an alias) so it can also flag the image-paste session (see
# _remote_ssh_flag) for the session's duration; the same flag is shared with
# homelab() above. See ~/.local/bin/xdg-open (box), and ~/.local/bin/open-url-listener +
# ~/.local/bin/ssh-image-paste (this Mac).
#
# The session itself is _devbox_session below; this wrapper owns only the Karabiner
# flag and the one retry. If the box refuses the -R 2489 bind because a dead session
# still holds the port, _devbox_reclaim_fwd clears it and we reconnect once. A second
# failure means something is holding it that the reclaim deliberately won't kill (it
# prints which), so we stop rather than loop.
devbox() {
  _remote_ssh_flag 1
  local rc
  _devbox_session; rc=$?
  if [ "$rc" -eq 2 ] && _devbox_reclaim_fwd; then
    # The port really was stale, so nothing live is using the bridge: drop whatever the
    # dead session left behind locally, or _revmount would see a live-looking pidfile and
    # skip mounting ~/mac-downloads for the session we're about to open.
    _revumount_devbox
    _devbox_session
  fi
  _remote_ssh_flag 0
}

# One connect attempt: make sure a usable master exists, ride it into an interactive
# shell, tear the mount down on the way out. Returns 2 — and only 2 — when the box
# refused the -R 2489 bind, the one failure devbox() knows how to heal.
_devbox_session() {
  # Must come first: a dead master left over from a previous session would otherwise
  # swallow this connect whole, and the mount waiter below would latch onto it too.
  _devbox_drop_dead_master
  local rc conn user host
  _devbox_ensure_master; rc=$?
  [ "$rc" -eq 0 ] || return "$rc"
  conn="$(_devbox_conn)"
  if [ -z "$conn" ]; then
    printf '%s\n' "devbox: the master is up but its address can't be resolved — re-run devbox" >&2
    return 1
  fi
  read -r user host <<< "$conn"
  # Auto-mount ~/Downloads (read-write) at devbox:~/mac-downloads for this session
  # (see the reverse-mount helpers below). The waiter mounts as soon as the master
  # answers and is torn down on exit; $_mnt is that waiter, killed if still polling.
  # It lives here rather than in devbox() so a retried attempt gets a *fresh* waiter:
  # its poll window is only ~30s, which a failed attempt plus a reclaim would burn.
  _revmount_bg_devbox &
  local _mnt=$!
  # Reset the flag and unmount even if the session dies abruptly (terminal closed →
  # SIGHUP, or killed) and skips the normal cleanup below; the handler clears itself
  # so the trap never leaks into the interactive shell. INT/TERM/HUP behave the same
  # in bash and zsh.
  trap "_remote_ssh_flag 0; kill $_mnt 2>/dev/null; _revumount_devbox; trap - INT TERM HUP" INT TERM HUP
  # The shell itself is a plain mux client, NOT az — and that is what makes exiting
  # instant. az waits on the ssh process it spawns, and under ControlMaster that same
  # process goes on to serve the master, so an az-run session can't return until the
  # master dies: with ControlPersist that's up to half an hour, and with the mount
  # bridge attached (a mux session keeps the master alive) it is never. Exiting looked
  # like a frozen terminal. A mux client exits the moment the shell does.
  # The terminal is quiet for free too: az's forced -v and the "channel N: open failed"
  # spam the forwards emit (a browser tab still pointing at a devbox:<port> dev server
  # that has since stopped) belong to the master and now land in its log, not here.
  ssh -o ControlPath="$HOME/.ssh/cm-devbox.sock" -o User="$user" "$host"
  kill "$_mnt" 2>/dev/null
  _revumount_devbox
  trap - INT TERM HUP
  return 0
}

# Bring up the shared master unless one is already running, and leave it in the background
# for the next devbox to reuse — ControlPersist keeps it ~30m after the last client leaves,
# so a reconnect within that window costs nothing and needs no az round trip at all.
# Returns 2 when the box refused the -R 2489 bind, 1 when the connection never came up.
_devbox_ensure_master() {
  local sock="$HOME/.ssh/cm-devbox.sock" log rc=0 i
  # _devbox_drop_dead_master ran first, so a socket still here has answered a round trip.
  [ -S "$sock" ] && return 0
  log="$(mktemp "${TMPDIR:-/tmp}/devbox-master.XXXXXX" 2>/dev/null)"
  [ -n "$log" ] || log="${TMPDIR:-/tmp}/devbox-master.$$"
  printf '%s\n' "devbox: opening a connection…" >&2
  # --only-show-errors silences the ssh extension's unconditional "upgrade to az ssh
  # >=2.0.4" breaking-change banner (hardcoded in azext_ssh, fires on every `az ssh vm`
  # regardless of installed version) without hiding real az errors like auth failures
  # or a missing VM.
  #
  # -N -f: no remote command, and fork into the background once authenticated with the
  # forwards up. The fork re-parents the master to init, and it serves clients from that
  # moment — but az does NOT return when it happens: it goes on waiting for EOF on the
  # stderr pipe the master inherited, i.e. for the master's entire life. So az is put in
  # the background too and we wait for the socket instead of for az. That leftover wait is
  # useful rather than merely harmless: it is what makes az clean up the ephemeral AAD
  # cert once the master finally exits. The subshell keeps the shell from announcing it
  # with a job-control line.
  #
  # Its output can't be quietened, only redirected: this is an AAD login, so azext_ssh
  # sets delete_cert and force-injects its OWN `-v` into the ssh command (ssh_utils.py,
  # to parse the log for auth success and clean up that cert). A command-line `-v` pins
  # LogLevel=DEBUG and unconditionally beats any `-o LogLevel` we pass (that only applies
  # while the level is still unset). So it goes to $log, which is shown only if the master
  # never appears, and which the master keeps writing to through the unlink below — that
  # is deliberate: it swallows the channel spam for the master's whole life. (homelab uses
  # plain ssh with no injected `-v`, so its `LogLevel FATAL` in ~/.ssh/config just works.)
  #
  # -o ExitOnForwardFailure=yes: if -R 2489 (or -D 1080) can't bind, fail loudly rather
  # than leave a master that silently lacks its tunnels — a lost -R 2489 bind kills
  # prefix+u URL-opening (the box's xdg-open shim can't reach the listener here) with no
  # signal at all. The stale port does NOT necessarily clear on its own, so devbox()
  # reclaims it — see _devbox_reclaim_fwd.
  #
  # -o ServerAliveInterval/CountMax: bound how long this master can outlive its own
  # connection. Without keepalives a master whose peer vanished (IP change, sleep) sits
  # there for the full persist window looking healthy, and it is exactly what the next
  # devbox rides into a hang — see _devbox_drop_dead_master, which cleans up the ones that
  # slip through this ~60s window. A blip shorter than that rides through untouched.
  ( az ssh vm -n vm-devbox-tim-vink -g rg-nwf-devbox-tim-vink --only-show-errors -- \
      -N -f -D 1080 -R 2489:127.0.0.1:2489 \
      -o ControlMaster=yes -o ControlPath="$sock" -o ControlPersist=30m \
      -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
      -o ExitOnForwardFailure=yes >/dev/null 2>"$log" & )
  # Wait for the socket, or for the log to explain why there won't be one. az's exit
  # status is no help even when we do wait for it: it exits 0 whether ssh connected or
  # aborted on ExitOnForwardFailure.
  for i in $(seq 1 90); do
    [ -S "$sock" ] && break
    grep -qE 'remote port forwarding failed for listen port|Could not request|Permission denied|^ERROR:' "$log" 2>/dev/null && break
    sleep 0.5
  done
  if [ -S "$sock" ]; then
    rc=0
  elif grep -q 'remote port forwarding failed for listen port 2489' "$log" 2>/dev/null; then
    rc=2
  else
    rc=1
    printf '%s\n' "devbox: the connection didn't come up —" >&2
    grep -vE '^debug[0-9]|^OpenSSH_|^Transferred:|^Bytes per second:' "$log" 2>/dev/null | tail -5 >&2
  fi
  rm -f "$log"
  return "$rc"
}

# Drop a ControlPersist master that has no live connection left under it. Same trigger as
# the reclaim below — this Mac's public IP changes (network switch, roam, sleep/wake) — but
# this is the local half of the damage: the master process survives with its socket in
# place, and `ssh -O check` still answers "Master running" because it only ever asks that
# local process, never the network. _devbox_ensure_master would then hand that socket to
# the session, which rides it straight into a black hole and hangs indefinitely: no error,
# and no ExitOnForwardFailure to catch it either, since a mux client requests no forwards
# of its own. That is one of the two frozen terminals this file guards against (the other
# is in _devbox_session), and only a real round trip can tell it apart from a healthy one.
_devbox_drop_dead_master() {
  local sock="$HOME/.ssh/cm-devbox.sock" conn user host
  [ -S "$sock" ] || return 0
  # The probe has to be bounded or the check becomes the hang it is meant to prevent;
  # without `timeout` (coreutils) don't ask at all, and let the connect take its chances.
  command -v timeout >/dev/null 2>&1 || return 0
  conn="$(_devbox_conn)"
  [ -n "$conn" ] || return 0
  read -r user host <<< "$conn"
  timeout 8 ssh -n -o BatchMode=yes -o ControlPath="$sock" -o User="$user" "$host" true 2>/dev/null && return 0
  printf '%s\n' "devbox: the previous session's master is unreachable (IP changed?) — dropping it" >&2
  timeout 5 ssh -O exit -o ControlPath="$sock" -o User="$user" "$host" 2>/dev/null
  # -O exit asks a master that may itself be wedged, so don't trust it alone: kill whatever
  # still rides that socket (the master, and the reverse-mount bridge multiplexed over it —
  # one was found still hung 1h39m after its connection died), then clear the socket and the
  # local half of the mount so the reconnect below starts from nothing.
  pkill -f 'cm-devbox\.sock' 2>/dev/null
  rm -f "$sock"
  _revumount_devbox
}

# Reclaim the box's -R 2489 bind from a session that died without the box noticing, so
# devbox() can retry. The remote half of the same IP-change damage: the old TCP connection
# is never torn down, so the box keeps the session and with it the port. sshd's own
# ClientAliveInterval (120s ×3) does not rescue it — sshd sits blocked writing to the
# vanished peer with data stuck in Send-Q and never reaches its keepalive timeout, so
# orphans outlive the 30m ControlPersist window indefinitely (one was seen at 43 minutes
# and counting).
#
# Safety rule: kill the holder ONLY when its peer IP differs from the IP we are connecting
# from now. Same IP ⇒ it's a live devbox session in another window of this Mac and the port
# is legitimately taken — say so and leave it alone. `sudo -n` is required because the
# forward's listening socket belongs to sshd, and `ss` hides the owning pid without it (the
# box has NOPASSWD sudo); lacking that we can see the port is taken but not by whom, which
# is not enough to kill anything. Returns 0 when the port is free to retry, 1 when it isn't.
_devbox_reclaim_fwd() {
  local out
  printf '%s\n' "devbox: the box refused the -R 2489 bind — checking for a dead session…" >&2
  out="$(az ssh vm -n vm-devbox-tim-vink -g rg-nwf-devbox-tim-vink --only-show-errors -- \
    -T -o BatchMode=yes -o ConnectTimeout=10 '
      port=2489
      me=${SSH_CLIENT%% *}
      holder=$(sudo -n ss -ltnpH "( sport = :$port )" 2>/dev/null | grep -o "pid=[0-9]*" | head -1 | cut -d= -f2)
      if [ -z "$holder" ]; then
        if ss -ltnH "( sport = :$port )" 2>/dev/null | grep -q .; then echo RECLAIM:opaque; else echo RECLAIM:free; fi
        exit
      fi
      peer=$(sudo -n ss -tnpH state established "( sport = :22 )" 2>/dev/null |
             grep "pid=$holder," | head -1 | awk "{print \$4}" | sed "s/:[0-9]*$//")
      if [ -n "$peer" ] && [ "$peer" = "$me" ]; then echo RECLAIM:live; exit; fi
      kill "$holder" 2>/dev/null || sudo -n kill "$holder" 2>/dev/null
      i=0
      while [ "$i" -lt 10 ]; do
        ss -ltnH "( sport = :$port )" 2>/dev/null | grep -q . || { echo RECLAIM:killed; exit; }
        sleep 0.5; i=$((i+1))
      done
      echo RECLAIM:stuck' 2>/dev/null)"
  case "$out" in
    *RECLAIM:killed*)
      printf '%s\n' "devbox: cleared a stale session that still held port 2489 — reconnecting" >&2; return 0 ;;
    *RECLAIM:free*)
      printf '%s\n' "devbox: port 2489 is free again — reconnecting" >&2; return 0 ;;
    *RECLAIM:live*)
      printf '%s\n' "devbox: port 2489 is held by another live devbox session from this Mac — exit that one first (URL-opening rides a single tunnel)" >&2; return 1 ;;
    *RECLAIM:opaque*)
      printf '%s\n' "devbox: port 2489 is taken on the box but sudo -n can't say by whom — re-run devbox once it clears" >&2; return 1 ;;
    *RECLAIM:stuck*)
      printf '%s\n' "devbox: killed the session holding port 2489 but it hasn't released — re-run devbox in a moment" >&2; return 1 ;;
    *)
      printf '%s\n' "devbox: couldn't reach the box to check port 2489" >&2; return 1 ;;
  esac
}

## Reverse ~/Downloads mounts
# devbox() and homelab() above auto-mount this Mac's ~/Downloads onto the box as
# ~/mac-downloads for the life of the session, so from a remote shell you can just
# `cp ~/mac-downloads/foo.xlsx .` to pull a Mac file onto the box — no separate
# command to run or remember. It's a *reverse* sshfs: the FUSE mount lives on the
# Linux box (it has /dev/fuse + fusermount3); sshfs there runs in slave mode
# (-o slave), speaking SFTP over stdin/stdout instead of dialing out. On this side,
# `dpipe` (from the `vde` brew) wires the box's sshfs to our built-in
# /usr/libexec/sftp-server, so nothing new has to listen on the Mac — it all rides
# the SSH ControlMaster the connect function already set up. Mounted read-write so
# it also works the other way: `downloadfile <path>` on the box (~/.local/bin) copies
# a file INTO ~/mac-downloads and it lands in this Mac's ~/Downloads. Needs sshfs on
# each box (run_onchange_setup_packages_linux.sh) and vde on the Mac
# (.chezmoiscripts/…_darwin.sh).
#
# Resolve "<user> <host>" for the live devbox connection without hardcoding the
# VM's public IP (it changes across deallocations): parse it off the `ssh <ip> -l
# <user> …` child that az spawned, and cache it. Once an interactive session
# exits, ControlPersist retitles that process to "[mux]" and the args vanish, so
# in the persist window we fall back to the cache (trusted only while the master
# socket still exists). Empty if there's no usable connection at all.
_devbox_conn() {
  local cache="$HOME/.ssh/cm-devbox.conn" conn
  conn="$(ps -Ao args 2>/dev/null | grep -F 'cm-devbox.sock' | awk '
    {u="";h="";for(i=1;i<=NF;i++){if($i=="-l")u=$(i+1);if($i=="ssh")h=$(i+1)}
     if(u!=""&&h!=""){print u" "h; exit}}')"
  if [ -n "$conn" ]; then
    printf '%s\n' "$conn" > "$cache"
    printf '%s\n' "$conn"
  elif [ -S "$HOME/.ssh/cm-devbox.sock" ] && [ -f "$cache" ]; then
    cat "$cache"
  fi
}

# Bring up the bridge once. $1=tag (names the pidfile); rest = ssh destination args
# (OPTIONS FIRST, host last — ssh stops parsing options at the destination). No-op if
# dpipe is absent (e.g. when this file is sourced on a Linux box) or the bridge is
# already up. The remote sh expands ~ and $(id …) on the box; "$macdl" (the Mac's
# Downloads path) is spliced in literally for the slave-mode sshfs to serve.
_revmount() {
  local tag="$1"; shift
  local pidfile="$HOME/.ssh/revmount-$tag.pid" macdl="$HOME/Downloads"
  command -v dpipe >/dev/null 2>&1 || return 0
  [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null && return 0
  # Force-clear any stale mountpoint before mounting. An abrupt teardown (laptop sleep,
  # network drop, `pkill`-ing the master) kills the bridge without unmounting the box's
  # sshfs, leaving a wedged FUSE mount at ~/mac-downloads. Since it lives inside $HOME,
  # the next login shell HANGS the moment its prompt/rc stats ~. A lazy unmount (-z)
  # detaches it even while "busy" so the fresh sshfs re-mounts cleanly; it's a harmless
  # no-op when nothing is mounted. This makes reconnect self-healing.
  dpipe /usr/libexec/sftp-server = \
    ssh -o RequestTTY=no -o BatchMode=yes "$@" \
      'fusermount3 -uz ~/mac-downloads 2>/dev/null || fusermount -uz ~/mac-downloads 2>/dev/null; mkdir -p ~/mac-downloads && exec sshfs :'"$macdl"' ~/mac-downloads -o slave,reconnect,uid=$(id -u),gid=$(id -g)' &
  echo $! > "$pidfile"
}

# Background waiter: poll (~30s) until the master named by the ssh dest is up, then
# mount. Launch with a trailing & from the connect function. $1=tag; rest = ssh dest.
_revmount_bg() {
  command -v dpipe >/dev/null 2>&1 || return 0
  local tag="$1"; shift
  local i
  for i in $(seq 1 60); do
    if ssh -O check "$@" 2>/dev/null; then _revmount "$tag" "$@"; return 0; fi
    sleep 0.5
  done
}

# devbox variant: its dest (User + host) isn't known until az brings the session up,
# so resolve it from _devbox_conn on each poll. Launch backgrounded with a trailing &.
_revmount_bg_devbox() {
  command -v dpipe >/dev/null 2>&1 || return 0
  local conn user host i
  for i in $(seq 1 60); do
    conn="$(_devbox_conn)"
    if [ -n "$conn" ]; then
      read -r user host <<< "$conn"
      if ssh -O check -o ControlPath="$HOME/.ssh/cm-devbox.sock" -o User="$user" "$host" 2>/dev/null; then
        _revmount devbox -o ControlPath="$HOME/.ssh/cm-devbox.sock" -o User="$user" "$host"
        return 0
      fi
    fi
    sleep 0.5
  done
}

# Tear down tag's bridge: unmount on the box (best effort — killing the local bridge
# also EOFs the box's sshfs so it self-unmounts) then drop the local processes.
# $1=tag; rest = ssh dest args (may be empty if the box is no longer reachable).
#
# This runs on the way OUT of a session, so it must never be able to block the shell
# you're returning to — and it used to. The remote unmount is the only step in the
# whole exit path that talks to the box, and when that connection is a black hole
# (VM deallocated under us, laptop slept, network switched) ssh waits forever:
# silently, since stderr is dropped, and holding the terminal's stdin. Exiting the
# session then looks like a frozen terminal with only Ctrl-C to escape. Hence:
#   timeout 10        hard ceiling; over a live connection this takes well under 1s.
#   -n                stdin from /dev/null, so a stalled ssh can't eat keystrokes.
#   ConnectTimeout=5  bounds the fallback path when the master socket is already gone.
#   -uz               lazy unmount, same as _revmount: against a stalled-but-alive
#                     sshfs a plain umount(2) blocks in the kernel, while MNT_DETACH
#                     returns at once and still frees ~/mac-downloads — which matters,
#                     because a mount left wedged hangs the box's NEXT login shell
#                     (see _revmount).
# Keepalives would only shorten the stall, not remove it, so the ceiling is the fix.
# Without `timeout` (coreutils: brew on macOS, base on Linux) skip the remote unmount
# rather than reintroduce the hang — _revmount's -uz heals the leftover on reconnect.
_revumount() {
  local tag="$1"; shift
  local pidfile="$HOME/.ssh/revmount-$tag.pid" pid rc
  if [ $# -gt 0 ] && command -v timeout >/dev/null 2>&1; then
    timeout 10 ssh -n -o BatchMode=yes -o ConnectTimeout=5 "$@" \
      'fusermount3 -uz ~/mac-downloads 2>/dev/null || fusermount -uz ~/mac-downloads 2>/dev/null' 2>/dev/null
    rc=$?
    [ "$rc" = 124 ] && printf '%s\n' \
      "note: remote unmount of ~/mac-downloads timed out — it clears on next connect" >&2
  fi
  if [ -f "$pidfile" ]; then
    pid="$(cat "$pidfile" 2>/dev/null)"
    [ -n "$pid" ] && { kill "$pid" 2>/dev/null; pkill -P "$pid" 2>/dev/null; }
    rm -f "$pidfile"
  fi
}

# devbox teardown: resolve the dest while we still can (the socket persists ~30m after
# exit), else just kill the local bridge.
_revumount_devbox() {
  local conn user host
  conn="$(_devbox_conn)"
  if [ -n "$conn" ]; then
    read -r user host <<< "$conn"
    _revumount devbox -o ControlPath="$HOME/.ssh/cm-devbox.sock" -o User="$user" "$host"
  else
    _revumount devbox
  fi
}

