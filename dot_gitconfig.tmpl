# No core.editor: git falls back to $EDITOR, so the editor is set in one place.
[core]
	excludesfile = ~/.gitignore-global
	pager = diff-so-fancy | less --tabs=4 -RF

[user]
	name = Tim Vink
	email = vinktim@proton.me
{{- $machine := includeTemplate "machine" . }}
{{- if eq $machine "mac" }}
	signingkey = 4CDBF86004E5D790
{{- else if eq $machine "omarchy" }}
	# This laptop's own key (ed25519, made 2026-11-06), uploaded to GitHub with
	# `gh gpg-key add`. Key ids are public; the secret key stays in ~/.gnupg.
	signingkey = 43DDD099D7D191BE
{{- end }}

[push]
	autoSetupRemote = true

# Same as Omarchy's ~/.config/git/config, which git reads before this file:
# rebase local commits onto the remote instead of merging. New repos on main.
[pull]
	rebase = true

[init]
	defaultBranch = main

[format]
	pretty = format:%C(auto)%h %d%Creset %s%n%Cgreen%ad%Creset %aN <%aE>%n

[interactive]
	diffFilter = diff-so-fancy --patch

{{ if eq .chezmoi.os "darwin" -}}
[gpg]
    program = /opt/homebrew/bin/gpg
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# TEMPORARY (2026-10-28): macOS 27.2's /etc/ssl/cert.pem still trusts the
# compromised eMudhra roots (https://emudhra.we-have-a-problem.com/apple.html),
# and git's macOS libcurl reads it. Homebrew's ca-certificates bundle has them
# removed. Drop this (and ~/.curlrc) once Apple ships a fix; verify with
# `GIT_CONFIG_GLOBAL=/dev/null git ls-remote https://git-emudhra.we-have-a-problem.com/check.git`
# — a certificate error means the system bundle is safe.
[http]
	sslCAInfo = /opt/homebrew/etc/ca-certificates/cert.pem
{{- end }}

{{ if or (eq $machine "mac") (eq $machine "omarchy") -}}
[commit]
	gpgsign = true
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# Git Credential Manager — browser/Entra OAuth for Azure Repos, GitHub, etc.
# Installed via Homebrew; the empty first helper resets inherited helpers (e.g. osxkeychain).
[credential]
	helper =
	helper = /usr/local/bin/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
{{- end }}

{{ if eq .chezmoi.os "linux" -}}
# Linux (remote VMs): authenticate GitHub HTTPS via the gh CLI, which holds the
# OAuth token (`gh auth login`). Equivalent to `gh auth setup-git`, but kept in
# source so `chezmoi apply` doesn't clobber it. PATH-resolved `gh` so it works
# regardless of install location. The empty first helper resets inherited ones.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
{{- end }}
