+
+// Vaultwarden 1.37 requires `encryptedFor` (the user id the cipher is
+// encrypted for) on cipher create/update; it is the `sub` claim of the
+// access token.
+fn user_id_from_access_token(access_token: &str) -> Option<String> {
+    use base64::Engine as _;
+    let payload = access_token.split('.').nth(1)?;
+    let bytes = base64::engine::general_purpose::URL_SAFE_NO_PAD
+        .decode(payload.trim_end_matches('='))
+        .ok()?;
+    let claims: serde_json::Value = serde_json::from_slice(&bytes).ok()?;
+    claims.get("sub")?.as_str().map(std::string::ToString::to_string)
+}
