# This repo's own docs and project agent-instructions, not dotfiles for $HOME.
# AGENTS.md is the canonical file (read by Codex/Antigravity/etc.); CLAUDE.md is
# a symlink to it because Claude Code reads CLAUDE.md, not AGENTS.md. Ignore both.
README.md
AGENTS.md
CLAUDE.md

# Python bytecode caches. tmux-overview is a python script, so running it from
# the source dir drops a __pycache__ next to it; chezmoi would then treat that
# as a managed file and prompt on every apply.
**/__pycache__

# Canonical cross-tool agent config (AGENTS.md + skills/) lives here but is
# symlinked into ~/.claude and ~/.codex (see agents/README.md), so chezmoi must
# NOT also copy it to ~/agents.
agents

# Machine-class gates, prompted at `chezmoi init` (see .chezmoi.toml.tmpl):
#
# includePrivate — private data: rbw/vault access, Proton VPN, ssh config with
#   my home hosts. Work machines answer "no": installing rbw is cheap, but my
#   home network topology is not something a work box should hold. OS suffixes
#   stay for the rbw config paths only because rbw looks in a different place
#   on each platform.
#
# includeDesktop — full desktop tier: GUI applications and experimental agent
#   harnesses like pi. Headless boxes (homelab, throwaway VMs) answer "no".
#
# Both default to false via `dig`, so a machine whose config predates a flag is
# safe until it re-inits.
{{ if not (dig "includePrivate" false .) }}
.config/wireguard/protonvpn.conf
{{ end }}
{{ if not (dig "includePrivate" false .) }}
.ssh/config
# Both rbw paths — the OS blocks below pick which one a private machine gets.
.config/rbw/config.json
Library/Application Support/rbw/config.json
{{ end }}
{{ if not (dig "includeDesktop" false .) }}
private_dot_pi
.chezmoiscripts/setup_pi-packages.sh
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
Library/Application Support/Code/User/settings.json
Library/Application Support/rbw/config.json
.chezmoiscripts/setup_applications_darwin.sh
.chezmoiscripts/setup_firefox_darwin.sh
.chezmoiscripts/setup_packages_darwin.sh
.chezmoiscripts/setup_finder_copypath_darwin.sh
.chezmoiscripts/load-open-url-agent_darwin.sh
.chezmoiscripts/load-codexbar-agent_darwin.sh
.chezmoiscripts/setup-agent-sleep-guard_darwin.sh
.local/bin/open-url-listener
.local/bin/agent-sleep-guard
Library/LaunchAgents/com.timvink.openurl.plist
Library/LaunchAgents/com.timvink.agent-sleep-guard.plist
Library/LaunchAgents/com.timvink.codexbar.plist
# Karabiner-Elements is macOS-only, so its config is dead weight elsewhere.
.config/karabiner
# CodexBar is a macOS menu bar app (cask, not in the Linux package script), so
# there is nothing on a Linux box for its provider toggles to configure.
.config/codexbar
{{ end }}
