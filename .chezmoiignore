# This repo's own docs and project agent-instructions, not dotfiles for $HOME.
# AGENTS.md is the only project-instructions file: every agent reads it directly
# now that Claude Code 2.1.277+ falls back to AGENTS.md in a project with no
# CLAUDE.md, so the CLAUDE.md symlink that used to sit beside it is gone.
README.md
AGENTS.md
DECISIONS.md

# Python bytecode caches. tmux-overview is a python script, so running it from
# the source dir drops a __pycache__ next to it; chezmoi would then treat that
# as a managed file and prompt on every apply.
**/__pycache__

# Canonical cross-tool agent config (AGENTS.md + skills/) lives here but is
# symlinked into ~/.claude and ~/.codex (see agents/README.md), so chezmoi must
# NOT also copy it to ~/agents.
agents

# C source for the OSC 7501 pty shim; compiled into ~/.local/libexec/agent-pty
# by .chezmoiscripts/run_onchange_after_build-agent-pty.sh.tmpl, not copied.
agent-pty

# Swift source compiled into ~/.local/libexec/spotify-watch by
