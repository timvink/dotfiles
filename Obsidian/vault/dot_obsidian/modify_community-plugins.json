#!/bin/sh
# Enable the plugins this repo installs:
# - obsidian-vimrc-support loads the vault's .obsidian.vimrc so Vim keymaps
#   (Space chords) persist. Its files come from .chezmoiexternal.toml.
# - explorer-vim-keys (own plugin, dot_obsidian/plugins/) adds hjkl, gg/G, r
#   and / to the File explorer.
#
# Appends each id only if missing, keeping plugins enabled in the Obsidian UI
# and their order. Community plugins must be allowed (restricted mode off),
# which they already are for obsidian-importer.
#
# This is a chezmoi modify_ script: stdin = current target content, stdout
# = new content. Idempotent.

set -eu

input=$(cat)
[ -z "$input" ] && input='[]'

printf '%s\n' "$input" | jq --indent 2 '
  reduce ("obsidian-vimrc-support", "explorer-vim-keys") as $id
    (.; if index($id) then . else . + [$id] end)
'
