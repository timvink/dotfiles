#!/bin/bash
# Omarchy theme-set hook: make tmux's palette follow the Omarchy theme.
#
# omarchy-theme-set runs every file in ~/.config/omarchy/hooks/theme-set.d/
# (through omarchy-hook, with bash, the theme name as $1) once the new theme is
# in ~/.local/state/omarchy/current/theme. This writes ~/.config/tmux/theme.conf,
# which ~/.tmux.conf sources right after setting its Catppuccin Mocha defaults
# (the @thm_* options, see the palette block at the top of dot_tmux.conf), then
# re-sources ~/.tmux.conf in a running server, because the style options take
# their colour at load time (set -F).
#
# Composes with Omarchy's own omarchy-theme-set-tmux, which runs earlier in the
# same theme switch and sets window-style, cursor-colour and the theme
# environment: ~/.tmux.conf sets none of those, so re-sourcing it keeps them.
#
# Also run once by chezmoi on apply
# (.chezmoiscripts/run_onchange_after_setup-tmux-theme.sh.tmpl).
#
# For testing: TMUX_THEME_COLORS=<colors.toml> reads another theme, and
# TMUX_THEME_SOCKET=<name> talks to `tmux -L <name>` instead of the default
# server.

set -u

colors=${TMUX_THEME_COLORS:-$HOME/.local/state/omarchy/current/theme/colors.toml}
out=$HOME/.config/tmux/theme.conf
tmux_cmd=(tmux)
[[ -n ${TMUX_THEME_SOCKET:-} ]] && tmux_cmd+=(-L "$TMUX_THEME_SOCKET")

command -v omarchy-theme-color >/dev/null 2>&1 || exit 0

# One resolver run gives every key, including those it derives for a theme
# whose colors.toml leaves them out. A theme with no colors.toml at all gets
# an empty theme.conf, so tmux falls back to Catppuccin rather than keeping
# the previous theme's colours.
declare -A C=()
if [[ -f $colors ]]; then
  while IFS=$'\t' read -r key value; do
    [[ $value =~ ^#[0-9a-fA-F]{6}$ ]] && C[$key]=${value,,}
  done < <(omarchy-theme-color --file "$colors" --all 2>/dev/null)
fi

# mix A B P: P percent of colour A over colour B, both "#rrggbb".
mix() {
  local a=$1 b=$2 p=$3 i out="#" x y
  for i in 1 3 5; do
    x=$((16#${a:i:2})) y=$((16#${b:i:2}))
    printf -v out '%s%02x' "$out" $(((x * p + y * (100 - p) + 50) / 100))
  done
  printf '%s' "$out"
}

{
  echo "# Generated by ~/.config/omarchy/hooks/theme-set.d/tmux-theme from"
  echo "# $colors — do not edit. Sourced by ~/.tmux.conf."
  # @thm_* option → Omarchy colors.toml key. A key the theme lacks is left
  # out, so ~/.tmux.conf's Catppuccin default stands for it.
  while read -r opt key; do
    [[ -z ${C[$key]:-} ]] || printf 'set -g @thm_%s "%s"\n' "$opt" "${C[$key]}"
  done <<'MAP'
bg background
bg_dark dark_background
surface lighter_background
selection selection
muted muted
fg_dim dark_foreground
fg_sub light_foreground
fg foreground
fg_bright bright_foreground
accent accent
blue blue
green green
red red
yellow yellow
cyan cyan
orange orange
red_soft bright_red
MAP
  # The two tints Catppuccin has no key for, derived the same way in every
  # theme: the active tab's port is green lifted toward the text colour (dark
  # or light), and the SSH status bar is the background warmed with yellow.
  if [[ -n ${C[green]:-} && -n ${C[foreground]:-} ]]; then
    printf 'set -g @thm_green_tint "%s"\n' "$(mix "${C[green]}" "${C[foreground]}" 60)"
  fi
  if [[ -n ${C[yellow]:-} && -n ${C[dark_background]:-} ]]; then
    printf 'set -g @thm_ssh_bg "%s"\n' "$(mix "${C[yellow]}" "${C[dark_background]}" 25)"
  fi
} >"$out.tmp" && mv -f "$out.tmp" "$out"

# A running server: re-source the whole config (the style options resolve
# their colour at load time) and redraw every client's status bar.
if "${tmux_cmd[@]}" list-sessions >/dev/null 2>&1; then
  "${tmux_cmd[@]}" source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
  while IFS= read -r client; do
    [[ -n $client ]] && "${tmux_cmd[@]}" refresh-client -S -t "$client" 2>/dev/null
  done < <("${tmux_cmd[@]}" list-clients -F '#{client_name}' 2>/dev/null)
fi
exit 0
