#!/bin/sh
# Ensure ~/.claude/settings.json carries the settings we manage (status line,
# auto-compact threshold, subagent model, output style, AGENTS.md loading,
# default permission mode) while preserving everything Claude Code writes at
# runtime.
#
# Claude Code's tmux tab dot is NOT driven from here any more. Claude reports its
# own state over the Program Status protocol (OSC 7501), which the agent-pty shim
# reads (agent-pty/agent-pty.c, launched by the `claude` function in
# dot_bash_aliases.tmpl). That replaced a dozen lifecycle hooks plus the helpers
# that patched their gaps: ESC interrupts that fire no hook, StopFailure, the
# pane-title sweep for stale blue dots, and SubagentStart/Stop bookkeeping. The
# hook keys those used are deleted below, so a machine upgrading from the hook
# era drops them; nothing else owns them.
#
# This is a chezmoi modify_ script: stdin = current target content, stdout
# = new content. Idempotent.

set -eu

input=$(cat)
[ -z "$input" ] && input='{}'

# Status line: a Catppuccin-coloured Starship-style line (path, git branch,
# model, ctx%). The script lives in chezmoi too (executable_statusline-command.sh
# → ~/.claude/statusline-command.sh); we inject the wiring here so a fresh
# machine gets it. $HOME is expanded now (apply time) into an absolute path —
# Claude Code runs `command` without shell expansion, so a literal ~ or $HOME
# would not resolve.
status_cmd="bash $HOME/.claude/statusline-command.sh"

# Auto-compact earlier than the default. Claude Code normally compacts only at
# (context window - 13k tokens) — ~99% full on a 1M window, where recall over
# the middle of the context has long since degraded. Setting the percentage
# override makes it compact at that share of the window instead:
#
#   threshold = min(floor(window * pct / 100), window - 13000)
#
# so the value can only *lower* the threshold, never push past the 13k reserve;
# anything outside 0 < pct <= 100 is ignored and the default applies. Trade-off
# is more frequent compactions in exchange for staying in the range where the
# model actually uses what's in context.
autocompact_pct=65

# Built-in subagents (Explore, general-purpose, Plan) inherit the main model
# unless told otherwise; route them to the `opus` alias so they track the
# latest Opus (cheaper than Fable, and ahead on benchmarks as of 5.5) even when
# the main session is switched to Fable. Custom agent files would set
# `model: opus` / `effort: medium` themselves; there are none today.
subagent_model=opus

# Concise output style: trims the prose Claude Code wraps around answers
# (explanatory commentary, preamble) in favour of short, direct responses.
output_style=Concise

# agents-md (built-in plugin): load AGENTS.md *beside* CLAUDE.md everywhere,
# instead of the default "only when the project has no CLAUDE.md". This repo
# ships AGENTS.md and no root CLAUDE.md, and in the fallback mode the plugin
# announces that once per project ("no CLAUDE.md found; AGENTS.md loaded: ..."),
# which is noise in every session here. The "and" mode loads the same files
# without the notice, and de-duplicates an AGENTS.md that a CLAUDE.md already
# @-imports or symlinks to, so a repo carrying both doesn't get it twice.
instruction_files=claude-md-and-agents-md

# Default permission mode: "auto" delegates each permission decision to a safety
# classifier instead of prompting for every action. It must live in the USER
# settings file (this one) — Claude Code deliberately ignores an "auto" default
# coming from a project's .claude/settings.json, since that is repo-controllable.
# Can't lock us out: if auto mode is unavailable at startup (unsupported model,
# org kill switch) the CLI falls back to "default" with a notice.
default_permission_mode=auto

printf '%s' "$input" | jq \
    --arg     statuscmd "$status_cmd" \
    --arg     autocompactpct "$autocompact_pct" \
    --arg     subagentmodel "$subagent_model" \
    --arg     defaultmode "$default_permission_mode" \
    --arg     outstyle "$output_style" \
    --arg     instrfiles "$instruction_files" \
    'del(.hooks.SessionStart, .hooks.SessionEnd, .hooks.UserPromptSubmit,
         .hooks.PreToolUse, .hooks.PostToolUse, .hooks.Notification,
         .hooks.Stop, .hooks.StopFailure, .hooks.SubagentStart,
         .hooks.SubagentStop)
   | if .hooks == {} then del(.hooks) else . end
   | .statusLine             = { "type": "command", "command": $statuscmd }
   | .env.CLAUDE_AUTOCOMPACT_PCT_OVERRIDE = $autocompactpct
   | .env.CLAUDE_CODE_SUBAGENT_MODEL = $subagentmodel
   | .permissions.defaultMode = $defaultmode
   | .outputStyle             = $outstyle
   | .pluginConfigs["agents-md@builtin"].options.instructionFiles = $instrfiles'
