#!/bin/sh
# Declare my Claude Code MCP servers so a fresh machine gets the whole set.
#
# Claude Code keeps user-scope servers in ~/.claude.json, a file it also fills
# with runtime state (per-project history, onboarding counters, OAuth material).
# chezmoi must not own that file, so this script drives the `claude mcp` CLI
# instead -- the same approach as `modify_` scripts elsewhere in this repo:
# inject only the keys we manage, leave everything else alone.
#
# The list below mirrors [mcp_servers.*] in dot_codex/modify_private_config.toml;
# keep the two in sync when adding a server. The exception is ah, which Codex
# still runs over stdio.
#
# OAuth tokens are NOT stored here -- they live in Claude's own credential store
# and survive `chezmoi apply`. Each hosted server below needs a one-time
# `claude mcp login <name>` (or an in-session /mcp auth) per machine.
#
# Additive by design: it adds servers that are missing and warns about ones whose
# URL has drifted, but never removes anything. Servers added ad hoc or by a
# plugin are left untouched.
#
# chezmoi reruns this whenever the server list changes, and once more if claude
# only appeared on PATH after the last run:
#   claude: {{ lookPath "claude" }}

set -eu

# A fresh machine installs claude into ~/.local/bin *during* this same apply
# (see the setup_packages_* scripts), which may not be on PATH in the shell
# chezmoi inherited.
PATH="$HOME/.local/bin:$PATH"
export PATH

if ! command -v claude >/dev/null 2>&1; then
	echo "setup-claude-mcp: claude not installed, skipping MCP server setup" >&2
	exit 0
fi

# add_http <name> <url> -- register a streamable-HTTP server at user scope.
add_http() {
	name=$1
	url=$2

	if ! current=$(claude mcp get "$name" 2>/dev/null); then
		claude mcp add --transport http "$name" "$url" --scope user
		return 0
	fi

	# Already there. Only flag a drifted URL -- replacing it would silently
	# invalidate the OAuth grant, so that is my call to make, not the script's.
	if ! printf '%s\n' "$current" | grep -qF "URL: $url"; then
		echo "setup-claude-mcp: '$name' exists with a different URL than this repo declares." >&2
		echo "  expected: $url" >&2
		echo "  fix with: claude mcp remove $name -s user && chezmoi apply --force" >&2
	fi
}

# add_stdio <name> <command...> -- register a stdio server at user scope.
# Additive like add_http: an existing entry is left alone (remove it to pick
# up a changed command).
add_stdio() {
	name=$1
	shift
	claude mcp get "$name" >/dev/null 2>&1 && return 0
	claude mcp add --scope user "$name" -- "$@"
}

add_http context7       https://mcp.context7.com/mcp/oauth
add_http todoist        https://ai.todoist.net/mcp
add_http cloudflare     https://mcp.cloudflare.com/mcp
add_http gethumandesign https://api.gethumandesign.com/mcp
{{ if dig "includePrivate" false . }}
# Personal servers, gated on includePrivate. activecampaign is my own mailing
# list and ah is my grocery basket -- neither belongs on a client's machine.
add_http activecampaign https://stilstaanbijjezelf1.activehosted.com/api/agents/mcp/http
{{ end }}
add_http atlassian      https://mcp.atlassian.com/v1/mcp/authv2
{{ if dig "includePrivate" false . }}
# Obsidian vault, served by the openclaw-obsidian-mcp container on the homelab
# (timvink-homelab repo, openclaw/README.md). Stdio, not HTTP, on purpose: each
# session `docker exec`s a fresh mcpvault inside that container, so the vault
# gets no network listener at all -- off the homelab, the only way in is SSH
# over NetBird, with the key that already gates the box. Needs the container
# up, i.e. after the post-unlock start.
#
# Off the homelab: no ControlMaster, so this background ssh can't become the
# mux master that interactive `ssh homelab` sessions then attach to -- and
# ClearAllForwardings keeps it from grabbing the Host block's tunnel ports.
{{-   if eq .chezmoi.hostname "homelab" }}
add_stdio obsidian docker exec -i openclaw-obsidian-mcp node_modules/.bin/mcpvault /vault
{{-   else }}
add_stdio obsidian ssh -T -o BatchMode=yes -o ControlPath=none -o ClearAllForwardings=yes homelab docker exec -i openclaw-obsidian-mcp node_modules/.bin/mcpvault /vault
{{-   end }}
# Task lists (CalDAV in Nextcloud), served by the tasks-mcp container on the
# homelab (timvink-homelab repo, tasks-mcp/README.md). Same stdio-over-
# docker-exec pattern as the vault, for the same reasons.
{{-   if eq .chezmoi.hostname "homelab" }}
add_stdio tasks docker exec -i tasks-mcp tasks-mcp
{{-   else }}
add_stdio tasks ssh -T -o BatchMode=yes -o ControlPath=none -o ClearAllForwardings=yes homelab docker exec -i tasks-mcp tasks-mcp
{{-   end }}
{{ end }}

# Albert Heijn (ah) is registered by run_onchange_after_setup-ah-mcp_darwin.sh,
# which also runs the shared server it connects to.
