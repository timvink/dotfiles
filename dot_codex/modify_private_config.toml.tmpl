#!/usr/bin/env python3
# chezmoi modify_ script for ~/.codex/config.toml.
#
# Codex owns this file at runtime — it rewrites [projects.*] (trust prompts),
# [tui.*] (NUX counters) and [hooks.*] (trusted hashes) as you use it. So we
# can't manage it as a static file (chezmoi would clobber that state on every
# apply). Instead we PIN the portable settings below and PASS THROUGH Codex's
# runtime sections verbatim.
#
# TWO BACKENDS, ONE CONFIG. This script is itself a chezmoi template (hence the
# .tmpl suffix): chezmoi renders it per-machine, then runs it.
#   * Linux (the devbox) → Azure OpenAI, billed to the shared dev-tools account,
#     key from the AZURE_OPENAI_API_KEY env var set by /etc/profile.d/codex.sh.
#   * macOS (this laptop) → OpenAI directly on my personal ChatGPT subscription
#     (`codex login`, credentials in ~/.codex/auth.json). No API key exists here,
#     so emitting `model_provider = "azure"` on macOS makes every session fail
#     with "Missing environment variable: AZURE_OPENAI_API_KEY".
# Only the provider differs: the subscription serves the same model ids
# (gpt-5.6-terra/sol/luna) that the devbox names as Azure deployments.
#
# Why Linux pins `model`: Codex rewrites `model` to a bare upstream model id
# whenever you switch models — via the `/model` picker or its model-migration
# logic — but what Azure wants is the *deployment* name, so a mismatch 404s
# ("deployment does not exist") mid-session. The pin repairs that on the next
# `chezmoi apply`. As of 2026-07-30 the deployments are named *identically* to
# their model ids, so a `/model` switch between them is now a no-op rather than
# a breakage — the pin is a second line of defence, not the only one. They
# carried a `-codex` suffix until then, a leftover from gpt-5.3-codex; a single
# `/model` switch was enough to break a live session, so it was dropped.
# Switching to a model that isn't deployed (for example a future 5.7) still
# 404s — correctly. Deployments live in the nwf-ai-platform-infra repo
# (infra/global/platform.bicep, aif-nwf-devtools account); both are EU-resident
# DataZoneStandard. terra costs the same per token as the gpt-5.4 it replaced;
# sol is roughly 2x, hence opt-in.
#
# macOS deliberately does NOT pin the model: there is no deployment-name
# mismatch to defend against, so a `/model` switch is safe and is carried over
# on each apply instead of being reverted. The values below only seed a machine
# that has no config yet.
#
# chezmoi feeds the current target file on stdin; we emit the desired file.
import sys, re

# Rendered by chezmoi: True on the Azure devbox, False on the ChatGPT-sub Mac.
AZURE = {{ if eq .chezmoi.os "darwin" }}False{{ else }}True{{ end }}

SEED_MODEL = "gpt-5.6-terra"
SEED_EFFORT = "medium"

src = sys.stdin.read()


def stored(key, default):
    """What Codex last wrote for a top-level key, or `default` if absent.

    Only the preamble (everything before the first [table] header) is scanned,
    so a same-named key inside any table can't be mistaken for it.
    """
    for ln in src.splitlines():
        if ln.startswith('['):
            break
        m = re.match(r'\s*' + key + r'\s*=\s*"([^"]*)"\s*$', ln)
        if m and m.group(1):
            return m.group(1)
    return default


if AZURE:
    DEFAULTS = '''# Interactive defaults. Pointed at the shared dev-tools Azure OpenAI
# deployment (EU-resident, Responses API). The key comes from the
# AZURE_OPENAI_API_KEY env var, set by /etc/profile.d/codex.sh.
# Managed by chezmoi (dot_codex/modify_private_config.toml.tmpl) — edit the
# source there, not this file. The settings below are pinned; Codex's runtime
# sections ([projects.*], [tui.*], [hooks.*]) are preserved as-is.
#
# `model` is an Azure *deployment* name that is deliberately identical to the
# upstream model id, so Codex's /model picker can't rewrite it into a 404.
model = "''' + SEED_MODEL + '''"
model_provider = "azure"
model_reasoning_effort = "''' + SEED_EFFORT + '''"
'''
else:
    DEFAULTS = '''# Interactive defaults. Pointed straight at OpenAI on my personal ChatGPT
# subscription — `codex login`, credentials in ~/.codex/auth.json — so there is
# deliberately no `model_provider` line (Codex's built-in `openai` provider is
# the default) and no API key. The Azure provider this repo uses on the Linux
# devbox is emitted there only; naming it here would demand an
# AZURE_OPENAI_API_KEY that this machine has no reason to hold.
# Managed by chezmoi (dot_codex/modify_private_config.toml.tmpl) — edit the
# source there, not this file. Codex's runtime sections ([projects.*], [tui.*],
# [hooks.*]) are preserved as-is.
#
# `model`/`model_reasoning_effort` are NOT pinned: the deployment-name mismatch
# that forces a pin on Azure doesn't exist here, so whatever the /model picker
# last stored is carried over instead of being reverted on apply.
model = "''' + stored("model", SEED_MODEL) + '''"
model_reasoning_effort = "''' + stored("model_reasoning_effort", SEED_EFFORT) + '''"
'''

COMMON = '''approval_policy = "on-request"
sandbox_mode = "workspace-write"

# Let Codex delegate independent work to subagents while bounding the number
# of spawned threads. Codex does not expose a configurable nesting-depth limit.
[agents]
enabled = true
max_concurrent_threads_per_session = 6
'''

# Experimental context management ("Astra"): Codex keeps notes across context
# windows and can search back through earlier messages and tool results from the
# same task, instead of just truncating. Opt-in, off by default.
#
# macOS only, and not by preference: OpenAI gates it on a personal ChatGPT
# Plus/Pro sign-in and explicitly excludes Business, Enterprise and API-key
# auth. The Linux devbox authenticates with an Azure API key, so the flag would
# be inert there. Revisit if the gate is lifted.
CONTEXT_MGMT = '''
[features.context_management]
experimental_mode = true
'''

AZURE_PROVIDER = '''
[model_providers.azure]
name = "Azure OpenAI"
base_url = "https://aif-nwf-devtools.openai.azure.com/openai/v1"
env_key = "AZURE_OPENAI_API_KEY"
wire_api = "responses"
'''

# The opt-in `sol` / `luna` profiles are NOT declared here. Since Codex 0.134 a
# profile is an overlay *file* — `~/.codex/<name>.config.toml`, loaded on top of
# this one by `codex --profile <name>` — and a leftover `[profiles.<name>]`
# table is a hard error ("cannot be used while config.toml contains legacy
# ... config"), not a fallback. They live in dot_codex/private_sol.config.toml
# and private_luna.config.toml, are plain files rather than templates because an
# overlay inherits `model_provider` from the base config above, and are dropped
# from any existing config.toml by the pass-through filter below.

MCP = '''
# MCP servers — mirrors the Claude Code set, declared in
# .chezmoiscripts/run_onchange_after_setup-claude-mcp.sh.tmpl. Codex detects the
# streamable-HTTP transport from the `url` key alone; no extra flags needed.
# This file holds only server definitions — OAuth tokens live in Codex's own
# auth store (not here), so they survive `chezmoi apply`. For each hosted server
# below, authenticate once with `codex mcp login <name>`.
#
# context7 uses its dedicated OAuth endpoint (/mcp/oauth, not /mcp), per
# https://context7.com/docs/howto/oauth — keyless, so no API key in this repo.
[mcp_servers.context7]
url = "https://mcp.context7.com/mcp/oauth"

[mcp_servers.todoist]
url = "https://ai.todoist.net/mcp"

[mcp_servers.notion]
url = "https://mcp.notion.com/mcp"

[mcp_servers.cloudflare]
url = "https://mcp.cloudflare.com/mcp"

# gethumandesign is deliberately NOT declared here. It ships as an official
# plugin in OpenAI's directory, so `/plugins` inside Codex installs it and
# handles its own OAuth. A manual entry would duplicate those tools and sit
# permanently "Not logged in" in the startup warnings.

{{ if dig "includePrivate" false . }}
# Personal, gated on includePrivate: my own mailing list, not a client's.
[mcp_servers.activecampaign]
url = "https://stilstaanbijjezelf1.activehosted.com/api/agents/mcp/http"
{{ end }}
[mcp_servers.atlassian]
url = "https://mcp.atlassian.com/v1/mcp/authv2"

{{ if dig "includePrivate" false . }}
# Local stdio server (Albert Heijn), gated on includePrivate — my grocery
# basket has no place on a client's machine. macOS-only binary path; on a Linux
# box this entry just won't launch — mirrors the Claude setup, which hardcodes
# the same path.
[mcp_servers.ah]
command = "/Users/timvink/.local/bin/ah-mcp"
args = ["--transport", "stdio"]
{{ end }}
'''

OWNED = DEFAULTS + COMMON + (AZURE_PROVIDER if AZURE else CONTEXT_MGMT) + MCP

PASS_GROUPS = {"projects", "tui", "hooks"}   # runtime state Codex manages

# Managed TUI status line. `context-used` shows the % of the context window
# consumed, so I can see when to /compact; the rest mirrors my Claude Code
# status line (dir · branch · model+reasoning) for cross-tool consistency.
# Codex owns the other [tui.*] sub-tables (NUX counters) and may store its own
# keys in a bare [tui] table — we inject ONLY this key and preserve the rest.
# Item ids: codex's status-line setup menu / `tui.status_line` config reference.
STATUS_LINE = 'status_line = ["current-dir", "git-branch", "model-with-reasoning", "context-used"]'

def group_of(header):
    m = re.match(r'\[+\s*"?([^".\]]+)', header)
    return m.group(1) if m else None

# Split into blocks at column-0 table headers ("[..."). The first block is the
# top-level preamble (keys before any table); we re-author it via OWNED.
blocks, cur = [], []
for ln in src.splitlines(keepends=True):
    if ln.startswith('['):
        if cur:
            blocks.append(cur)
        cur = [ln]
    else:
        cur.append(ln)
if cur:
    blocks.append(cur)

out = [OWNED.rstrip() + "\n"]
tui_bare_seen = False
for b in blocks:
    if not b[0].startswith('['):
        continue  # preamble — re-authored above
    if group_of(b[0]) not in PASS_GROUPS:
        continue
    if b[0].strip() == '[tui]':
        # Bare [tui] table: drop any stale status_line, keep every other
        # runtime key Codex stores here, then append our managed status_line.
        body = [ln for ln in b[1:] if not re.match(r'\s*status_line\s*=', ln)]
        block = ("[tui]\n" + "".join(body)).rstrip()
        out.append("\n" + block + "\n" + STATUS_LINE + "\n")
        tui_bare_seen = True
    else:
        out.append("\n" + "".join(b).rstrip() + "\n")

# No bare [tui] table in the input → synthesize one for our status_line.
# (Valid TOML even with [tui.*] sub-tables present: a super-table may be
# defined out-of-order after its sub-tables.)
if not tui_bare_seen:
    out.append("\n[tui]\n" + STATUS_LINE + "\n")

sys.stdout.write("".join(out))
