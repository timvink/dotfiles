# Fall back to xterm-256color if the terminfo entry for $TERM is missing.
# Happens when SSH-ing in from ghostty to a host without the xterm-ghostty entry.
if [ -n "${TERM:-}" ] && ! infocmp "$TERM" >/dev/null 2>&1; then
    export TERM=xterm-256color
fi

# Ensure ~/.local/bin is on PATH (where uv, agy, the nvim symlink etc. land).
# Mirrors dot_zshrc.tmpl; replaces lines the Antigravity CLI installer used to
# append to ~/.bash_profile and ~/.bashrc directly.
export PATH="$HOME/.local/bin:$PATH"

# ~/.cargo/bin holds cargo-installed tools (rbw, rbw-agent). Managed here rather
# than via rustup's appended `. ~/.cargo/env`, since chezmoi owns this file and
# would otherwise clobber that line on the next apply.
[ -d "$HOME/.cargo/bin" ] && export PATH="$HOME/.cargo/bin:$PATH"

# Source my aliases
if [ -f ~/.bash_aliases ]; then
    source ~/.bash_aliases
fi

# Source any private env vars
if [ -f ~/.bash_env ]; then
    source ~/.bash_env
fi

# Update path for claude code
export PATH="$HOME/.local/bin:$PATH"

# Match the Linux zsh setup: headless browser launchers (including Codex's
# OAuth client) need BROWSER explicitly; finding xdg-open on PATH isn't enough.
# The shim opens URLs on the host Mac through the SSH reverse tunnel.
if [ "$(uname -s)" = "Linux" ]; then
    export BROWSER="$HOME/.local/bin/xdg-open"
    # Node's bundled roots and Azure CLI's certifi can lag OS security fixes.
    # Use the OS trust store patched for the October 2026 eMudhra compromise.
    export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--use-openssl-ca"
    export REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
    export PIP_CERT=/etc/ssl/certs/ca-certificates.crt
fi

## Pretty prompts, https://starship.rs/
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi
if command -v uv >/dev/null 2>&1; then
    eval "$(uv generate-shell-completion bash)"
fi

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# fzf — fuzzy finder key bindings + completion (mirrors dot_zshrc.tmpl).
#   ctrl-r  fuzzy history search      ctrl-t  insert file path
#   alt-c   cd into a subdir          **<tab> fuzzy-complete any command's arg
# `fzf --bash` needs fzf >= 0.48; the linux package script installs upstream's.
if command -v fzf >/dev/null 2>&1 && fzf --bash >/dev/null 2>&1; then
    eval "$(fzf --bash)"
fi
