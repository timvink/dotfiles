# Paths chezmoi deletes from $HOME on every apply. Entries stay here so that a
# machine still running an older checkout gets cleaned up whenever it catches up.

# Renamed to tmux-pane-close: Alt+e now closes agent, nvim and shell tabs alike,
# so "agent-exit-pane" no longer described it.
.local/bin/agent-exit-pane

# CodexBar (menu bar usage monitor) is gone: `limits` covers the same quotas from
# the terminal, so the app, its login LaunchAgent and its provider config go too.
Library/LaunchAgents/com.timvink.codexbar.plist
.config/codexbar

# Claude Code's tab dot now comes from its own Program Status reports (OSC 7501),
# read by the agent-pty shim, so the hook-era helpers that reconstructed it from
# events, transcript tails and pane titles are gone.
.local/bin/agent-interrupt-state
.local/bin/agent-stop-state
.local/bin/agent-subagents
.local/bin/agent-state-sweep
