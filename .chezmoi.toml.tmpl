{{- /* Prompted once per machine by `chezmoi init`; the answers are baked into
       ~/.config/chezmoi/chezmoi.toml. Re-run `chezmoi init` to change them.
       Only facts chezmoi can't detect are prompted; the machine kind is
       detected by .chezmoitemplates/machine. */ -}}
{{- $machine := includeTemplate "machine" . -}}
{{- $includePrivate := promptBoolOnce . "includePrivate" "Is this a private machine (home vault, ssh hosts, Netbird, Proton, personal MCP servers)?" false -}}
{{- $codingAgent := promptChoiceOnce . "codingAgent" "Primary coding agent on this machine (drives tab 1 of the `t` tmux bootstrap)" (list "claude" "codex") "claude" -}}
# ~/.config/chezmoi/chezmoi.toml — generated by `chezmoi init` from
# .chezmoi.toml.tmpl in the source repo. Edit the template, not this file.
#
# The machine kind (mac / omarchy / server) is detected, not asked: see
# .chezmoitemplates/machine.
#
# includeDesktop gates the desktop tier: GUI applications and experimental
# agent harnesses like pi. Derived from the machine kind: Macs and Omarchy
# laptops are desktops, every other Linux box is a headless server.
#
# includePrivate gates personal tools and data: rbw/vault access at apply time,
# ~/.ssh/config with my home hosts, the Netbird mesh to the homelab, and my
# personal MCP servers. Work machines answer "no". Defaults to false, so
# `chezmoi apply` never calls `rbw get` on a machine whose config predates this
# flag until it re-inits.
#
# codingAgent picks which agent the `t` tmux bootstrap launches in tab 1 (and,
# via tmux automatic-rename, what that tab is called): "claude" → `cc`, "codex"
# → `co`. The work devbox runs codex; my Macs run claude. Consumers read it with
# `dig "codingAgent" "claude" .` so a machine whose config predates this flag
# falls back to claude until it re-inits.
[data]
    includeDesktop = {{ ne $machine "server" }}
    includePrivate = {{ $includePrivate }}
    codingAgent = {{ $codingAgent | quote }}

[edit]
    command = "nvim"
