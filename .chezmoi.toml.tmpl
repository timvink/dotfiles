{{- /* Prompted once per machine by `chezmoi init`; the answer is baked into
       ~/.config/chezmoi/chezmoi.toml. Re-run `chezmoi init` to change it. */ -}}
{{- $includeDesktop := promptBoolOnce . "includeDesktop" "Is this a full desktop machine (GUI apps, pi harness)?" false -}}
{{- $includePrivate := promptBoolOnce . "includePrivate" "Is this a private machine (home vault, ssh config, Proton)?" false -}}
{{- $codingAgent := promptChoiceOnce . "codingAgent" "Primary coding agent on this machine (drives tab 1 of the `t` tmux bootstrap)" (list "claude" "codex") "claude" -}}
# ~/.config/chezmoi/chezmoi.toml — generated by `chezmoi init` from
# .chezmoi.toml.tmpl in the source repo. Edit the template, not this file.
#
# includeDesktop gates the desktop tier: GUI applications and experimental
# agent harnesses like pi. Homelab boxes and headless VMs answer "no"; my daily
# drivers answer "yes", regardless of OS.
#
# includePrivate gates private data: rbw/vault access at apply time, the Proton
# VPN wireguard conf, and ~/.ssh/config with my home hosts. Work machines answer
# "no" — installing rbw is cheap, but my home network topology is not something
# a work box should hold. Defaults to false, so `chezmoi apply` never calls
# `rbw get` on a machine whose config predates this flag until it re-inits.
#
# codingAgent picks which agent the `t` tmux bootstrap launches in tab 1 (and,
# via tmux automatic-rename, what that tab is called): "claude" → `cc`, "codex"
# → `co`. The work devbox runs codex; my Macs run claude. Consumers read it with
# `dig "codingAgent" "claude" .` so a machine whose config predates this flag
# falls back to claude until it re-inits.
[data]
    includeDesktop = {{ $includeDesktop }}
    includePrivate = {{ $includePrivate }}
    codingAgent = {{ $codingAgent | quote }}

[edit]
    command = "code"
    args = ["--wait"]
