#!/bin/sh
# PATH-level route into agent-pty, for launches that never see the `claude`
# shell function in dot_bash_aliases.tmpl: `tmux new-window 'claude …'`, an
# agent spawning a sibling tab, anything run through a non-interactive `zsh -c`.
# Those used to run plain Claude and show no tab dot. dot_zshenv puts this
# directory first on PATH inside tmux; same conditions as the function.
#
# The real binary is found with this directory dropped from PATH and handed to
# the shim by full path, so the shim's execvp can't land back here.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$here" | paste -sd: -)
export PATH
real=$(command -v claude) || { echo "claude: not found on PATH" >&2; exit 127; }
shim="$HOME/.local/libexec/agent-pty/claude"
if [ -n "${TMUX_PANE:-}" ] && [ -t 0 ] && [ -t 1 ] && [ -x "$shim" ]; then
    exec "$shim" "$real" "$@"
fi
exec "$real" "$@"
