#!/usr/bin/env bash
# tmux-agent-count — how much agent work is in flight right now across the whole
# tmux server, for the right side of the status bar (dot_tmux.conf), shown just
# left of the session-dots chip, next to the hostname. Reads as one figure:
#
#   6      six windows are working: @agent_state is "running" (the blue ● set
#          by the agent-pty shim for Claude and by lifecycle hooks for Codex),
#          counted server-wide.
#   6+11   …and between them those six have eleven subagents in flight, from
#          @agent_subagents (the shim's count of Claude's OSC 7501 child records). The "+11" appears only when
#          there are any, in a lighter blue, because it answers a different
#          question: six blue dots could be six agents each doing one thing, or
#          two of them driving a wide fan-out, and the load on the machine and on
#          the rate limit is nothing alike.
#
# The subagent half is Claude-only by construction — Codex and Antigravity
# sessions count toward the first number and can never add to the second, since
# only Claude Code reports its subagents.
#
# Emits a tmux FORMAT-styled number, or NOTHING when nothing is working — so the
# bar shows a figure only while something is, and the slot vanishes when nothing
# is. Same signal as tmux-session-dots / the alt+f finder, but a raw count of
# running windows rather than a per-session roll-up. Run async by tmux on
# status-interval, like tmux-git-branch / tmux-session-dots, so it never stalls
# the bar.
#
# Emits tmux FORMAT (#[fg=...]), NOT raw ANSI: tmux re-expands #[...] in #()
# output on the status bar. bg is left untouched so the number sits on whatever
# bar bg is current (the hostname's @status_bg, before the dots chip's #313244).
set -uo pipefail

# Resolve done → idle for whatever is on screen right now. The tmux hooks in
# dot_tmux.conf catch a window becoming visible; this catches the rest, mainly a
# turn that finished while you were already sitting in the tab. It runs here
# because the status bar is the only thing tmux ticks on a timer.
"$HOME/.local/bin/agent-seen" 2>/dev/null || true

# One pass over every window for both halves: awk counts the running ones and
# sums their subagents together, rather than asking tmux twice. A window that
# never set @agent_subagents prints an empty second field, which awk adds as 0.
read -r n subs < <(
    tmux list-windows -a -F "#{@agent_state} #{@agent_subagents}" 2>/dev/null \
        | awk '$1 == "running" { n++; s += $2 } END { print n + 0, s + 0 }'
)

# Trailing space sits on the bar bg, adding a gap before the dots chip's own
# leading space — so the number reads as evenly spaced between host and dots.
if [ "${n:-0}" -gt 0 ]; then
    printf '#[fg=#89b4fa]%s#[default]' "$n"
    [ "${subs:-0}" -gt 0 ] && printf '#[fg=#74c7ec]+%s#[default]' "$subs"
    printf ' '
fi
