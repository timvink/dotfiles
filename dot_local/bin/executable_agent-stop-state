#!/bin/sh
# Decide the end-of-turn agent-state dot from the Stop hook payload (stdin).
# Wired in as the Claude Code Stop hook (see dot_claude/modify_settings.json).
#
#   agent-driven work still
#   attached                    → running ●     a subagent, workflow or monitor
#                                               will finish and auto-resume the
#                                               agent, so it's not your turn.
#                                               Keyed off the payload's
#                                               background_tasks array, minus the
#                                               background shells — see below for
#                                               why those mean the opposite.
#   final message ends with a
#   question (last line → "?")  → needs-input ● red: the turn ended asking you
#                                               something — "your input needed".
#                                               Claude Code exposes no native
#                                               "ended with a question" signal,
#                                               so we infer it from the text. The
#                                               agent is told (~/.claude/CLAUDE.md)
#                                               to end a waiting turn with a
#                                               question and a reporting turn with
#                                               a statement, which makes this
#                                               heuristic reliable in practice.
#   otherwise                   → idle ○        yellow: turn done, your turn.
#
# The final assistant text comes from the payload's `last_assistant_message`
# field when present, else from the last text block of the JSONL transcript at
# `.transcript_path` (older builds). Any parse failure falls through to idle, so
# a finished tab is never wrongly stuck red. No-op outside tmux (agent-state is).
#
# Same payload also feeds @agent_subagents (see agent-subagents), the count of
# subagents this tab has in flight — the one number the status bar's "6+11" and
# the prefix+o rows add to the dot.

dir=$(dirname "$0")
payload=$(cat)

# One pass over background_tasks for the two numbers this payload carries.
# Entries name their kind — "subagent", "workflow", "monitor", "shell", "MCP
# task", "teammate", "cloud session" — which splits them into two groups that
# mean opposite things for the dot:
#
#   everything except "shell"  the agent's own work, continuing. It will finish
#                              and re-wake the session on its own, so the turn
#                              isn't really over and the tab stays blue.
#   "shell"                    a run_in_background command. The agent chose NOT
#                              to wait for it, which is exactly what makes the
#                              turn over: you can type now. Counting these as
#                              working is what used to pin a tab blue for as
#                              long as a dev server stayed up — hours, on a tab
#                              that was in fact waiting for you the whole time.
#
# `subagents` is separate again and narrower than both: it feeds the status bar's
# "6+11" and the prefix+o rows, which count fan-out rather than anything about
# the dot. (// [] covers builds predating background_tasks.)
set -- $(printf '%s' "$payload" | jq -r '
    (.background_tasks // []) as $t
    | "\([$t[] | select(.type != "shell")] | length) \([$t[] | select(.type == "subagent")] | length)"
' 2>/dev/null)
resumes=${1:-0}
subagents=${2:-0}

# Stamp the subagent count before deciding the dot, and on every path: Stop is
# the one moment Claude Code hands over an authoritative list of what is still
# running, so this is a recount rather than a tally kept across events, and a
# turn that ends with nothing attached writes the 0 that clears the option.
"$dir/agent-subagents" "$subagents"

# Agent-driven work still attached → the session auto-resumes; show running, not
# "your turn". @agent_bg records WHY this one is blue, because from the outside
# it looks identical to a stale dot: Claude is sitting at the prompt with its
# title showing ✳, which is exactly the shape agent-state-sweep demotes. The
# annotation is what tells the sweep this blue was meant. agent-state clears it
# on the next state change, so it can't outlive the work that earned it.
if [ "$resumes" -gt 0 ]; then
    "$dir/agent-state" running
    if [ -n "${TMUX_PANE:-}" ]; then
        win=$(tmux display-message -t "$TMUX_PANE" -p '#{window_id}' 2>/dev/null)
        [ -n "${win:-}" ] && tmux set-option -wt "$win" '@agent_bg' 1 2>/dev/null
    fi
    exit 0
fi

# Final assistant message: prefer the payload field, fall back to the transcript
# (one record per content block, so the closing text is the last text-bearing
# assistant record).
msg=$(printf '%s' "$payload" | jq -r '.last_assistant_message // empty')
if [ -z "$msg" ]; then
    tp=$(printf '%s' "$payload" | jq -r '.transcript_path // empty')
    if [ -n "$tp" ] && [ -f "$tp" ]; then
        msg=$(jq -rs '
            map(select(.type == "assistant" and (.message.content | type) == "array"))
            | map(.message.content | map(select(.type == "text") | .text) | join("\n"))
            | map(select(. != ""))
            | last // ""
        ' "$tp" 2>/dev/null)
    fi
fi

# Heuristic: does the last non-blank line end with "?" (trailing whitespace
# ignored)? A genuine waiting turn ends on the question; a report ends on a
# statement. Kept deliberately simple — no attempt to handle "?)"-style closers,
# which don't occur at the end of a real prompt to the user.
last=$(printf '%s' "$msg" | awk 'NF {l = $0} END {print l}' | sed 's/[[:space:]]*$//')
case "$last" in
    *\?) "$dir/agent-state" needs-input ;;
    *)   "$dir/agent-state" idle ;;
esac

exit 0
