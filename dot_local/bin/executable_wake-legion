#!/usr/bin/env bash
# Wake the Legion from suspend with a Wake-on-LAN magic packet over its
# ethernet port, then wait until its sshd answers over NetBird. Lives on the
# homelab, which is always on and on the same LAN; the Mac's `legion` and
# agents run it as `ssh homelab wake-legion`.
#
# Exit 0 once port 22 answers, 1 if it doesn't within WAKE_TIMEOUT seconds.
set -euo pipefail

# eno1's MAC (a hardware ID, not a secret) and the LAN broadcast address: the
# Deco's /22, not 255.255.255.255, which could leave through docker or wt0.
MAC=90:2e:16:3f:c6:5b
BROADCAST=192.168.71.255
HOST=legion-timvink.netbird.cloud
WAKE_TIMEOUT=${WAKE_TIMEOUT:-120}

up() { timeout 3 bash -c "</dev/tcp/$HOST/22" 2>/dev/null; }

if up; then
    echo "legion: already up"
    exit 0
fi

send_packet() {
    python3 - "$MAC" "$BROADCAST" <<'PY'
import socket, sys
mac = bytes.fromhex(sys.argv[1].replace(":", ""))
packet = b"\xff" * 6 + mac * 16
with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
    s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    for port in (9, 7):
        s.sendto(packet, (sys.argv[2], port))
PY
}

echo "legion: sending wake packet" >&2
send_packet
# NetBird needs a few seconds after resume to reconnect; resend now and then
# in case the first packet arrived before the NIC was listening.
SECONDS=0
last_send=0
while [ "$SECONDS" -lt "$WAKE_TIMEOUT" ]; do
    if up; then
        echo "legion: up after ${SECONDS}s"
        exit 0
    fi
    if [ $((SECONDS - last_send)) -ge 20 ]; then
        send_packet
        last_send=$SECONDS
    fi
    sleep 1
done
echo "legion: no answer after ${WAKE_TIMEOUT}s (on AC? cable in? asleep, not off?)" >&2
exit 1
