#!/usr/bin/env bash
# tmux-sessionizer — fuzzy project/workspace switcher, the tmux twin of the
# snacks.nvim Projects picker (which scans the same ~/workspace root).
#
# Bound to Alt+f (see dot_tmux.conf). Shows, in one fzf popup:
#   • every RUNNING workspace (tmux session)              — agent-state dot
#   • every PROJECT under ~/workspace not already open    — folder icon
#
# The session dot reuses the per-tab agent indicator palette (@agent_state, set
# per-window by the agent-state helper and rendered in dot_tmux.conf):
#   needs-input → red    ●   running → blue ●   idle → yellow ○   none → grey ●
# A session's dot is the highest-priority state across its windows, precedence
# needs-input > running > idle > none — so a single blocked or working window
# colours the whole session. Plain shell sessions (no agent ever) show grey ●.
# Open sessions rank first, projects after; WITHIN each group fzf sorts by match
# score, and sessions always stay above projects regardless of score. So typing
# an exact name surfaces it, while an open session never sinks below a project
# that merely matches better (e.g. query "wa" keeps both warmtefonds sessions on
# top). fzf can't express that two-tier order itself — it only sorts the whole
# list by one score — so we recompute the candidate list per keystroke; see the
# "Re-rank mode" block below.
# Type to filter, Enter to jump. An open session is switched to; a not-yet-open
# project gets a fresh session named after its dir (tmux forbids . and :, so
# they squash to _) with `{{ if eq (dig "codingAgent" "claude" .) "codex" }}co{{ else }}cc{{ end }}` in the first tab and `nvim .` in a
# second tab (the nvim tab is selected) — the same create-or-switch shape as
# the `t.` shell function (dot_bash_aliases.tmpl), though this copy also captures
# the new pane id and routes the switch through go(). NOTE: that . / : → _ squash means two dirs like `a.b` and `a:b` map to
# the one session name `a_b`; the second is then hidden from the list (or jumps
# you to the first). Accepted — tmux simply can't name those two apart.
#
# Alt+n (advertised in the picker footer) makes a NEW project instead: a second
# fzf acts as a one-line input box, prefilled with whatever was already typed,
# then mkdir -p ~/workspace/<name> and the same open_project() create-or-switch.
# The binding is `become(printf …)` rather than a nested prompt inside the
# picker: fzf's stdout here is the command substitution's pipe, so having the
# child fzf run there would capture its selection instead of the picker's. So
# alt-n only *emits a sentinel row* (kind `new`) and the real prompt runs after
# the picker has exited, back where stdout is ours again.
#
# Written bash-3.2-safe (macOS /usr/bin/bash): no associative arrays. Each fzf
# line is tab-separated  <display>\t<kind>\t<target> ; --with-nth=1 shows only
# the display column while the selection still carries kind+target to act on.
#
# A command run inside `display-popup` isn't tied to a client, so a bare
# `switch-client` no-ops. tmux does NOT expand #{client_name} in a popup command
# (it arrives as the literal string) and doesn't set $TMUX_PANE there either, so
# we identify the client ourselves: the most-recently-active one, which is
# whichever client just opened this popup. We then switch it by name with -c.
set -euo pipefail

# ── Re-rank mode (fzf reload target) ────────────────────────────────────────
# fzf sorts the whole candidate list by a single match score; it has no notion
# of "open sessions always above projects, each group score-sorted within". So
# the interactive fzf below runs --no-sort and we feed it the order we want,
# recomputed on every keystroke: fzf's `change:reload` re-invokes this script as
#   tmux-sessionizer --rerank <sess_file> <proj_file> <query>
# which score-sorts each group on its own (via `fzf --filter`) and prints
# sessions first. Empty query → the files' natural order (sessions by recency,
# projects alphabetical). This runs before any tmux call, so re-invocation stays
# cheap. `|| true`: `fzf --filter` exits 1 on zero matches, which set -e aborts.
if [ "${1:-}" = "--rerank" ]; then
  sess_file=$2 proj_file=$3 query=${4:-}
  if [ -z "$query" ]; then
    cat "$sess_file" "$proj_file"
  else
    fzf --filter="$query" --delimiter=$'\t' --with-nth=1 --ansi < "$sess_file" || true
    fzf --filter="$query" --delimiter=$'\t' --with-nth=1 --ansi < "$proj_file" || true
  fi
  exit 0
fi

WORKSPACE="$HOME/workspace"
# On the homelab, projects live on the encrypted ZFS dataset and ~/workspace is
# a symlink to it; scan it directly too so the list survives even without that
# symlink. The realpath guard in the projects block skips it when it IS the same
# physical dir as ~/workspace (the symlink case) so nothing lists twice.
PRIVATE_WORKSPACE="/media/storage/private/workspace"
TAB=$'\t'   # field delimiter for the tmux -F tables below; '|' is legal in a
            # session name (and would mis-split), a tab effectively never is.

# Switch that client to session $1 (attach if we somehow have no client/server).
# CLIENT is resolved lazily on first use — keeping that tmux call off the path
# to showing the popup, so fzf paints as early as possible.
CLIENT=""
go() {
  [ -z "$CLIENT" ] && CLIENT=$(tmux list-clients -F '#{client_activity} #{client_name}' \
    2>/dev/null | sort -rn | head -1 | cut -d' ' -f2- || true)
  if [ -n "$CLIENT" ]; then
    tmux switch-client -c "$CLIENT" -t "=$1"
  elif [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "=$1"
  else
    tmux attach -t "=$1"
  fi
}

# Running sessions, most-recently-attached first — the jump order shown on an
# empty query, and the within-sessions order before a typed query score-sorts.
open_names=$(
  tmux list-sessions -F "#{session_last_attached}${TAB}#{session_name}" 2>/dev/null \
    | sort -t"$TAB" -k1,1 -rn | cut -d"$TAB" -f2 || true
)

# Aggregate @agent_state to a numeric rank per session in ONE awk pass over all
# windows (precedence needs-input 4 > done 3 > running 2 > idle 1 > none/unset 0,
# same order as tmux-session-dots: how much each state wants from you) — the
# previous version re-scanned this whole table once per session (O(sessions ×
# windows) on the popup's paint path). Emits "<session>\t<rank>"; a session whose
# windows are all none/unset is simply absent → rank 0 on the lookup below.
win_states=$(tmux list-windows -a -F "#{session_name}${TAB}#{@agent_state}" 2>/dev/null || true)
session_ranks=$(printf '%s\n' "$win_states" | awk -F"$TAB" '
  { r = $2=="needs-input" ? 4 : $2=="done" ? 3 : $2=="running" ? 2 : $2=="idle" ? 1 : 0 }
  r > seen[$1] { seen[$1] = r }
  END { for (s in seen) print s "\t" seen[s] }
')
ranks_nl=$'\n'"$session_ranks"$'\n'   # \n<name>\t<rank>\n … for fork-free lookup

# Set $_dot to the truecolor glyph for rank $1 (mirrors dot_tmux.conf's palette).
# Assigns a var rather than printing so the emit loop needs no $() per session.
rank_dot() {
  case "$1" in
    4) _dot=$'\033[38;2;243;139;168m●\033[0m' ;;  # needs-input  #f38ba8
    3) _dot=$'\033[38;2;249;226;175m●\033[0m' ;;  # done         #f9e2af filled
    2) _dot=$'\033[38;2;137;180;250m●\033[0m' ;;  # running      #89b4fa
    1) _dot=$'\033[38;2;249;226;175m○\033[0m' ;;  # idle         #f9e2af hollow
    *) _dot=$'\033[38;2;108;112;134m●\033[0m' ;;  # none / unset #6c7086
  esac
}

# Build the two candidate groups into temp files; --rerank (above) reads them on
# every keystroke, and the trap clears them however we leave (pick, Esc, error).
sess_file=$(mktemp) proj_file=$(mktemp)
trap 'rm -f "$sess_file" "$proj_file"' EXIT

# Open workspaces (recency order, already sorted), agent-state dotted.
printf '%s\n' "$open_names" | while IFS= read -r s; do
  [ -z "$s" ] && continue
  r=0
  case "$ranks_nl" in
    *$'\n'"$s$TAB"*) r=${ranks_nl#*$'\n'"$s$TAB"}; r=${r%%$'\n'*} ;;
  esac
  rank_dot "$r"
  printf '%s  %s\tsession\t%s\n' "$_dot" "$s" "$s"
done > "$sess_file"

# Projects to offer: every dir under ~/workspace, plus a few fixed repos outside
# that root that I jump to often (the chezmoi dotfiles repo, the homelab repo),
# each listed only when present on this box. A project already open
# as a session is skipped. Pure-bash, no per-dir forks: an earlier version ran
# basename + grep per directory and that loop alone cost ~90ms (it dominated
# startup). Here the glob lists dirs alphabetically (and skips dotdirs like
# .claude for free, since pathname expansion ignores leading dots), parameter
# expansion does the basename, and a newline-delimited substring match tests
# open-ness.
open_nl=$'\n'"$open_names"$'\n'                 # \n<name>\n … \n for the match;
                                                # wrap directly — $() would strip
                                                # the trailing \n off the last name
# Emit a "<display>\tdir\t<path>" line for project dir $1, unless a session of
# the same (.:→_ squashed) name is already open.
emit_project() {
  d=${1%/}; base=${d##*/}                        # strip trailing / then dirname
  name=${base//[.:]/_}
  case "$open_nl" in *$'\n'"$name"$'\n'*) return ;; esac
  printf '  %s\tdir\t%s\n' "$base" "$d"
}
{
  if [ -d "$WORKSPACE" ]; then
    for d in "$WORKSPACE"/*/; do
      [ -d "$d" ] || continue                    # no-match glob stays literal
      emit_project "$d"
    done
  fi
  # Encrypted homelab workspace — only when it exists AND isn't the same physical
  # dir as ~/workspace (which symlinks here on the homelab; the guard stops every
  # project listing twice). [ -d ] short-circuits before readlink on boxes
  # without this path (e.g. macOS), so the macOS-`readlink` quirk never bites.
  if [ -d "$PRIVATE_WORKSPACE" ] \
     && [ "$(readlink -f "$PRIVATE_WORKSPACE")" != "$(readlink -f "$WORKSPACE")" ]; then
    for d in "$PRIVATE_WORKSPACE"/*/; do
      [ -d "$d" ] || continue
      emit_project "$d"
    done
  fi
  # Dotfiles repo (chezmoi source root) — listed only when present on this box.
  [ -d "$HOME/.local/share/chezmoi" ] && emit_project "$HOME/.local/share/chezmoi"
  # Homelab repo (lives on the storage mount) — listed only when present.
  [ -d "/media/storage/private/timvink-homelab" ] && emit_project "/media/storage/private/timvink-homelab"
} > "$proj_file"

# Create-or-switch for a project directory: session named after the dir (tmux
# forbids . and :, so they squash to _), agent in tab 1 and `nvim .` in tab 2.
open_project() {
  proj_dir=${1%/}
  name=${proj_dir##*/}; name=${name//[.:]/_}
  if ! tmux has-session -t "=$name" 2>/dev/null; then
    # Capture the new session's pane id for send-keys. send-keys needs a *pane*
    # target, and the "=name" exact-match form (fine for session lookups like
    # has-session) does NOT resolve as a pane — it errors, which under set -e
    # would abort the script before the switch below ever runs.
    pane=$(tmux new-session -d -P -F '#{pane_id}' -s "$name" -c "$proj_dir")
    tmux send-keys -t "$pane" {{ if eq (dig "codingAgent" "claude" .) "codex" }}co{{ else }}cc{{ end }} Enter
    # Second tab (window) with nvim; no -d so it becomes the selected window.
    nvim_pane=$(tmux new-window -P -F '#{pane_id}' -t "=$name" -c "$proj_dir")
    tmux send-keys -t "$nvim_pane" 'nvim .' Enter
  fi
  go "$name"
}

# The alt-n hint line. --footer landed in fzf 0.65; an older fzf (some distro
# packages) aborts on an unknown flag, and `|| exit 0` below would swallow that
# into "alt+f does nothing", so fall back to --header there — top of the popup
# instead of the bottom, but still discoverable.
hint='alt-n  new project in ~/workspace'
fzf_minor=$(fzf --version | cut -d. -f2)
case $fzf_minor in ''|*[!0-9]*) fzf_minor=0 ;; esac
if [ "$fzf_minor" -ge 65 ]; then
  hint_args=(--footer "$hint" --color='footer:#6c7086')
else
  hint_args=(--header "$hint" --color='header:#6c7086')
fi

# Interactive picker. --no-sort keeps the two-tier order --rerank hands us;
# change:reload recomputes it per keystroke; the initial list is the empty-query
# grouping. fzf still matches {q} to highlight, and drops nothing (every fed line
# already matched). $0/$sess_file/$proj_file expand now and bake into the bind
# string; {q} stays literal for fzf to substitute (it shell-quotes the query).
# alt-n `become`s a printf that emits one sentinel row in the same
# <display>\t<kind>\t<target> shape, carrying the current query as the proposed
# project name — see the alt-n note at the top for why it can't prompt in place.
selected=$(
  "$0" --rerank "$sess_file" "$proj_file" "" \
  | fzf --ansi --no-sort --reverse --cycle --no-multi \
        --delimiter=$'\t' --with-nth=1 \
        --bind "change:reload(\"$0\" --rerank \"$sess_file\" \"$proj_file\" {q})" \
        --bind "alt-n:become(printf '%s\tnew\t%s\n' new {q})" \
        --border=rounded --border-label=' Projects ' \
        --prompt='  ' --pointer='▶' \
        "${hint_args[@]}" \
        --color='border:#cba6f7,label:#cba6f7,prompt:#89b4fa,pointer:#f38ba8,bg+:#45475a,fg+:#cdd6f4'
) || exit 0
[ -z "$selected" ] && exit 0

kind=$(printf '%s' "$selected" | cut -f2)
target=$(printf '%s' "$selected" | cut -f3)

case $kind in
  session) go "$target" ;;
  dir)     open_project "$target" ;;
  new)
    # Input box: an fzf over an empty list, so the only thing it can return is
    # the query. `accept-or-print-query` is what makes enter print it (plain
    # `accept` has nothing to accept and would exit empty-handed); esc still
    # aborts, printing nothing, which the emptiness check below treats as
    # "changed my mind". Prefilled with whatever was typed in the picker.
    # (Not --print-query: that prints the query on *abort* too, which would turn
    # esc into "create it anyway".)
    # --height shrinks it to a small box at the top of the popup instead of a
    # mostly-empty full-screen list; fzf always keeps one (here blank) list row,
    # so 4 lines with the border is as short as this gets. --no-info and
    # --no-separator drop the 0/0 counter and its rule, which have nothing to
    # say about an empty list.
    name=$(: | fzf --height=3 --no-info --no-separator --reverse \
        --bind 'enter:accept-or-print-query' --query="$target" \
        --border=rounded --border-label=' New project ' \
        --prompt='  ~/workspace/' \
        --color='border:#a6e3a1,label:#a6e3a1,prompt:#89b4fa') || true
    # Trim surrounding whitespace, then bail on empty / path-ish names: a name
    # with a slash would silently make (or reopen) something outside the flat
    # one-level layout the picker lists.
    name=${name#"${name%%[![:space:]]*}"}
    name=${name%"${name##*[![:space:]]}"}
    [ -z "$name" ] && exit 0
    case $name in
      */*|.|..) tmux display-message "new project: '$name' is not a plain name"; exit 0 ;;
    esac
    mkdir -p "$WORKSPACE/$name"
    open_project "$WORKSPACE/$name"
    ;;
esac
