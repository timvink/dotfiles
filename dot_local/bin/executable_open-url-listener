#!/usr/bin/perl
# open-url-listener — a tiny loopback TCP server that opens URLs in this Mac's
# default browser on behalf of a headless remote box (devbox / homelab).
#
# Why this exists: a headless box has no browser and can't reach my Mac
# directly, and SSH has no built-in "open this on the client" channel. So my
# `devbox` alias / ssh config carry a reverse tunnel (-R 2489:127.0.0.1:2489)
# and the box's `xdg-open` shim sends the (already rewritten) URL down it to
# here. We `open` it on the Mac and reply "OK", so the box knows it worked and
# can otherwise fall back to printing a clickable link.
#
# Managed by chezmoi (macOS only); kept running by the com.timvink.openurl
# LaunchAgent. See docs/development/dev-environment.md in the infra repo.
#
# Also handles BROWSER JSON requests from host-browser over the same tunnel.
# Security: binds 127.0.0.1 only, reachable by local processes and authenticated
# SSH peers. Executes only open or the managed host-browser CLI in list form;
# request strings never become shell commands. Browser control includes the
# signed-in accounts in that session, so keep the tunnel on loopback.

use strict;
use warnings;
use IO::Socket::INET;
use JSON::PP;
use File::Temp;
use IPC::Open3;
use IO::Select;
use Symbol qw(gensym);

my $PORT = 2489;

my $srv = IO::Socket::INET->new(
    LocalAddr => '127.0.0.1',
    LocalPort => $PORT,
    Proto     => 'tcp',
    Listen    => 5,
    ReuseAddr => 1,
) or die "open-url-listener: cannot listen on 127.0.0.1:$PORT: $!\n";

$SIG{CHLD} = 'IGNORE';
while (my $client = $srv->accept) {
    # A browser command may take seconds; keep other sessions and URL opening
    # responsive. Each child owns one connection and its command's timeout.
    my $child = fork();
    if (!defined $child || $child) { close $client; next }
    close $srv;
    $SIG{CHLD} = 'DEFAULT';
    $SIG{ALRM} = sub { exit 1 };
    alarm 10;
    my $line = <$client>;
    alarm 0;
    if (defined $line) {
        $line =~ s/\s+\z//;   # strip the trailing newline (and any trailing ws)
        if ($line =~ s/\ABROWSER //) {
            my $response = eval { browser_command($line) };
            $response = {exit_code => 1, stdout => '', stderr => "host-browser: $@"} if $@;
            print {$client} encode_json($response), "\n";
        } elsif ($line =~ m{\Ahttps?://[\x21-\x7e]+\z} && length($line) <= 2048) {
            print {$client} "OK\n" if system('/usr/bin/open', '--', $line) == 0;
        }
    }
    close $client;
    exit 0;
}

sub browser_command {
    my ($json) = @_;
    die "request exceeds 1 MiB\n" if length($json) > 1024 * 1024;
    my $request = decode_json($json);
    die "invalid browser request\n" unless ref($request) eq 'HASH'
        && ref($request->{args}) eq 'ARRAY' && @{$request->{args}}
        && !grep { !defined($_) || ref($_) || /\0/ } @{$request->{args}};
    die "invalid stdin\n" if ref($request->{stdin});
    my $input = File::Temp->new();
    print {$input} $request->{stdin} // '';
    seek $input, 0, 0 or die "cannot rewind stdin: $!\n";
    my $err = gensym();
    my $pid = open3('<&' . fileno($input), my $out, $err,
        "$ENV{HOME}/.local/bin/host-browser", '--local', @{$request->{args}});
    my ($stdout, $stderr) = ('', '');
    my $out_fd = fileno($out);
    my $select = IO::Select->new($out, $err);
    my $ok = eval {
        local $SIG{ALRM} = sub { die "browser command timed out after 90 seconds\n" };
        alarm 90;
        while ($select->count) {
            for my $fh ($select->can_read()) {
                my $count = sysread($fh, my $buffer, 65536);
                die "cannot read browser output: $!\n" unless defined $count;
                if (!$count) { $select->remove($fh); close $fh; next }
                if (fileno($fh) == $out_fd) { $stdout .= $buffer }
                else { $stderr .= $buffer }
                die "browser output exceeds 8 MiB\n" if length($stdout) + length($stderr) > 8 * 1024 * 1024;
            }
        }
        waitpid($pid, 0);
        alarm 0;
        1;
    };
    if (!$ok) {
        my $error = $@;
        alarm 0;
        kill 'KILL', $pid;
        waitpid($pid, 0);
        die $error;
    }
    return {exit_code => ($? & 127) ? 128 + ($? & 127) : $? >> 8,
        stdout => $stdout, stderr => $stderr};
}
