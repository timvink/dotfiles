#!/usr/bin/perl
# open-url-listener — a tiny loopback TCP server that opens URLs in this Mac's
# default browser on behalf of a headless remote box (devbox / homelab).
#
# Why this exists: a headless box has no browser and can't reach my Mac
# directly, and SSH has no built-in "open this on the client" channel. So my
# `devbox` alias / ssh config carry a reverse tunnel (-R 2489:127.0.0.1:2489)
# and the box's `xdg-open` shim sends the (already rewritten) URL down it to
# here. We `open` it on the Mac and reply "OK", so the box knows it worked and
# can otherwise fall back to printing a clickable link.
#
# Managed by chezmoi (macOS only); kept running by the com.timvink.openurl
# LaunchAgent. See docs/development/dev-environment.md in the infra repo.
#
# Also handles browser control and clipboard reads over the same tunnel.
# Security: binds 127.0.0.1 only, reachable by local processes and authenticated
# SSH peers. Clipboard contents are exchanged only on explicit copy/paste requests.
# Executes only fixed clipboard tools, open, or the managed host-browser CLI;
# request strings never become shell commands. Browser control includes the
# signed-in accounts in that session, so keep the tunnel on loopback.

use strict;
use warnings;
use IO::Socket::INET;
use JSON::PP;
use File::Temp;
use IPC::Open3;
use IO::Select;
use Symbol qw(gensym);
use MIME::Base64 qw(encode_base64 decode_base64);
use Encode qw(decode FB_CROAK LEAVE_SRC);
use Fcntl qw(F_SETFL O_NONBLOCK);
use Time::HiRes qw(alarm clock_gettime CLOCK_MONOTONIC);

my $PORT = 2489;
my $MAX_CLIPBOARD_BYTES = 10 * 1024 * 1024;

my $srv = IO::Socket::INET->new(
    LocalAddr => '127.0.0.1',
    LocalPort => $PORT,
    Proto     => 'tcp',
    Listen    => 5,
    ReuseAddr => 1,
) or die "open-url-listener: cannot listen on 127.0.0.1:$PORT: $!\n";

$SIG{CHLD} = 'IGNORE';
while (my $client = $srv->accept) {
    # A browser command may take seconds; keep other sessions and URL opening
    # responsive. Each child owns one connection and its command's timeout.
    my $child = fork();
    if (!defined $child || $child) { close $client; next }
    close $srv;
    $SIG{CHLD} = 'DEFAULT';
    $SIG{ALRM} = sub { exit 1 };
    alarm 10;
    my $line = <$client>;
    alarm 0;
    if (defined $line) {
        $line =~ s/\r?\n\z//;
        # Preserve write payload whitespace so malformed base64 is rejected.
        $line =~ s/\s+\z// unless $line =~ /\AWRITE_CLIPBOARD(?: |\z)/;
        if ($line eq 'CLIPBOARD_CAPABILITY') {
            print {$client} clipboard_tools_available()
                ? (-x '/usr/bin/pbcopy' ? "OK CLIPBOARD_V2\n" : "OK CLIPBOARD_V1\n")
                : "ERROR CLIPBOARD_UNAVAILABLE\n";
        } elsif ($line eq 'WRITE_CLIPBOARD' || $line =~ /\AWRITE_CLIPBOARD /) {
            my $encoded = $line eq 'WRITE_CLIPBOARD' ? '' : substr($line, 16);
            my $reply = eval { write_clipboard($encoded) };
            $reply = 'ERROR CLIPBOARD_WRITE (could not write clipboard)' if $@;
            print {$client} $reply, "\n";
        } elsif ($line eq 'READ_CLIPBOARD' || $line eq 'READ_CLIPBOARD_IMAGE') {
            my $reply = eval { clipboard_reply($line eq 'READ_CLIPBOARD_IMAGE') };
            if ($@) {
                $reply = $@ =~ /clipboard output exceeds limit/
                    ? 'ERROR CLIPBOARD_TOO_LARGE (maximum 10 MiB)'
                    : 'ERROR CLIPBOARD (could not read clipboard)';
            }
            print {$client} $reply, "\n";
        } elsif ($line =~ s/\ABROWSER //) {
            my $response = eval { browser_command($line) };
            $response = {exit_code => 1, stdout => '', stderr => "host-browser: $@"} if $@;
            print {$client} encode_json($response), "\n";
        } elsif ($line =~ m{\Ahttps?://[\x21-\x7e]+\z} && length($line) <= 2048) {
            print {$client} "OK\n" if system('/usr/bin/open', '--', $line) == 0;
        }
    }
    close $client;
    exit 0;
}

sub clipboard_reply {
    my ($images_only) = @_;
    # LaunchAgents inherit a minimal locale; pbpaste must emit UTF-8 bytes.
    local $ENV{LC_ALL} = 'en_US.UTF-8';
    my $deadline = clock_gettime(CLOCK_MONOTONIC) + 2;
    my $pngpaste = pngpaste_path();
    die "pngpaste unavailable\n" unless $pngpaste;
    # pngpaste writes files atomically, replacing their inode. Read stdout so
    # an already-open temporary file cannot keep pointing at the empty old file.
    my ($status, $bytes) = clipboard_command($deadline, undef, $pngpaste, '-');
    if ($status == 0) {
        die "pngpaste produced an empty image\n" unless length($bytes);
        return 'IMAGE ' . encode_base64($bytes, '');
    }
    return 'NO_IMAGE' if $images_only;
    my ($text_status, $text) = clipboard_command($deadline, undef, '/usr/bin/pbpaste', '-Prefer', 'txt');
    die "pbpaste failed\n" if $text_status != 0;
    return length($text) ? 'TEXT ' . encode_base64($text, '') : 'EMPTY';
}

sub pngpaste_path {
    my ($tool) = grep { -x $_ } (
        "$ENV{HOME}/.local/bin/pngpaste", '/opt/homebrew/bin/pngpaste', '/usr/local/bin/pngpaste'
    );
    return $tool;
}

sub clipboard_tools_available {
    return pngpaste_path() && -x '/usr/bin/pbpaste';
}

sub write_clipboard {
    my ($encoded) = @_;
    return 'ERROR CLIPBOARD_TOO_LARGE (maximum 10 MiB)'
        if length($encoded) > 4 * int(($MAX_CLIPBOARD_BYTES + 2) / 3);
    return 'ERROR CLIPBOARD_ENCODING (invalid base64)'
        if length($encoded) % 4 != 0 || $encoded !~ /\A[A-Za-z0-9+\/]*={0,2}\z/;
    my $bytes = decode_base64($encoded);
    return 'ERROR CLIPBOARD_ENCODING (invalid base64)'
        if encode_base64($bytes, '') ne $encoded;
    return 'ERROR CLIPBOARD_TOO_LARGE (maximum 10 MiB)'
        if length($bytes) > $MAX_CLIPBOARD_BYTES;
    return 'ERROR CLIPBOARD_ENCODING (invalid UTF-8)'
        unless eval { decode('UTF-8', $bytes, FB_CROAK | LEAVE_SRC); 1 };
    local $ENV{LC_ALL} = 'en_US.UTF-8';
    my ($status) = clipboard_command(clock_gettime(CLOCK_MONOTONIC) + 2,
        $bytes, '/usr/bin/pbcopy');
    return $status == 0 ? 'OK' : 'ERROR CLIPBOARD_WRITE (could not write clipboard)';
}

sub clipboard_command {
    my ($deadline, $stdin, @command) = @_;
    my $err = gensym();
    my $pid = open3(my $input, my $out, $err, @command);
    binmode $input;
    my ($stdout, $stderr_length) = ('', 0);
    my $out_fd = fileno($out);
    my $readers = IO::Select->new($out, $err);
    my $writers = IO::Select->new();
    my $offset = 0;
    my $ok = eval {
        local $SIG{PIPE} = 'IGNORE';
        local $SIG{ALRM} = sub { die "clipboard command timed out\n" };
        my $remaining = $deadline - clock_gettime(CLOCK_MONOTONIC);
        die "clipboard command timed out\n" unless $remaining > 0;
        alarm $remaining;
        if (defined($stdin) && length($stdin)) {
            fcntl($input, F_SETFL, O_NONBLOCK) or die "cannot prepare clipboard input\n";
            $writers->add($input);
        } else { close $input }
        while ($readers->count || $writers->count) {
            my ($ready_read, $ready_write) = IO::Select->select($readers, $writers,
                undef, $deadline - clock_gettime(CLOCK_MONOTONIC));
            die "clipboard command timed out\n" unless $ready_read || $ready_write;
            for my $fh (@{$ready_read || []}) {
                my $count = sysread($fh, my $buffer, 65536);
                die "cannot read clipboard output\n" unless defined $count;
                if (!$count) { $readers->remove($fh); close $fh; next }
                if (fileno($fh) == $out_fd) { $stdout .= $buffer }
                else { $stderr_length += $count }
                die "clipboard output exceeds limit\n"
                    if length($stdout) > $MAX_CLIPBOARD_BYTES || $stderr_length > 65536;
            }
            for my $fh (@{$ready_write || []}) {
                my $count = syswrite($fh, $stdin, 65536, $offset);
                if (!defined($count)) {
                    next if $!{EAGAIN} || $!{EINTR};
                    die "cannot write clipboard input\n";
                }
                $offset += $count;
                if ($offset == length($stdin)) { $writers->remove($fh); close $fh }
            }
        }
        waitpid($pid, 0);
        alarm 0;
        1;
    };
    if (!$ok) {
        my $error = $@;
        alarm 0;
        kill 'KILL', $pid;
        waitpid($pid, 0);
        die $error;
    }
    return (($? & 127) ? 128 + ($? & 127) : $? >> 8, $stdout);
}

sub browser_command {
    my ($json) = @_;
    die "request exceeds 1 MiB\n" if length($json) > 1024 * 1024;
    my $request = decode_json($json);
    die "invalid browser request\n" unless ref($request) eq 'HASH'
        && ref($request->{args}) eq 'ARRAY' && @{$request->{args}}
        && !grep { !defined($_) || ref($_) || /\0/ } @{$request->{args}};
    die "invalid stdin\n" if ref($request->{stdin});
    my $input = File::Temp->new();
    print {$input} $request->{stdin} // '';
    seek $input, 0, 0 or die "cannot rewind stdin: $!\n";
    my $err = gensym();
    my $pid = open3('<&' . fileno($input), my $out, $err,
        "$ENV{HOME}/.local/bin/host-browser", '--local', @{$request->{args}});
    my ($stdout, $stderr) = ('', '');
    my $out_fd = fileno($out);
    my $select = IO::Select->new($out, $err);
    my $ok = eval {
        local $SIG{ALRM} = sub { die "browser command timed out after 90 seconds\n" };
        alarm 90;
        while ($select->count) {
            for my $fh ($select->can_read()) {
                my $count = sysread($fh, my $buffer, 65536);
                die "cannot read browser output: $!\n" unless defined $count;
                if (!$count) { $select->remove($fh); close $fh; next }
                if (fileno($fh) == $out_fd) { $stdout .= $buffer }
                else { $stderr .= $buffer }
                die "browser output exceeds 8 MiB\n" if length($stdout) + length($stderr) > 8 * 1024 * 1024;
            }
        }
        waitpid($pid, 0);
        alarm 0;
        1;
    };
    if (!$ok) {
        my $error = $@;
        alarm 0;
        kill 'KILL', $pid;
        waitpid($pid, 0);
        die $error;
    }
    return {exit_code => ($? & 127) ? 128 + ($? & 127) : $? >> 8,
        stdout => $stdout, stderr => $stderr};
}
