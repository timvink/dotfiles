#!/bin/sh
# Set the @agent_state user option on the current tmux window. The tmux
# window-status-format reads it to render a per-tab agent indicator dot:
#
#   running     → blue   ●  (agent is working: producing output, or its turn
#                            ended with in-flight background work — a
#                            run_in_background shell, subagent, … — that will
#                            auto-resume it; either way, don't expect a prompt)
#   needs-input → red    ●  (agent is blocked on a question / approval)
#   idle        → yellow ○  (turn complete, awaiting a prompt — "your turn")
#   none        → (no dot) (clears the option: a fresh session that hasn't
#                            finished a turn yet looks like a plain shell tab.
#                            Set on SessionStart so a new session isn't yellow
#                            and a reused window drops any stale prior state.)
#
# Driven by the Claude Code and Codex lifecycle hooks (see
# dot_claude/modify_settings.json and dot_codex/private_hooks.json), plus
# `agent-interrupt-state` for the ESC-cancel case Claude Code fires no hook
# for. Tabs that never run an agent (shells, nvim, …) never set @agent_state,
# so they show no dot at all.
#
# Alongside the dot it stamps @agent_since, the epoch second the state last
# changed, which is where the overview's "blocked · 6m12s" comes from.
#
# Usage: agent-state running|idle|needs-input|none
#
# No-op outside tmux. Always exits 0 so the agent doesn't surface an error.

state="${1:-}"

if [ -n "${TMUX_PANE:-}" ]; then
    # Per-pane sentinel: present on disk exactly while this pane's window carries
    # an @agent_state dot. The zsh precmd reaper (dot_zshrc.tmpl) stat-checks it
    # to cheaply decide whether to clear a stale dot when the shell prompt
    # returns — the backstop for exits that fire no clearing hook (Codex has no
    # SessionEnd; a crash/SIGKILL fires nothing). Keep this path formula byte-for-
    # byte identical to the reaper's, or the two won't agree on the file.
    sentinel="${TMPDIR:-/tmp}/agent-dot-${TMUX_PANE#%}"
    win=$(tmux display-message -t "$TMUX_PANE" -p '#{window_id}' 2>/dev/null)
    if [ -n "${win:-}" ]; then
        if [ "$state" = none ]; then
            # Unset the option entirely → no dot, and a reused window doesn't
            # carry a stale state from a previous agent session. @agent_note (the
            # companion "what is it doing" line, see agent-note) and
            # @agent_subagents (how wide it has fanned out, see agent-subagents)
            # go with it: every path that clears the dot — SessionStart,
            # SessionEnd, the zsh precmd reaper — means this window's agent is
            # gone, so both are stale by definition. Clearing here rather than in
            # each caller keeps the options impossible to desync, and is what
            # stops a session killed mid-fan-out from leaving its subagents
            # counted in the status bar forever.
            tmux set-option -wt "$win" -u '@agent_state' 2>/dev/null || true
            tmux set-option -wt "$win" -u '@agent_note' 2>/dev/null || true
            tmux set-option -wt "$win" -u '@agent_since' 2>/dev/null || true
            tmux set-option -wt "$win" -u '@agent_subagents' 2>/dev/null || true
            tmux set-option -wt "$win" -u '@agent_bg' 2>/dev/null || true
            rm -f "$sentinel" 2>/dev/null || true
        else
            # @agent_since: the epoch second this state began, which is what the
            # overview's detail pane counts "2m14s" from. Stamped only when the
            # state actually CHANGES — PostToolUse fires "running" over and over
            # inside a single turn, and restamping there would keep resetting the
            # clock to zero. Costs one extra tmux call on a path already making
            # two, which is nothing next to the hook's own startup.
            prev=$(tmux show-options -wt "$win" -qv '@agent_state' 2>/dev/null)
            [ "$prev" = "$state" ] \
                || tmux set-option -wt "$win" '@agent_since' "$(date +%s)" 2>/dev/null \
                || true
            # @agent_bg annotates one specific blue — the one agent-stop-state
            # sets when a turn ends with agent-driven work still attached — and
            # tells agent-state-sweep to leave that blue alone. Any later state,
            # including another `running` from PreToolUse, means the session has
            # moved on, so the annotation is dropped here and agent-stop-state
            # re-adds it if the next turn ends the same way. Setting it that way
            # round is what stops it outliving the reason it was set.
            tmux set-option -wt "$win" -u '@agent_bg' 2>/dev/null || true
            tmux set-option -wt "$win" '@agent_state' "$state" 2>/dev/null || true
            : > "$sentinel" 2>/dev/null || true
        fi
    fi
fi

exit 0
