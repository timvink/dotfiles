#!/usr/bin/env bash
# youtube-history-capture — save my YouTube watch history page, as YouTube's own
# JSON, for the homelab's browser-history archive (timvink-homelab repo,
# browser-history/src/browser_history/sources/youtube.py parses it).
#
# youtube.com/feed/history lists what I watched on every device, the phone and
# TV apps included, grouped by day. Once a day this loads it in headless Google
# Chrome with a profile of its own that is signed in to Google (see
# youtube-history-login), and writes ~/.local/state/youtube-history/<host>-youtube-history.json:
#   { format, captured_at (UTC), tz, status: "ok" | "error", error, url, title,
#     logged_in (ytcfg LOGGED_IN), initial: ytInitialData }
# browser-history-push uploads that file like a browser database. The Mac only
# captures: whether I'm signed in, history is on, and the format still parses
# is all decided on the homelab, which emails when a check fails.
#
# How: `chrome --headless --dump-dom` prints the page after it ran, and the
# page's own JSON sits in it as `var ytInitialData = {...};`. The first page
# reaches weeks back, so a daily capture overlaps the previous ones. Chrome is
# started directly rather than through a browser-automation tool: Google
# refuses sign-in in automated Chrome builds, an automation tool's mock
# keychain can't decrypt the saved cookies ("Chrome Safe Storage" Keychain
# item), and --dump-dom opens no DevTools port another process could use to
# read the session. Chrome exits on its own; `timeout` covers a hang.
#
# Schedule: the com.timvink.youtube-history LaunchAgent runs this hourly; a
# stamp makes every run after the first successful capture of the day a no-op,
# so the capture happens within an hour of the Mac's first wake each day. A
# run while the profile is open elsewhere (youtube-history-login) fails, and
# the next hour tries again.
#
# The profile dir holds a live Google session: it stays private (umask 077) and
# never leaves the Mac.
set -uo pipefail
umask 077

PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
PROFILE="$HOME/.local/share/youtube-history/profile"
STATE_DIR="$HOME/.local/state/youtube-history"
STAMP="$STATE_DIR/captured-on"
URL='https://www.youtube.com/feed/history'

log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*"; }

host=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
host=$(printf '%s' "$host" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9_-')
OUT="$STATE_DIR/$host-youtube-history.json"
today=$(date +%F)

if [[ $(cat "$STAMP" 2>/dev/null) == "$today" && ${1:-} != --force ]]; then
	exit 0
fi
mkdir -p "$STATE_DIR"
if [[ ! -d $PROFILE ]]; then
	log "no browser profile at $PROFILE; run youtube-history-login"
	exit 1
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/youtube-history.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT

# write_capture <status> <error> [dom file]: the capture file, written atomically.
# For a page, Python takes the JSON out of the DOM; if it isn't there (a
# consent or sign-in page), initial stays null and the homelab says why.
write_capture() {
	python3 - "$OUT" "$1" "$2" "${3:-}" <<'EOF'
import json, os, re, sys, time
out, status, error, dom_path = sys.argv[1:5]
doc = {"format": 1, "captured_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
       "tz": "Europe/Amsterdam", "status": status, "error": error or None,
       "url": None, "title": None, "logged_in": None, "initial": None}
if dom_path:
    html = open(dom_path, encoding="utf-8", errors="replace").read()
    if m := re.search(r'<link rel="canonical" href="([^"]+)"', html):
        doc["url"] = m.group(1)
    if m := re.search(r"<title>(.*?)</title>", html, re.S):
        doc["title"] = m.group(1).strip()
    if m := re.search(r'"LOGGED_IN":(true|false)', html):
        doc["logged_in"] = m.group(1) == "true"
    start = html.find("var ytInitialData = ")
    if start != -1:
        doc["initial"], _ = json.JSONDecoder().raw_decode(html, start + len("var ytInitialData = "))
tmp = out + ".tmp"
with open(tmp, "w") as f:
    json.dump(doc, f)
os.replace(tmp, out)
print(f"{os.path.getsize(out) // 1000} kB, signed in: {doc['logged_in']}")
EOF
}

fail() {
	log "capture failed: $1"
	write_capture error "$1"
	exit 1
}

timeout -k 10 120 "$CHROME" --headless=new --user-data-dir="$PROFILE" --no-first-run \
	--no-default-browser-check --virtual-time-budget=15000 --dump-dom "$URL" \
	>"$work/dom.html" 2>"$work/chrome.log"
rc=$?
if ((rc != 0)) || [[ ! -s $work/dom.html ]]; then
	fail "Chrome exit $rc: $(grep -m1 -i -E 'error|failed' "$work/chrome.log")"
fi
write_capture ok "" "$work/dom.html" || fail "could not read the page's JSON"
echo "$today" >"$STAMP"
log "captured $(basename "$OUT")"
