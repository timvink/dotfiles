#!/usr/bin/env python3
"""mcp-reconnect — keep a stdio MCP server alive across dropped connections.

Usage: mcp-reconnect <command> [args...]

Sits between an MCP client (Claude Code, Codex) and a stdio server command,
typically `ssh homelab docker exec -i <container> <server>`. Clients do not
restart a stdio server that exits, so when the Mac sleeps and the ssh dies,
the server's tools vanish until a manual /mcp reconnect. This relay keeps the
client's pipe open instead: when the child has died, the next client message
starts a fresh child, replays the recorded `initialize` handshake to it, and
then forwards the message as if nothing happened.

- Requests in flight when the child dies get a JSON-RPC error, so the tool
  call returns instead of hanging.
- Reconnection is lazy (on the next client message), so an offline machine
  costs nothing until a tool is used; a failed reconnect answers that request
  with an error and is retried on the next one.
- If the very first connection fails before `initialize` is answered, the
  relay exits, so a stopped container still shows as a failed server.
- Only works for stateless servers: per-session state, such as subscriptions,
  is not replayed.

The child only exits on a half-open connection (after sleep) if ssh notices,
so pair this with `-o ServerAliveInterval=...` on the ssh command.
"""

import json
import os
import signal
import subprocess
import sys
import threading

REPLAY_ID = "mcp-reconnect-replay-initialize"
HANDSHAKE_TIMEOUT_S = 30
LOST_CONNECTION = -32000

stdout_lock = threading.Lock()


def log(msg):
    print(f"mcp-reconnect: {msg}", file=sys.stderr, flush=True)


def emit(obj):
    with stdout_lock:
        sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
        sys.stdout.flush()


def error_reply(req_id, message):
    emit({"jsonrpc": "2.0", "id": req_id, "error": {"code": LOST_CONNECTION, "message": message}})


class Relay:
    def __init__(self, cmd):
        self.cmd = cmd
        self.lock = threading.Lock()
        self.child = None
        self.initialize = None  # the client's initialize request, replayed on reconnect
        self.initialized = None  # the client's notifications/initialized
        self.connected = False  # the first initialize has been answered
        self.pending = set()  # client request ids the current child owes a response

    def spawn(self):
        child = subprocess.Popen(self.cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
        child.replayed = threading.Event()  # per child, so a stale child can't wake a reconnect
        self.child = child
        threading.Thread(target=self.read_child, args=(child,), daemon=True).start()
        return child

    def read_child(self, child):
        for raw in child.stdout:
            try:
                msg = json.loads(raw)
            except ValueError:
                continue
            if isinstance(msg, dict) and "method" not in msg and "id" in msg:
                if msg["id"] == REPLAY_ID:
                    child.replayed.set()
                    continue
                with self.lock:
                    if self.initialize is not None and msg["id"] == self.initialize.get("id"):
                        self.connected = True
                    self.pending.discard(msg["id"])
            emit(msg)
        child.wait()
        child.replayed.set()  # wake a reconnect() waiting on this child
        with self.lock:
            if child is not self.child:
                return
            if not self.connected:
                log(f"server exited with code {child.returncode} before initializing")
                os._exit(child.returncode or 1)  # from a thread, sys.exit would not end the process
            log(f"server exited with code {child.returncode}; reconnecting on next message")
            lost, self.pending = self.pending, set()
        for req_id in lost:
            error_reply(req_id, "Connection to the MCP server was lost; it reconnects on the next call.")

    def write(self, child, msg):
        child.stdin.write((json.dumps(msg, separators=(",", ":")) + "\n").encode())
        child.stdin.flush()

    def reconnect(self):
        """Start a fresh child and replay the handshake. Returns it, or None."""
        log("reconnecting")
        child = self.spawn()
        try:
            self.write(child, {**self.initialize, "id": REPLAY_ID})
            if not child.replayed.wait(HANDSHAKE_TIMEOUT_S) or child.poll() is not None:
                raise TimeoutError("no initialize response")
            if self.initialized is not None:
                self.write(child, self.initialized)
        except (OSError, TimeoutError) as e:
            log(f"reconnect failed: {e}")
            child.kill()
            return None
        log("reconnected")
        return child

    def forward(self, msg):
        is_request = isinstance(msg, dict) and "method" in msg and "id" in msg
        method = msg.get("method") if isinstance(msg, dict) else None
        if method == "initialize":
            self.initialize = msg
        elif method == "notifications/initialized":
            self.initialized = msg

        child = self.child
        if child.poll() is not None or child.stdout.closed:
            if not self.connected:
                return
            child = self.reconnect()
            if child is None:
                if is_request:
                    error_reply(msg["id"], "The MCP server is unreachable; try again shortly.")
                return
        if is_request:
            with self.lock:
                self.pending.add(msg["id"])
        try:
            self.write(child, msg)
        except OSError:
            # Died between the check and the write; the reader thread answers
            # the pending request once it sees the exit.
            pass

    def run(self):
        self.spawn()
        for raw in sys.stdin.buffer:
            try:
                msg = json.loads(raw)
            except ValueError:
                continue
            self.forward(msg)
        self.shutdown()

    def shutdown(self, *_):
        if self.child and self.child.poll() is None:
            self.child.terminate()
        sys.exit(0)


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    relay = Relay(sys.argv[1:])
    for sig in (signal.SIGTERM, signal.SIGINT):  # Claude Code stops servers with SIGINT
        signal.signal(sig, relay.shutdown)
    relay.run()


if __name__ == "__main__":
    main()
