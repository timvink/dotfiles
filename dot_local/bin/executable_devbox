#!/usr/bin/env bash
# SSH into my Azure devbox VM. Three tunnels ride the connection:
#   -D 1080  SOCKS proxy → view any dev server as http://devbox:<port> (the PAC
#            in ~/.config/proxy.pac routes the `devbox` host through it; the box
#            resolves `devbox` to its own loopback).
#   -R 2489  reverse tunnel → the box's xdg-open shim sends URLs back to the
#            open-url-listener here so links open in this Mac's browser.
#   -L 43127 loopback OAuth callback → provider redirects to the Mac's
#            127.0.0.1:43127 reach Codex on the box. Keep in sync with Linux's
#            mcp_oauth_callback_port in dot_codex/modify_private_config.toml.tmpl.
# The -o ControlMaster option lets `ssh-image-paste` reuse this
# connection to stream a clipboard image into the box's /tmp on ⌘V. This script
# also marks this window as the image-paste session (see _remote_window in
# ~/.local/lib/remote-session.sh) for the session's duration; `homelab` marks its
# own window the same way. See ~/.local/bin/xdg-open (box), and
# ~/.local/bin/open-url-listener + ~/.local/bin/ssh-image-paste (this Mac).
#
# The session itself is _devbox_session below; the main body owns only the window
# marker and the one retry. If the box refuses the -R 2489 bind because a dead session
# still holds the port, _devbox_reclaim_fwd clears it and we reconnect once. A second
# failure means something is holding it that the reclaim deliberately won't kill (it
# prints which), so we stop rather than loop.
#
# Shared helpers (window marker, terminal recovery, dead-master cleanup, ~/Downloads
# mount): ~/.local/lib/remote-session.sh.
. "$HOME/.local/lib/remote-session.sh"

DEVBOX_SOCK="$HOME/.ssh/cm-devbox.sock"

# Resolve "<user> <host>" for the live devbox connection without hardcoding the
# VM's public IP (it changes across deallocations): parse it off the `ssh <ip> -l
# <user> …` child that az spawned, and cache it. Once an interactive session
# exits, ControlPersist retitles that process to "[mux]" and the args vanish, so
# in the persist window we fall back to the cache (trusted only while the master
# socket still exists). Empty if there's no usable connection at all.
_devbox_conn() {
  local cache="$HOME/.ssh/cm-devbox.conn" conn
  conn="$(ps -Ao args 2>/dev/null | grep -F 'cm-devbox.sock' | awk '
    {u="";h="";for(i=1;i<=NF;i++){if($i=="-l")u=$(i+1);if($i=="ssh")h=$(i+1)}
     if(u!=""&&h!=""){print u" "h; exit}}')"
  if [ -n "$conn" ]; then
    printf '%s\n' "$conn" > "$cache"
    printf '%s\n' "$conn"
  elif [ -S "$DEVBOX_SOCK" ] && [ -f "$cache" ]; then
    cat "$cache"
  fi
}

# Resolver for the shared helpers: address the live master by its socket, with the
# user and host it was opened with.
_devbox_dest() {
  local conn user host
  conn="$(_devbox_conn)"
  [ -n "$conn" ] || return 1
  read -r user host <<< "$conn"
  REMOTE_DEST=(-o ControlPath="$DEVBOX_SOCK" -o User="$user" "$host")
}

# devbox teardown: resolve the dest while we still can (the socket persists ~30m after
# exit), else just kill the local bridge.
_revumount_devbox() {
  if _devbox_dest; then
    _revumount devbox "${REMOTE_DEST[@]}"
  else
    _revumount devbox
  fi
}

# One connect attempt: make sure a usable master exists, ride it into an interactive
# shell, tear the mount down on the way out. Returns 2 — and only 2 — when the box
# refused the -R 2489 bind, the one failure the main body knows how to heal.
SESSION_PIDS=""
_devbox_session() {
  # Must come first: a dead master left over from a previous session would otherwise
  # swallow this connect whole, and the mount waiter below would latch onto it too.
  _ssh_drop_dead_master devbox "$DEVBOX_SOCK" _devbox_dest
  local rc dest
  _devbox_ensure_master; rc=$?
  [ "$rc" -eq 0 ] || return "$rc"
  if ! _devbox_dest; then
    printf '%s\n' "devbox: the master is up but its address can't be resolved — re-run devbox" >&2
    return 1
  fi
  dest=("${REMOTE_DEST[@]}")
  # Auto-mount ~/Downloads (read-write) at devbox:~/mac-downloads for this session.
  # The waiter mounts as soon as the master answers and is torn down on exit. It is
  # started per attempt so a retried attempt gets a *fresh* waiter: its poll window is
  # only ~30s, which a failed attempt plus a reclaim would burn.
  _revmount_bg devbox _devbox_dest &
  SESSION_PIDS="$!"
  # Push window resizes down to the box for as long as the session lasts, because the
  # connection itself sometimes loses them — see _devbox_winch_bg. Per attempt for the
  # same reason as the mount waiter: a retried attempt gets a fresh watcher instead of
  # one already talking to the connection that failed.
  _devbox_winch_bg "${dest[@]}" &
  SESSION_PIDS="$SESSION_PIDS $!"
  # The shell itself is a plain mux client, NOT az — and that is what makes exiting
  # instant. az waits on the ssh process it spawns, and under ControlMaster that same
  # process goes on to serve the master, so an az-run session can't return until the
  # master dies: with ControlPersist that's up to half an hour, and with the mount
  # bridge attached (a mux session keeps the master alive) it is never. Exiting looked
  # like a frozen terminal. A mux client exits the moment the shell does.
  # The terminal is quiet for free too: az's forced -v and the "channel N: open failed"
  # spam the forwards emit (a browser tab still pointing at a devbox:<port> dev server
  # that has since stopped) belong to the master and now land in its log, not here.
  ssh "${dest[@]}"
  _devbox_session_end
  return 0
}

# Undo what a session attempt set up. Idempotent, so the EXIT trap can call it whether
# or not the attempt already cleaned up after itself. Terminal modes first, before the
# slow unmount, so few stray mouse reports pile up.
_devbox_session_end() {
  [ -n "$SESSION_PIDS" ] || return 0
  _term_restore
  # shellcheck disable=SC2086 # a list of pids
  kill $SESSION_PIDS 2>/dev/null
  SESSION_PIDS=""
  _revumount_devbox
}

# Bring up the shared master unless one is already running, and leave it in the background
# for the next devbox to reuse — ControlPersist keeps it ~30m after the last client leaves,
# so a reconnect within that window costs nothing and needs no az round trip at all.
# Returns 2 when the box refused the -R 2489 bind, 1 when the connection never came up.
_devbox_ensure_master() {
  local sock="$DEVBOX_SOCK" log rc=0 i
  # _ssh_drop_dead_master ran first, so a socket still here has answered a round trip.
  [ -S "$sock" ] && return 0
  log="$(mktemp "${TMPDIR:-/tmp}/devbox-master.XXXXXX" 2>/dev/null)"
  [ -n "$log" ] || log="${TMPDIR:-/tmp}/devbox-master.$$"
  printf '%s\n' "devbox: opening a connection…" >&2
  # --only-show-errors silences the ssh extension's unconditional "upgrade to az ssh
  # >=2.0.4" breaking-change banner (hardcoded in azext_ssh, fires on every `az ssh vm`
  # regardless of installed version) without hiding real az errors like auth failures
  # or a missing VM.
  #
  # -N -f: no remote command, and fork into the background once authenticated with the
  # forwards up. The fork re-parents the master to init, and it serves clients from that
  # moment — but az does NOT return when it happens: it goes on waiting for EOF on the
  # stderr pipe the master inherited, i.e. for the master's entire life. So az is put in
  # the background too and we wait for the socket instead of for az. That leftover wait is
  # useful rather than merely harmless: it is what makes az clean up the ephemeral AAD
  # cert once the master finally exits. The subshell keeps the shell from announcing it
  # with a job-control line.
  #
  # Its output can't be quietened, only redirected: this is an AAD login, so azext_ssh
  # sets delete_cert and force-injects its OWN `-v` into the ssh command (ssh_utils.py,
  # to parse the log for auth success and clean up that cert). A command-line `-v` pins
  # LogLevel=DEBUG and unconditionally beats any `-o LogLevel` we pass (that only applies
  # while the level is still unset). So it goes to $log, which is shown only if the master
  # never appears, and which the master keeps writing to through the unlink below — that
  # is deliberate: it swallows the channel spam for the master's whole life. (homelab uses
  # plain ssh with no injected `-v`, so its `LogLevel FATAL` in ~/.ssh/config just works.)
  #
  # -o ExitOnForwardFailure=yes: if -R 2489, -D 1080 or -L 43127 can't bind, fail loudly rather
  # than leave a master that silently lacks its tunnels — a lost -R 2489 bind kills
  # prefix+u URL-opening (the box's xdg-open shim can't reach the listener here) with no
  # signal at all. The stale port does NOT necessarily clear on its own, so devbox
  # reclaims it — see _devbox_reclaim_fwd.
  #
  # -o ServerAliveInterval/CountMax: bound how long this master can outlive its own
  # connection. Without keepalives a master whose peer vanished (IP change, sleep) sits
  # there for the full persist window looking healthy, and it is exactly what the next
  # devbox rides into a hang — see _ssh_drop_dead_master, which cleans up the ones that
  # slip through this ~60s window. A blip shorter than that rides through untouched.
  ( az ssh vm -n vm-devbox-tim-vink -g rg-nwf-devbox-tim-vink --only-show-errors -- \
      -N -f -D 1080 -R 2489:127.0.0.1:2489 \
      -L 127.0.0.1:43127:127.0.0.1:43127 \
      -o ControlMaster=yes -o ControlPath="$sock" -o ControlPersist=30m \
      -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
      -o ExitOnForwardFailure=yes >/dev/null 2>"$log" & )
  # Wait for the master to fork, or for the log to explain why it won't. az's exit
  # status is no help even when we do wait for it: it exits 0 whether ssh connected or
  # aborted on ExitOnForwardFailure.
  #
  # The socket alone is not enough: ssh opens the mux listener BEFORE the box answers
  # the -R 2489 request, so when a stale session still holds 2489 the socket shows up
  # and then vanishes as ExitOnForwardFailure kills the master. Taking the socket as
  # success skipped the rc=2 reclaim and left the session to fail on a missing master.
  # ssh defers the -f fork until every forward is confirmed, and the fork re-parents
  # the master to launchd, so ppid 1 means the tunnels are up.
  local up=0 pid
  for i in $(seq 1 90); do
    grep -qE 'remote port forwarding failed for listen port|Could not request|Permission denied|^ERROR:' "$log" 2>/dev/null && break
    if [ -S "$sock" ]; then
      pid="$(ssh -O check -o ControlPath="$sock" devbox 2>&1 | sed -n 's/.*pid=\([0-9]*\).*/\1/p')"
      if [ -n "$pid" ] && [ "$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')" = 1 ]; then
        up=1
        break
      fi
    fi
    sleep 0.5
  done
  if [ "$up" -eq 1 ]; then
    rc=0
  elif grep -q 'remote port forwarding failed for listen port 2489' "$log" 2>/dev/null; then
    rc=2
  else
    rc=1
    printf '%s\n' "devbox: the connection didn't come up —" >&2
    grep -vE '^debug[0-9]|^OpenSSH_|^Transferred:|^Bytes per second:' "$log" 2>/dev/null | tail -5 >&2
  fi
  rm -f "$log"
  return "$rc"
}

# Reclaim the box's -R 2489 bind from a session that died without the box noticing, so
# devbox can retry. The remote half of the same IP-change damage: the old TCP connection
# is never torn down, so the box keeps the session and with it the port. sshd's own
# ClientAliveInterval (120s ×3) does not rescue it — sshd sits blocked writing to the
# vanished peer with data stuck in Send-Q and never reaches its keepalive timeout, so
# orphans outlive the 30m ControlPersist window indefinitely (one was seen at 43 minutes
# and counting).
#
# Safety rule: kill the holder unless it can be a live session of ours. Every devbox window
# on this Mac multiplexes over the one master, so a live session from here means a live
# local master process carrying the -R 2489 forward. No such process ⇒ the holder is an
# orphan whatever its peer IP — same-IP orphans are common, since a sleep/wake or a killed
# master without a network change leaves the public IP as it was. Only when a local master
# IS running and the holder's peer IP matches ours do we leave it alone. `sudo -n` is required because the
# forward's listening socket belongs to sshd, and `ss` hides the owning pid without it (the
# box has NOPASSWD sudo); lacking that we can see the port is taken but not by whom, which
# is not enough to kill anything. Returns 0 when the port is free to retry, 1 when it isn't.
_devbox_reclaim_fwd() {
  local out local_live=0
  printf '%s\n' "devbox: the box refused the -R 2489 bind — checking for a dead session…" >&2
  # The ssh that az spawns for a master carries the forward spec in its args; the [s]
  # keeps grep from matching itself.
  ps -Ao args 2>/dev/null | grep -qE '^([^ ]*/)?[s]sh .*-R 2489:127\.0\.0\.1:2489' && local_live=1
  out="$(az ssh vm -n vm-devbox-tim-vink -g rg-nwf-devbox-tim-vink --only-show-errors -- \
    -T -o BatchMode=yes -o ConnectTimeout=10 "local_live=$local_live"'
      port=2489
      me=${SSH_CLIENT%% *}
      holder=$(sudo -n ss -ltnpH "( sport = :$port )" 2>/dev/null | grep -o "pid=[0-9]*" | head -1 | cut -d= -f2)
      if [ -z "$holder" ]; then
        if ss -ltnH "( sport = :$port )" 2>/dev/null | grep -q .; then echo RECLAIM:opaque; else echo RECLAIM:free; fi
        exit
      fi
      peer=$(sudo -n ss -tnpH state established "( sport = :22 )" 2>/dev/null |
             grep "pid=$holder," | head -1 | awk "{print \$4}" | sed "s/:[0-9]*$//")
      if [ "$local_live" = 1 ] && [ -n "$peer" ] && [ "$peer" = "$me" ]; then echo RECLAIM:live; exit; fi
      kill "$holder" 2>/dev/null || sudo -n kill "$holder" 2>/dev/null
      i=0
      while [ "$i" -lt 10 ]; do
        ss -ltnH "( sport = :$port )" 2>/dev/null | grep -q . || { echo RECLAIM:killed; exit; }
        sleep 0.5; i=$((i+1))
      done
      echo RECLAIM:stuck' 2>/dev/null)"
  case "$out" in
    *RECLAIM:killed*)
      printf '%s\n' "devbox: cleared a stale session that still held port 2489 — reconnecting" >&2; return 0 ;;
    *RECLAIM:free*)
      printf '%s\n' "devbox: port 2489 is free again — reconnecting" >&2; return 0 ;;
    *RECLAIM:live*)
      printf '%s\n' "devbox: port 2489 is held by another live devbox session from this Mac — exit that one first (URL-opening rides a single tunnel)" >&2; return 1 ;;
    *RECLAIM:opaque*)
      printf '%s\n' "devbox: port 2489 is taken on the box but sudo -n can't say by whom — re-run devbox once it clears" >&2; return 1 ;;
    *RECLAIM:stuck*)
      printf '%s\n' "devbox: killed the session holding port 2489 but it hasn't released — re-run devbox in a moment" >&2; return 1 ;;
    *)
      printf '%s\n' "devbox: couldn't reach the box to check port 2489" >&2; return 1 ;;
  esac
}

# Keep the box's pty in step with this terminal's real size, for the life of the
# session. Resizing the Ghostty window is meant to travel down as a SIGWINCH —
# Ghostty resizes the local pty, ssh relays the signal to the master, the master
# re-reads the size off the session's tty and sshd resizes the pty over there. On
# the devbox's az-brokered multiplexed connection that chain sometimes drops the
# resize, leaving the box at the pre-resize width while Ghostty shows the new one:
# 134 columns against 269. tmux paints half a screen, the columns it never writes
# keep whatever was on them before, and nvim or Claude Code appears duplicated in a
# dead right-hand strip. The box cannot spot this on its own — tmux believes the
# kernel, the kernel believes sshd, and a size query sent through tmux's passthrough
# never gets its reply back. See ~/.local/bin/ssh-pty-resize.
#
# So push the size from this end: poll the local pty (a bare ioctl, no round trip)
# and on every change tell the box over the master socket already carrying the
# session. A one-second beat is far quicker than noticing a garbled screen yourself,
# and costs nothing while the window sits still. Args: ssh destination (REMOTE_DEST).
# Launch backgrounded with a trailing &.
_devbox_winch_bg() {
  local size last=""
  while :; do
    sleep 1
    # /dev/tty rather than stdin: this runs in the background, where stdin may have
    # been handed elsewhere. It failing means the terminal is gone, and so are we.
    size=$(stty size </dev/tty 2>/dev/null) || return 0
    [ "$size" = "$last" ] && continue
    # stty prints "rows cols" and ssh-pty-resize takes them the other way round.
    # -n so a background ssh can never eat keystrokes meant for the session.
    # Only a clean exit counts as pushed: 3 is "no login pty over there yet", which
    # the first pass often hits, since this starts alongside the session not after it.
    if ssh -n "$@" \
         "~/.local/bin/ssh-pty-resize ${size#* } ${size%% *}" >/dev/null 2>&1; then
      last=$size
    fi
  done
}

_remote_window devbox
_remote_window_warn_tmux devbox
# Runs however we leave: a normal exit, or the terminal closing (SIGHUP) or a kill,
# which turn into an exit below so this still runs.
trap '_devbox_session_end; _remote_window' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
_devbox_session; rc=$?
if [ "$rc" -eq 2 ] && _devbox_reclaim_fwd; then
  # The port really was stale, so nothing live is using the bridge: drop whatever the
  # dead session left behind locally, or _revmount would see a live-looking pidfile and
  # skip mounting ~/mac-downloads for the session we're about to open.
  _revumount_devbox
  _devbox_session; rc=$?
fi
exit "$rc"
