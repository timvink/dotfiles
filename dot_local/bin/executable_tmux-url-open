#!/bin/sh
# tmux-url-open — pop up a picker to open, copy or stop a local dev server or an
# on-screen URL. Bound from .tmux.conf to `prefix u`.
#
# Two sections, two key styles so they never collide and picking is fast:
#   Servers (1-9): every running `make serve` across ALL sessions, keyed off the
#     @server_port we track per window (see server-port-watch / the make
#     wrapper). Opens http://localhost:PORT. The server in the current tab is
#     marked →. This works workspace-wide, so a server in another session is one
#     keystroke away without switching to its tab.
#   URLs (a-z): every URL visible in the current pane — including bare domains
#     like dashboard.stripe.com/... that carry no http(s):// scheme (these are
#     normalised to https:// so the opener treats them as URLs, not files).
#
# Keys, all shown in the picker's header: enter opens the highlighted row, `y`
# copies it (system clipboard AND the tmux paste buffer, so it also works on a
# remote VM with no pbcopy/xclip), `q` drops into "kill mode" — the same list,
# servers only, where choosing one sends C-c to its pane (a graceful stop; the
# make wrapper's INT trap shuts the server down and clears the tab's port chip).
# The a-z / 1-9 shortcuts still jump straight to a row and open it, so the common
# case stays a single keystroke.
#
# The picker is fzf inside `display-popup`, NOT tmux's own `display-menu`: a menu
# maps each key to one row's command and never exposes which row is highlighted,
# so "highlight a row, press y" is impossible there. fzf gives us a second verb
# per row (--expect reports the key alongside the selection) while keeping the
# one-key jumps (each letter is bound to pos(N)+accept). Typing is disabled
# (--no-input) so the letters stay shortcuts instead of a search query.
#
# Replaces Ghostty's cmd-click URL-open, which tmux's `set -g mouse on` swallows
# before Ghostty sees it. Cross-platform (Darwin / Linux).

set -eu

# "open" (default) builds the open list; "kill" builds the servers-only kill
# list; "pick" is us re-invoked INSIDE the popup to run fzf and act on the
# choice. The split matters: capture-pane must run in the user's pane, before
# the popup exists, so the rows are built out here and handed over in a file.
mode="${1:-open}"
case "$0" in
    /*) self=$0 ;;
    *)  self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") ;;
esac

case "$(uname)" in
    Darwin)
        opener=open
        clip=pbcopy
        ;;
    *)
        opener=xdg-open
        if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
            clip=wl-copy
        elif command -v xclip >/dev/null 2>&1; then
            clip='xclip -selection clipboard'
        elif command -v xsel >/dev/null 2>&1; then
            clip='xsel --clipboard --input'
        else
            clip=''   # tmux's own paste buffer still gets it
        fi
        ;;
esac

# fzf draws the picker (see the note above on why display-menu cannot). It is in
# the darwin package list; on a bare remote VM it may not be, so say so plainly
# instead of having `prefix u` do nothing.
if ! command -v fzf >/dev/null 2>&1; then
    tmux display-message "tmux-url-open: fzf is not installed"
    exit 0
fi

TAB=$(printf '\t')
ESC=$(printf '\033')
DIM="$ESC[38;5;245m"
OFF="$ESC[0m"

# Escape single quotes so a value is safe inside a single-quoted shell word.
shquote() { printf '%s' "$1" | sed "s/'/'\\\\''/g"; }

# Escape a string for tmux's format engine: a literal '#' (a URL fragment, or a
# '#' in a window name) is otherwise read as the start of '#[style]', '#{format}'
# or even '#(run-shell)'. Doubling '#'→'##' makes tmux render a single literal
# '#'. Needed for display-message and the popup title; fzf rows are plain text.
tmuxfmt() { printf '%s' "$1" | sed 's/#/##/g'; }

# ---- the popup half ---------------------------------------------------------
# Runs inside display-popup with the rows already computed. fzf prints two lines:
# the --expect key (empty when the row was taken with enter or a jump shortcut)
# and the chosen row, as KIND \t PAYLOAD \t DISPLAY.
if [ "$mode" = pick ]; then
    rowsfile=$2
    submode=${3:-open}
    hdr=$4
    binds=$5
    startpos=$6

    if [ "$submode" = open ]; then
        expect=y,q                     # q hands off to kill mode
    else
        expect=y
        binds="${binds:+$binds,}q:abort"
    fi

    out=$(fzf --no-input --info=hidden --layout=reverse --no-scrollbar --ansi \
              --delimiter="$TAB" --with-nth='3..' \
              --header="$hdr" \
              --pointer='▌' --marker=' ' \
              --color='bg+:#45475a,fg+:-1,hl:-1,hl+:-1,header:#6c7086,pointer:#cba6f7,gutter:-1,border:#585b70' \
              --expect="$expect" \
              --bind="load:pos($startpos)${binds:+,$binds}" \
              < "$rowsfile") || out=""
    rm -f "$rowsfile"

    key=$(printf '%s\n' "$out" | sed -n 1p)
    sel=$(printf '%s\n' "$out" | sed -n 2p)
    [ -n "$sel" ] || exit 0

    kind=${sel%%"$TAB"*}
    rest=${sel#*"$TAB"}
    payload=${rest%%"$TAB"*}
    [ "$kind" = hdr ] && exit 0          # a section label; nothing to do

    case "$key" in
        y)
            # Both sinks: the system clipboard for other apps, and tmux's paste
            # buffer so prefix-] works even where no clipboard tool exists.
            tmux set-buffer -- "$payload"
            if [ -n "$clip" ]; then printf '%s' "$payload" | sh -c "$clip"; fi
            tmux display-message "copied: $(tmuxfmt "$payload")"
            ;;
        q)
            tmux run-shell -b "'$(shquote "$self")' kill"
            ;;
        *)
            if [ "$kind" = kil ]; then
                tmux send-keys -t "$payload" C-c
            else
                # Hand the open to the tmux SERVER, not this shell: we are the
                # popup's process, and tmux tears the popup down the moment fzf
                # returns, SIGHUPing our process group before a backgrounded
                # `open`/`xdg-open` has launched anything. run-shell -b runs it
                # outside the popup, so it survives (same reason `q` uses it).
                # tmuxfmt too: run-shell expands formats, so a bare '#(' in a
                # URL fragment would otherwise run as a command substitution.
                tmux run-shell -b "$opener '$(tmuxfmt "$(shquote "$payload")")'"
            fi
            ;;
    esac
    exit 0
fi

# ---- servers across the whole workspace -------------------------------------
# -a spans every session; keep only windows whose tab is flagged running with a
# detected port. Fields: PORT \t session:index \t name.
cur=$(tmux display-message -p '#{session_name}:#{window_index}')   # this tab
servers=$(
    tmux list-windows -a -F "#{@server_port}${TAB}#{@server_state}${TAB}#{session_name}:#{window_index}${TAB}#{window_name}" \
        | awk -F"$TAB" '$2=="running" && $1!="" { print $1 FS $3 FS $4 }'
)

# Fit a URL into $2 columns. A plain end-cut hides the part that actually tells
# two long URLs apart (same host + path, differing only in a tail beyond the
# cut), so instead keep the scheme://host/ prefix and as much of the tail as
# fits, joined by a middle ellipsis: https://dev.azure.com/…/nwf-foo.git
ellipsize_url() {
    url=$1; max=$2
    [ "${#url}" -le "$max" ] && { printf '%s' "$url"; return; }
    # prefix = everything through the first slash after the authority. If the
    # URL has no path slash, this matches nothing and we fall back to end-cut.
    prefix=$(printf '%s' "$url" | sed -nE 's#^([a-z][a-z0-9+.-]*://[^/]*/).*#\1#p')
    # tail budget = max minus the prefix and the 1-column ellipsis. If the
    # prefix alone won't fit (or there was none), just hard end-cut.
    tail_len=$((max - ${#prefix} - 1))
    if [ -z "$prefix" ] || [ "$tail_len" -lt 1 ]; then
        printf '%s' "$url" | cut -c1-"$max"
        return
    fi
    tail=$(printf '%s' "$url" | awk -v n="$tail_len" '{ print substr($0, length($0)-n+1) }')
    printf '%s…%s' "$prefix" "$tail"
}

# ---- URLs in the current pane -----------------------------------------------
# Lines come from capture-pane -J, which rejoins what the TERMINAL wrapped at the
# pane edge. It does nothing for a line the APPLICATION broke itself: Claude Code
# word-wraps its own output at a width of its choosing and re-indents the
# continuation to that block's gutter, so a URL longer than that width lands as
# two hard lines and used to be picked up truncated at the break (an OAuth link
# losing its &state= tail, for instance). So we re-join those ourselves first,
# only when all three hold:
#   * the previous physical line ran to its block's wrap column — the widest line
#     sharing its indent, ignoring the over-wide ones -J already joined. A line
#     that merely ENDS with a URL stops short of that column, because the next
#     word is what did not fit;
#   * that line ends inside a URL, with no space between the URL and the break;
#   * the next line, minus its gutter, opens with a long run (>= 12) of URL
#     characters — wrapped prose resumes with a short word and then a space.
# Together those separate ".../docs" + "for the details" (leave alone) from a
# genuinely split token (join). Joining repeats, so a URL may span three lines.
#
# Then two kinds of URL are matched (one alternation, leftmost-longest so a
# scheme URL always wins over its bare tail at the same spot):
#   1. scheme URLs: https?://…
#   2. bare domains: host.tld[/path] with no scheme, e.g. dashboard.stripe.com/x.
#      Bare matching is gated on a curated TLD list (see $tld) so it fires on
#      real domains but NOT on filenames (README.md, main.rs, app.py), version
#      strings (v1.2.3) or prose — their trailing token isn't a listed TLD. The
#      \b after the TLD stops dashboard.community truncating to dashboard.com.
#      A negative lookbehind also rejects a bare domain glued to a preceding
#      email-local-part char ([A-Za-z0-9@_.-]), so vinktim@gmail.com (my own
#      address, shown on the status line) no longer surfaces gmail.com. Scheme
#      URLs match independently, so https://user@host.com keeps its userinfo.
#      The lookbehind needs PCRE, hence perl rather than POSIX `grep -oE`.
# Then: strip trailing punctuation (.,;:) and an unbalanced ) common in
# logs/markdown; normalise bare domains to https:// (so `open`/xdg-open treats
# them as URLs, not local files); dedupe keeping the first occurrence, then emit
# in reverse (last-discovered first) so the most recent on-screen URL sits at the
# top of the menu with hotkey `a`. The a..z key cap
# (26) is applied in the loop below, AFTER server URLs are filtered out — capping
# here would let localhost servers eat slots and silently drop on-screen URLs.
# Only the open menu lists on-screen URLs; kill mode is servers-only.
#
# $tld leaves out real TLDs that collide with common code-file extensions
# (md/rs/sh/…) to avoid false hits; add any you actually use as web addresses.
tld='com|org|net|edu|gov|mil|int|info|biz|io|dev|app|ai|co|xyz|online|site|tech|cloud|nl|be|de|fr|uk|eu|us|ca|au|es|it|se|no|dk|fi|pl|ch|at|ie'
if [ "$mode" = open ]; then
    urls=$(
        tmux capture-pane -J -p \
            | TLD="$tld" COLS="$(tmux display-message -p '#{pane_width}')" perl -e '
                my $c = qr/[A-Za-z0-9._~:\/?#\@!\$&()*+,;=%-]/;
                my @lines = <STDIN>; chomp @lines; s/\s+$// for @lines;
                my $cols = $ENV{COLS} || 200;

                # Wrap column per indent level: the widest line at that gutter
                # that the terminal did NOT wrap (anything wider than the pane is
                # a line -J already stitched together, so it proves nothing).
                my %wrap;
                for my $l (@lines) {
                    next if length($l) > $cols;
                    my ($ind) = $l =~ /^(\s*)/;
                    my $n = length($ind);
                    $wrap{$n} = length($l) if length($l) > ($wrap{$n} // 0);
                }

                my @merged; my $i = 0;
                while ($i <= $#lines) {
                    my $buf = $lines[$i]; my $prev = $lines[$i];
                    while ($i < $#lines) {
                        my ($ind) = $prev =~ /^(\s*)/;
                        my $w = $wrap{length($ind)} // 0;
                        last unless length($prev) && length($prev) >= $w - 2;
                        last unless $buf =~ m{https?://$c*$};
                        (my $cont = $lines[$i+1]) =~ s/^\s+//;
                        my ($run) = $cont =~ /^($c+)/;
                        last unless defined($run) && length($run) >= 12;
                        $buf .= $cont; $i++; $prev = $lines[$i];
                    }
                    push @merged, $buf; $i++;
                }

                for my $l (@merged) {
                    while ($l =~ /(https?:\/\/$c+)|(?<![A-Za-z0-9\@_.\-])((?:[A-Za-z0-9-]+\.)+(?:$ENV{TLD})\b(?::[0-9]+)?(?:\/$c*)?)/g) {
                        print defined($1) ? "$1\n" : "$2\n";
                    }
                }
            ' \
            | sed -E 's/[.,;:)]+$//' \
            | sed -E '\#^https?://#!s#^#https://#' \
            | awk '!seen[$0]++ { a[++n]=$0 } END { for (i = n; i >= 1; i--) print a[i] }'
    )
else
    urls=""
fi

# Build the row list, one line per row as KIND \t PAYLOAD \t KEY \t TEXT:
#   hdr  a dim section label, selectable but a no-op (fzf has no inert rows)
#   url  open PAYLOAD in the browser
#   kil  send C-c to the window named by PAYLOAD
# KEY is the jump shortcut; the perl pass below turns KEY + TEXT into the padded
# display column and reports how wide the widest row came out.
rawrows=""
addrow() { rawrows="$rawrows$1$TAB$2$TAB$3$TAB$4
"; }

srv_urls=""   # localhost URLs we've shown as servers, to dedupe the URL list
n=0
startpos=1    # first pickable row, so the cursor never opens on a section label

if [ -n "$servers" ]; then
    if [ "$mode" = kill ]; then
        addrow hdr "" "" "${DIM}kill a server · sends C-c to its pane${OFF}"
    else
        addrow hdr "" "" "${DIM}servers · all sessions${OFF}"
    fi
    [ "$startpos" = 1 ] && startpos=2
    while IFS="$TAB" read -r ports_field loc name; do
        [ -n "$ports_field" ] || continue
        here=""
        [ "$loc" = "$cur" ] && here=" ←"
        # @server_port may hold several space-separated ports (a compose stack);
        # list each as its own pickable entry.
        for port in $ports_field; do
            n=$((n + 1))
            if [ "$n" -le 9 ]; then key="$n"; else key=""; fi
            text=$(printf ':%-5s %s  %s%s' "$port" "$name" "$loc" "$here")
            if [ "$mode" = kill ]; then
                # @server_state/@server_port are window-scoped, so we only know
                # the window — target it and its active pane gets the C-c (the
                # serve pane, normally). The make wrapper traps INT, so this is
                # the same graceful stop as hitting Ctrl-C in that tab.
                addrow kil "$loc" "$key" "$text"
            else
                srv_urls="$srv_urls http://localhost:$port$TAB"
                addrow url "http://localhost:$port" "$key" "$text"
            fi
        done
    done <<EOF
$servers
EOF
fi

if [ -n "$urls" ]; then
    i=0
    header_done=
    while IFS= read -r url; do
        [ -n "$url" ] || continue
        # Skip an on-screen URL that's already listed as a server.
        case "$srv_urls" in *" $url$TAB"*) continue ;; esac
        # Only a..z keys available; stop once they're spent (after server-dedup,
        # so real URLs aren't crowded out by localhost servers — see capture above).
        [ "$i" -ge 26 ] && break
        if [ -z "$header_done" ]; then
            [ -n "$rawrows" ] && addrow hdr "" "" ""      # rule between sections
            addrow hdr "" "" "${DIM}urls · this pane${OFF}"
            header_done=1
        fi
        hotkey=$(awk -v c=$((97 + i)) 'BEGIN { printf "%c", c }')   # a, b, c, …
        i=$((i + 1))
        addrow url "$url" "$hotkey" "$(ellipsize_url "$url" 90)"
        [ "$startpos" = 1 ] && startpos=$(printf '%s' "$rawrows" | grep -c '')
    done <<EOF
$urls
EOF
fi

if [ -z "$rawrows" ]; then
    if [ "$mode" = kill ]; then
        tmux display-message "tmux-url-open: no servers running"
    else
        tmux display-message "tmux-url-open: no servers or URLs found"
    fi
    exit 0
fi

# Pad every pickable row to a common width and hang its shortcut off the right,
# the way display-menu used to render "(a)". Done in perl because the labels
# carry an ellipsis and ANSI dim codes, which byte-wise padding gets wrong.
# Prints the resulting row width so the popup can be sized to fit.
rowsfile=$(mktemp "${TMPDIR:-/tmp}/tmux-url-open.XXXXXX")
rowwidth=$(printf '%s' "$rawrows" | ROWSFILE="$rowsfile" perl -CSD -e '
    my @r;
    while (<STDIN>) {
        chomp;
        next unless length;
        my @f = split /\t/, $_, 4;
        push @r, [ @f[0..3] ];
    }
    my $m = 0;
    for my $f (@r) {
        (my $p = $f->[3] // "") =~ s/\e\[[0-9;]*m//g;
        $m = length($p) if length($p) > $m;
    }
    open my $fh, ">", $ENV{ROWSFILE} or die $!;
    for my $f (@r) {
        my ($kind, $pay, $key, $text) = @$f;
        $_ //= "" for ($pay, $key, $text);
        (my $plain = $text) =~ s/\e\[[0-9;]*m//g;
        my $disp = $text;
        $disp .= " " x ($m - length($plain)) . ($key ne "" ? "  ($key)" : "") if $kind ne "hdr";
        print $fh join("\t", $kind, $pay, $disp), "\n";
    }
    close $fh;
    print $m + 5;
')

# Header: the grey line above the list spelling out both verbs (plus kill mode
# when there is a server to kill), so the shortcuts are discoverable in place.
if [ "$mode" = kill ]; then
    hdr='enter stop · y copy'
elif [ -n "$servers" ]; then
    hdr='enter open · y copy · q kill server'
else
    hdr='enter open · y copy'
fi

# One --bind per shortcut: jump to that row and take it. pos() counts from the
# top because of --layout=reverse.
binds=$(printf '%s' "$rawrows" | awk -F"$TAB" '
    $3 != "" { printf "%s%s:pos(%d)+accept", (k++ ? "," : ""), $3, NR }
')

nrows=$(grep -c '' "$rowsfile")
read -r cw ch <<EOF
$(tmux display-message -p '#{client_width} #{client_height}')
EOF
pw=$((rowwidth + 4))
[ "$pw" -lt $((${#hdr} + 4)) ] && pw=$((${#hdr} + 4))
[ "$pw" -gt $((cw - 2)) ] && pw=$((cw - 2))
ph=$((nrows + 3))
[ "$ph" -gt $((ch - 2)) ] && ph=$((ch - 2))

[ "$mode" = kill ] && title=' kill ' || title=' open '
tmux display-popup -E -b rounded -S 'fg=#585b70' -T "$title" -w "$pw" -h "$ph" \
    "'$(shquote "$self")' pick '$(shquote "$rowsfile")' '$mode' '$(shquote "$hdr")' '$(shquote "$binds")' '$startpos'"
