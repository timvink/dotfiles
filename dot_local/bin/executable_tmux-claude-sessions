#!/usr/bin/env bash
# tmux-claude-sessions — remember which Claude Code conversation runs in which
# tmux pane, and reopen them after tmux-resurrect restores the layout.
#
#   tmux-claude-sessions save      # resurrect @resurrect-hook-post-save-all
#   tmux-claude-sessions restore   # resurrect @resurrect-hook-post-restore-all
#
# Source of truth: every running interactive Claude Code writes
# ~/.claude/sessions/<pid>.json with its current sessionId (kept up to date
# across /clear and /resume), its cwd, and "tmux": "<session>:@<window>.%<pane>".
# That file format is Claude Code's own and undocumented; if it changes, save
# simply finds nothing and restore reopens nothing.
#
# Saved per pane as "<session>:<window_index>.<pane_index> TAB <cwd> TAB <id>",
# because pane ids (%N) do not survive a server restart but resurrect recreates
# the same session/window/pane indexes.
set -euo pipefail

state_dir="$HOME/.tmux/resurrect"
state_file="$state_dir/claude-sessions.tsv"

save() {
    mkdir -p "$state_dir"
    local tmp f pid pane target id cwd
    tmp=$(mktemp "$state_dir/.claude-sessions.XXXXXX")
    for f in "$HOME"/.claude/sessions/*.json; do
        [ -e "$f" ] || continue
        IFS=$'\t' read -r pid pane id cwd < <(jq -r \
            'select(.kind == "interactive" and (.tmux // "") != "")
             | [.pid, (.tmux | sub("^.*\\."; "")), .sessionId, .cwd] | @tsv' "$f") || continue
        # Stale files outlive crashed processes; only live ones count.
        kill -0 "$pid" 2>/dev/null || continue
        target=$(tmux display-message -p -t "$pane" '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null) || continue
        printf '%s\t%s\t%s\n' "$target" "$cwd" "$id" >> "$tmp"
    done
    mv "$tmp" "$state_file"
}

restore() {
    [ -s "$state_file" ] || return 0
    local target cwd id cmd
    while IFS=$'\t' read -r target cwd id; do
        cmd=$(tmux display-message -p -t "$target" '#{pane_current_command}' 2>/dev/null) || continue
        # Only type into a bare shell: a manual prefix+Ctrl-r while Claude is
        # already running there must not inject a command into the conversation.
        case "$cmd" in bash|zsh|fish|sh|-bash|-zsh) ;; *) continue ;; esac
        tmux send-keys -t "$target" "cd $(printf '%q' "$cwd") && claude --resume $id" Enter
    done < "$state_file"
}

case "${1:-}" in
    save) save ;;
    restore) restore ;;
    *) echo "usage: ${0##*/} save|restore" >&2; exit 2 ;;
esac
