#!/bin/sh
# spotify-volume up|down — volume keys follow Spotify while it plays.
#
# Bound to the volume keys in Karabiner. When Spotify is playing, it adjusts
# Spotify's own volume, which also drives a Spotify Connect device such as the
# Sonos office speaker (macOS's output volume doesn't reach that). Otherwise it
# changes the system output volume by one HUD step (1/16) — without the volume
# HUD, since posting a real media key from here needs Accessibility access.
#
# Latency is mostly osascript startup plus Apple Events to Spotify, so it runs
# one osascript per press and checks `application "Spotify" is running`, which
# needs no Apple Event (unlike System Events) and doesn't launch Spotify.
# Hammerspoon would be faster still (no per-press process).
#
# Spotify's `sound volume` reads back one lower than what was set, so the
# step is compensated: setting v+6 reads v+5 and v-4 reads v-5.

step=5
case "$1" in
  up) spotify_delta=$((step + 1)) system_delta=6.25 ;;
  down) spotify_delta=$((1 - step)) system_delta=-6.25 ;;
  *) echo "usage: spotify-volume up|down" >&2; exit 2 ;;
esac

exec osascript - "$spotify_delta" "$system_delta" <<'EOF'
on clamp(v)
	if v < 0 then return 0
	if v > 100 then return 100
	return v
end clamp

on run {spotifyDelta, systemDelta}
	if application "Spotify" is running then
		tell application "Spotify"
			if player state is playing then
				set sound volume to my clamp((sound volume) + (spotifyDelta as integer))
				return
			end if
		end tell
	end if
	set volume output volume (round my clamp((output volume of (get volume settings)) + (systemDelta as real)))
end run
EOF
