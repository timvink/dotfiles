#!/bin/sh
# spotify-volume up|down — volume keys follow Spotify while it plays.
#
# Karabiner calls this for the volume keys only while its spotify_playing
# variable is 1 (set by spotify-watch); otherwise the keys stay native. It
# adjusts Spotify's own volume, which also drives a Spotify Connect device such
# as the Sonos office speaker (macOS's output volume doesn't reach that). If
# Spotify isn't playing after all (stale variable), it falls back to the system
# output volume by one HUD step (1/16), without the HUD.
#
# Latency is mostly osascript startup plus Apple Events to Spotify, so it runs
# one osascript per press and checks `application "Spotify" is running`, which
# needs no Apple Event (unlike System Events) and doesn't launch Spotify.
# Hammerspoon would be faster still (no per-press process).
#
# Spotify's `sound volume` reads back one lower than what was set, so the
# step is compensated: setting v+6 reads v+5 and v-4 reads v-5.
#
# The system step goes in as hundredths of a percent (625 = 6.25): AppleScript
# parses "6.25" with the user's locale, which fails under a decimal comma (nl).

step=5
case "$1" in
  up) spotify_delta=$((step + 1)) system_delta=625 ;;
  down) spotify_delta=$((1 - step)) system_delta=-625 ;;
  *) echo "usage: spotify-volume up|down" >&2; exit 2 ;;
esac

exec osascript - "$spotify_delta" "$system_delta" <<'EOF'
on clamp(v)
	if v < 0 then return 0
	if v > 100 then return 100
	return v
end clamp

on run {spotifyDelta, systemDelta}
	if application "Spotify" is running then
		tell application "Spotify"
			if player state is playing then
				set sound volume to my clamp((sound volume) + (spotifyDelta as integer))
				return
			end if
		end tell
	end if
	set volume output volume (round my clamp((output volume of (get volume settings)) + (systemDelta as integer) / 100))
end run
EOF
