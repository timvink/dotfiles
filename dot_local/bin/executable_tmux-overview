#!/usr/bin/env python3
"""tmux-overview — a live full-screen view of every tmux tab, in two layouts.

Bound to prefix+o. Space switches between them and the choice is remembered:

  TREE (default) — one row per tab under a foldable session header, carrying the
    agent dot, the window name, its git branch (peach "⑂ branch" when the tab
    sits in a linked worktree — the tree keeps the branch and only recolours it,
    where the status bar drops it for the worktree's own name), a sapphire
    "+3" for any subagents that tab has in flight, and, on the right, a detail
    pane for whatever the cursor is on: full note, worktree path, how long it has
    been in this state, and a live snapshot of that one pane. Tab hides the
    detail pane, which widens the tree and gives every row a note column instead.

  GRID — the original montage: one band per session, a column per window, each
    a colour-preserving snapshot of that window's screen with a state-coloured
    label box floating over it. Tab hides the snapshots here too.

Both views share the same keys:

  hjkl/arrows  move. In the tree, l unfolds a session or descends into it and h
               ascends to the session header, then folds it — so two presses
               collapse a session and h,h,h,h collapses the machine.
  ↵            open the selected tab (a session header switches to that session)
  1-9 then a-z jump straight to a tab, skipping the h/j/k/l/q keys. Assigned over
               *visible* tabs, so folding renumbers and shortens the reach.
  click        same, with the mouse
  space        switch tree ⇄ grid
  tab          hide/show the detail pane (tree) or the snapshots (grid)
  /            agents only — hide plain shells, editors and other tabs that never
               ran an agent. Sessions left with nothing are hidden too.
  q / Esc      close

  red ● blocked   blue ● working   yellow ● done   yellow ○ seen   green ■ server

State lives in tmux options, not a dotfile of ours: @overview_view, @overview_detail,
@overview_panes and @overview_agents on the server, and @overview_fold per session
for what's folded. The per-window inputs are @agent_state / @agent_note (see the
agent-state and agent-note scripts), @agent_since, the epoch second the state last
changed, which is what "2m14s" counts from, and @agent_subagents (agent-subagents),
how many subagents that tab has in flight.

Both views open with the cursor on the tab you pressed prefix+o in, so the
first thing under it is where you came from and ↵ is the way back.

Redraws in place each tick (~1s) without clearing, so it stays current with
minimal flicker. Opened with -E so the script exiting closes the popup.
"""

import collections
import os
import re
import select
import shutil
import subprocess
import sys
import textwrap
import time
import unicodedata

ESC = "\033"
RESET = f"{ESC}[0m"
BOLD = f"{ESC}[1m"

# Catppuccin Mocha
MAUVE = (203, 166, 247)
BLUE = (137, 180, 250)
RED = (243, 139, 168)
YELLOW = (249, 226, 175)
GREEN = (166, 227, 161)
PEACH = (250, 179, 135)   # worktree marker, and the selection highlight
SAPPHIRE = (116, 199, 236)  # subagent count, a shade off the blue it hangs from
DIM = (108, 112, 134)
SEP = (88, 91, 112)
INK = (30, 30, 46)
SNOW = (235, 235, 245)
SUB = (166, 173, 200)

# done and idle are the same yellow on purpose: same fact about the agent, and
# only the glyph says whether you have seen it yet (filled ● vs hollow ○).
STATE = {"running": BLUE, "needs-input": RED, "done": YELLOW, "idle": YELLOW}
STATE_WORD = {"running": "working", "needs-input": "blocked",
              "done": "done · not seen yet", "idle": "done · seen"}
OTHER = DIM
INTERVAL = 1.0
NOTE_LINES = 2          # most an @agent_note wraps to in the grid's label boxes
GIT_TTL = 5.0           # seconds a branch lookup is reused for; branches barely move

# Server options remembering how the popup was left, and the per-session fold flag.
VIEW_OPT = "@overview_view"        # "tree" (default) | "grid"
DETAIL_OPT = "@overview_detail"    # "off" hides the tree's detail pane
PANES_OPT = "@overview_panes"      # "off" hides the grid's pane snapshots
AGENTS_OPT = "@overview_agents"    # "on" hides tabs that never ran an agent
FOLD_OPT = "@overview_fold"        # per session: "1" while folded

# Direct-jump hotkeys: 1-9 then letters, SKIPPING the hjkl nav keys and the q
# quit key so a jump can never be read as a move or a quit. Every other bound
# key (space, tab, /) is non-alphanumeric for the same reason.
_RESERVED = set("hjklq")
HOTKEYS = [str(d) for d in range(1, 10)] + [c for c in "abcdefghijklmnopqrstuvwxyz" if c not in _RESERVED]

CSI = re.compile(r"\033\[[0-9;:?]*[ -/]*[@-~]")

# One tab. `cap` is filled only for the windows a view actually shows a snapshot
# of — every window in the grid, just the selected one in the tree. `subs` is the
# raw @agent_subagents string, which is empty for most tabs; read it through
# sub_count.
Win = collections.namedtuple("Win", "idx name state note server port path since subs cap")


def fg(rgb):
    return f"{ESC}[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


def bg(rgb):
    return f"{ESC}[48;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


def char_width(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def vis_width(s):
    return sum(char_width(c) for c in s)


def strip_ansi(s):
    return CSI.sub("", s)


def crop_plain(s, width):
    out, w = [], 0
    for ch in s:
        cw = char_width(ch)
        if w + cw > width:
            break
        out.append(ch)
        w += cw
    return "".join(out)


def fit(s, width):
    """Crop to `width` display cells, then pad back out to exactly that many."""
    s = crop_plain(s, width)
    return s + " " * max(0, width - vis_width(s))


def pad_ansi(line, width):
    """Pad a coloured line out to `width` cells, measuring past its SGR codes.

    Every row has to write its full width even when its text is short: frames are
    redrawn in place without clearing, so anything left unwritten is still last
    tick's text."""
    return line + RESET + " " * max(0, width - vis_width(strip_ansi(line)))


def cell_ansi(s, width):
    """Crop to `width` visible cols keeping SGR escapes, then pad to width."""
    out, w, i, n = [], 0, 0, len(s)
    while i < n:
        if s[i] == ESC:
            m = CSI.match(s, i)
            if m:
                out.append(m.group())
                i = m.end()
                continue
            i += 1
            continue
        if s[i] in ("\t", "\r", "\n"):
            i += 1
            continue
        cw = char_width(s[i])
        if w + cw > width:
            break
        out.append(s[i])
        w += cw
        i += 1
    out.append(RESET)
    out.append(" " * (width - w))
    return "".join(out)


def at(r, c):
    return f"{ESC}[{r};{c}H"


def tmux(*args):
    return subprocess.run(
        ["tmux", *args], capture_output=True, text=True, encoding="utf-8", errors="replace"
    ).stdout


def opt(name, default=""):
    """A server option's value, or `default` when it has never been set."""
    return tmux("show-options", "-sv", name).strip() or default


def set_opt(name, value):
    tmux("set-option", "-s", name, value)


def here():
    """(session, window index) of the tab this popup was opened from, or None.

    Ask with an explicit -t or don't ask at all: a popup runs with no TMUX_PANE,
    and a bare display-message with nothing to resolve against falls back to the
    server's most recently active session — which is only sometimes the one you
    pressed the key in. What a popup does inherit is TMUX, whose third field is
    the id of the session it was displayed for, and a session has exactly one
    current window: the tab the key was pressed in. Run straight from a pane
    instead (no popup) and TMUX_PANE is there and says it more precisely."""
    target = os.environ.get("TMUX_PANE", "")
    if not target:
        field = os.environ.get("TMUX", "").split(",")
        if len(field) < 3 or not field[2].strip():
            return None
        target = "$" + field[2].strip()
    s, _, idx = tmux(
        "display-message", "-p", "-t", target, "#{session_name}\t#{window_index}"
    ).strip().partition("\t")
    return (s, idx) if s and idx else None


def wrap_note(note, width, maxlines):
    """Word-wrap a note into at most `maxlines` lines of `width` display columns,
    marking a truncated tail with an ellipsis.

    textwrap counts characters where the rest of this file counts display cells,
    so each line goes through crop_plain as well: a wide glyph can then only make
    a line narrower than asked for, never overflow the cell it sits in."""
    if width < 1 or maxlines < 1 or not note:
        return []
    lines = textwrap.wrap(note, width=width, max_lines=maxlines, placeholder="…")
    return [crop_plain(ln, width) for ln in lines]


def fmt_age(since):
    """"2m14s" since the epoch second in `since`; empty when it isn't a number.

    @agent_since is stamped by agent-state only when the state actually changes,
    so this measures time in the *current* state rather than session age."""
    try:
        secs = int(time.time()) - int(since)
    except (TypeError, ValueError):
        return ""
    if secs < 0:
        return ""
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m{secs % 60:02d}s"
    if secs < 86400:
        return f"{secs // 3600}h{(secs % 3600) // 60:02d}m"
    return f"{secs // 86400}d"


_git_cache = {}


def git_info(path):
    """(branch, worktree_name) for `path`; ("", "") outside a repo, and the name
    empty unless this is a *linked* worktree.

    Same test as the status bar's tmux-git-branch: in the primary checkout
    --git-dir equals --git-common-dir, while a linked worktree's --git-dir points
    under <common>/worktrees/<name>. --path-format=absolute makes the two
    comparable whatever the depth (git ≥ 2.31).

    Cached per path for GIT_TTL, because this runs for every window on every tick
    and a branch changes far more slowly than that. GIT_OPTIONAL_LOCKS=0 keeps an
    agent mid-commit from blocking the lookup."""
    now = time.time()
    hit = _git_cache.get(path)
    if hit and now - hit[0] < GIT_TTL:
        return hit[1]

    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0")

    def git(*args):
        try:
            r = subprocess.run(["git", "-C", path, *args], capture_output=True,
                               text=True, encoding="utf-8", errors="replace", env=env)
        except OSError:
            return ""
        return r.stdout if r.returncode == 0 else ""

    branch = git("symbolic-ref", "--short", "HEAD").strip()
    if not branch:
        branch = git("rev-parse", "--short", "HEAD").strip()
    wt = ""
    if branch:
        parts = git("rev-parse", "--path-format=absolute",
                    "--git-dir", "--git-common-dir", "--show-toplevel").split("\n")
        if len(parts) >= 3 and parts[0].strip() and parts[0].strip() != parts[1].strip():
            wt = os.path.basename(parts[2].strip())
    info = (branch, wt)
    _git_cache[path] = (now, info)
    return info


def capture_pane(session, idx):
    """A window's screen, colours kept, trailing blank lines trimmed."""
    cap = tmux("capture-pane", "-e", "-p", "-t", f"{session}:{idx}").split("\n")
    while cap and not strip_ansi(cap[-1]).strip():
        cap.pop()
    return cap


def is_agent(w):
    """Has this tab ever been an agent or a server? Plain shells and editors set
    neither option, which is what the / filter hides."""
    return bool(w.state or w.server)


def gather(capture_all=False):
    """Every session and its windows.

    Pane snapshots are taken only when the grid asks for them: that is one
    shell-out per window per tick and most of what this popup costs. The tree
    captures the single pane its detail column is about to show, by itself."""
    listing = tmux("list-sessions", "-F", "#{session_name}\t#{@overview_fold}")
    sessions, folded = [], {}
    for line in listing.split("\n"):
        if not line:
            continue
        name, fold = (line.split("\t", 1) + [""])[:2]
        sessions.append(name)
        folded[name] = fold.strip() == "1"

    wins = {}
    for s in sessions:
        rec = []
        listing = tmux(
            "list-windows", "-t", s, "-F",
            "#{window_index}\t#{window_name}\t#{@agent_state}\t#{@server_state}\t"
            "#{@server_port}\t#{@agent_since}\t#{@agent_subagents}\t#{@agent_note}\t"
            "#{pane_current_path}",
        )
        for line in listing.split("\n"):
            if not line:
                continue
            # Fields are tab-separated and the path goes last, absorbing the final
            # split — because it is the only one that can legitimately contain a
            # tab (a directory may; tmux rejects a window name that does, and
            # agent-note strips them from a note). A tab in a path then lands
            # inside the path instead of shifting every field after it.
            idx, name, state, server, port, since, subs, note, path = (
                line.split("\t", 8) + [""] * 8)[:9]
            cap = capture_pane(s, idx) if capture_all else []
            rec.append(Win(idx, name, state, note, server, port, path, since, subs, cap))
        wins[s] = rec
    return sessions, wins, folded


# ---------------------------------------------------------------- shared bits

def state_rgb(w):
    if w.server == "running":
        return GREEN
    return STATE.get(w.state, OTHER)


def dot(w):
    """The tab's glyph: ■ for a server, ● / ○ for an agent, · for everything else
    — the same alphabet the tmux status bar draws per tab."""
    if w.server == "running":
        return "■"
    if w.state == "idle":
        return "○"
    if w.state in STATE:
        return "●"
    return "·"


def doing(w):
    """What this tab is doing, in its own words: the agent's note, or the port a
    foreground server is on. One column, one meaning."""
    if w.note:
        return w.note
    if w.server == "running" and w.port:
        return f"serving :{w.port}"
    return ""


def sub_count(w):
    """Subagents this tab has in flight, from @agent_subagents (see the
    agent-subagents script); 0 for a tab that has none or never sets it.

    Claude-only: Codex and Antigravity tabs never write the option, so their rows
    stay bare rather than claiming a zero they haven't measured."""
    try:
        return max(0, int(w.subs))
    except (TypeError, ValueError):
        return 0


def legend(cols, view, detail, agents_only):
    # Every hint names what the key WILL do, not what is currently on — "tab hide
    # detail" beside a visible detail pane, so the label is an instruction rather
    # than a status you have to invert in your head.
    other = "grid" if view == "tree" else "tree"
    what = "detail" if view == "tree" else "panes"
    second = f"{'hide' if detail else 'show'} {what}"
    filt = "all tabs" if agents_only else "agents only"
    hint_full = (f"hjkl move · ↵ open · 1-9/a-z jump · space {other} · "
                 f"tab {second} · / {filt} · q quit")
    hint_short = f"hjkl · ↵ · space {other} · tab · / · q"

    words = [(RED, "● blocked"), (BLUE, "● working"), (YELLOW, "● done"),
             (YELLOW, "○ seen"), (GREEN, "■ server"), (DIM, "· other")]
    glyphs = [(rgb, txt.split(" ", 1)[0]) for rgb, txt in words]

    # Autowrap is off in the live loop, so an over-long legend is silently chopped
    # at the right edge — and the tail is where q quit lives. Shorten the hint
    # first, then the colour key down to bare glyphs, rather than lose the keys.
    for parts, hint in ((words, hint_full), (words, hint_short), (glyphs, hint_short)):
        left_w = sum(vis_width(txt) for _, txt in parts) + 2 * (len(parts) - 1)
        if left_w + vis_width(hint) + 2 <= cols:
            break
    left = "  ".join(f"{fg(rgb)}{txt}{RESET}" for rgb, txt in parts)
    pad = max(1, cols - left_w - vis_width(hint) - 1)
    return f"{left}{' ' * pad}{fg(DIM)}{hint}{RESET}"


def hit_test(hitboxes, x, y):
    for top, left, bottom, right, tgt in hitboxes:
        if top <= y <= bottom and left <= x <= right:
            return tgt
    return None


# ------------------------------------------------------------------ tree view

def filtered(sessions, wins, agents_only):
    """(sessions, windows, widest band) after the / filter, for BOTH views.

    Filtering has to happen before layout, not during drawing: the grid sizes its
    columns off the widest band, so a band filtered down to two tabs must not go
    on reserving twenty columns' worth of width. A session the filter empties is
    dropped outright rather than left as a blank band — a band with no tabs behind
    it is a selection that resolves to nothing."""
    out_s, out_w = [], {}
    for s in sessions:
        ws = [w for w in wins[s] if not agents_only or is_agent(w)]
        if ws:
            out_s.append(s)
            out_w[s] = ws
    return out_s, out_w, max([1] + [len(v) for v in out_w.values()])


def tree_rows(sessions, wins, folded, agents_only):
    """Flatten the tree to the rows actually on screen, top to bottom.

    ("s", session, windows) for a header, ("w", session, win) for a tab. A folded
    session contributes only its header."""
    sessions, wins, _ = filtered(sessions, wins, agents_only)
    out = []
    for s in sessions:
        out.append(("s", s, wins[s]))
        if not folded.get(s):
            out.extend(("w", s, w) for w in wins[s])
    return out


def tree_at(where, rowlist):
    """Row index of a (session, window index) in the tree.

    Falls back to the session's header row when the tab itself has no row — it is
    folded away, or the / filter dropped it — and to the top when the session
    isn't on screen at all."""
    head = 0
    for i, (kind, sname, payload) in enumerate(rowlist):
        if not where or sname != where[0]:
            continue
        if kind == "s":
            head = i
        elif payload.idx == where[1]:
            return i
    return head


def sess_summary(ws):
    """A session header's right-hand roll-up: a count per state that occurs, in
    the order that matters when you're triaging — blocked, finished-and-unseen,
    working, seen.

    The subagent total rides on the end as "+11", so a folded session still says
    how much work is under it. It hangs off the working count it belongs to, and
    is the only entry here that counts tasks rather than tabs."""
    counts = [
        (RED, "●", sum(1 for w in ws if w.state == "needs-input")),
        (YELLOW, "●", sum(1 for w in ws if w.state == "done")),
        (BLUE, "●", sum(1 for w in ws if w.state == "running")),
        (YELLOW, "○", sum(1 for w in ws if w.state == "idle")),
        (GREEN, "■", sum(1 for w in ws if w.server == "running")),
    ]
    out = [(rgb, f"{n}{glyph}") for rgb, glyph, n in counts if n]
    subs = sum(sub_count(w) for w in ws)
    if subs:
        out.append((SAPPHIRE, f"+{subs}"))
    return out


def branch_cell(w, width):
    """The branch column: green normally, and for a linked worktree the same
    peach "⑂" the status bar marks one with. The branch itself stays here, where
    the status bar replaces it with the worktree's directory name: the tree has
    a detail pane carrying the path already, so the row can spend its width on
    the thing the path doesn't tell you. Blank outside a repo — a tab in
    ~/Downloads has no branch, and inventing one would only mislead."""
    branch, wt = git_info(w.path) if w.path else ("", "")
    if not branch:
        return " " * width, OTHER
    if wt:
        return fit(f"⑂ {branch}", width), PEACH
    return fit(branch, width), GREEN


def render_tree(cols, rows, rowlist, folded, sel, top, detail, agents_only, clear):
    """Draw the tree, plus the detail pane when it's on. Returns the frame and
    the click map; `top` is the first row of rowlist on screen."""
    body_h = max(1, rows - 1)
    split = detail and cols >= 80
    left_w = max(38, min(62, cols // 3)) if split else cols
    prefix_w = 8                                    # "▌ └ 5 ● "
    # -3 = the 2 spaces between name and branch, plus one held back at the right
    # so a branch that exactly fills its column still clears the separator.
    avail = max(8, left_w - prefix_w - 3)
    # The subagent suffix gets a column only when some tab on screen actually has
    # subagents, and the width is the same for every row so they stay aligned.
    # Most of the time nothing is fanned out and this costs the tree nothing —
    # which is the only reason a column this rarely-used is worth having at all.
    sub_w = 0
    widest = max((sub_count(p) for k, _, p in rowlist if k == "w"), default=0)
    if widest:
        sub_w = 1 + len(f"+{widest}")               # the space before it, and "+11"
        avail = max(8, avail - sub_w)
    if split:
        name_w = max(10, min(20, avail // 2))
        branch_w = avail - name_w
        note_w = 0
    else:
        # No detail pane: the tree owns the full width, so what that pane would
        # have said about each tab moves onto the row itself.
        name_w = min(20, max(8, avail // 4))
        branch_w = min(30, max(8, avail // 4))
        note_w = max(0, avail - name_w - branch_w - 2)

    buf = [f"{ESC}[2J"] if clear else []
    hitboxes = []
    jumpmap = {}
    keyof = {}

    # Hotkeys are assigned over every visible tab, not only the ones currently
    # drawn, so a tab's key doesn't shift as the viewport scrolls under it.
    g = 0
    for kind, s, payload in rowlist:
        if kind != "w":
            continue
        if g < len(HOTKEYS):
            jumpmap[HOTKEYS[g]] = ("w", s, payload.idx)
            keyof[(s, payload.idx)] = HOTKEYS[g]
        g += 1

    for i in range(body_h):
        r = i + 1
        ri = top + i
        if ri >= len(rowlist):
            buf.append(at(r, 1) + RESET + " " * left_w)
            continue
        kind, s, payload = rowlist[ri]
        bar = f"{fg(PEACH)}{BOLD}▌{RESET}" if ri == sel else " "

        if kind == "s":
            ws = payload
            head = f"{'▸' if folded.get(s) else '▾'} {s} "
            summary = sess_summary(ws)
            sum_w = sum(vis_width(t) for _, t in summary) + max(0, len(summary) - 1)
            # Crop the name to what is left AFTER the roll-up, not to the whole
            # column: a session named longer than the column would otherwise push
            # its own counts off the end and write past left_w, into cells the
            # separator and detail pane then partly repaint — leaving residue.
            head = crop_plain(head, max(0, left_w - 2 - sum_w))
            rule = max(0, left_w - 1 - vis_width(head) - sum_w - 1)
            line = bar + fg(MAUVE) + BOLD + head + RESET
            line += fg(SEP) + "─" * rule + RESET + " "
            line += " ".join(f"{fg(rgb)}{t}{RESET}" for rgb, t in summary)
            target = ("s", s, None)
        else:
            w = payload
            # The last tab of a session closes the branch, so the tee depends on
            # whether the next visible row belongs to someone else.
            last = ri + 1 >= len(rowlist) or rowlist[ri + 1][0] == "s"
            rgb = state_rgb(w)
            bcell, brgb = branch_cell(w, branch_w)
            line = bar + " " + fg(SEP) + ("└" if last else "├") + RESET + " "
            line += fg(DIM) + fit(keyof.get((s, w.idx), ""), 1) + RESET + " "
            line += fg(rgb) + dot(w) + RESET + " "
            line += (fg(SUB) if is_agent(w) else fg(OTHER)) + fit(w.name, name_w) + RESET
            line += "  " + fg(brgb) + bcell + RESET
            if sub_w:
                subs = sub_count(w)
                line += " " + fg(SAPPHIRE) + fit(f"+{subs}" if subs else "", sub_w - 1) + RESET
            if note_w > 0:
                line += "  " + fg(rgb) + fit(doing(w), note_w) + RESET
            target = ("w", s, w.idx)

        buf.append(at(r, 1) + pad_ansi(line, left_w))
        hitboxes.append((r, 1, r, left_w, target))

    if split:
        # The separator write covers sx and the space after it, so the detail
        # pane starts at sx+2 and runs to the last column inclusive — every cell
        # right of the tree has to belong to someone, or it keeps last tick's text.
        sx = left_w + 1
        dx = sx + 2
        dw = max(10, cols - dx + 1)
        cur = rowlist[sel] if 0 <= sel < len(rowlist) else None
        lines = detail_lines(cur, dw, body_h)
        for i in range(body_h):
            buf.append(at(i + 1, sx) + fg(SEP) + "│" + RESET + " ")
            buf.append(at(i + 1, dx) + pad_ansi(lines[i] if i < len(lines) else "", dw))

    buf.append(at(rows, 1) + legend(cols, "tree", detail, agents_only))
    return "".join(buf), jumpmap, hitboxes


def detail_lines(cur, w, height):
    """The right-hand pane: everything about the row the cursor is on that the
    tree column had no room for, then a live snapshot of that tab."""
    if cur is None:
        return [f"{fg(DIM)}nothing selected{RESET}"]

    out = []

    def put(s=""):
        out.append(s)

    def field(label, value, rgb=SUB):
        put(f"{fg(DIM)}{fit(label, 9)}{RESET}{fg(rgb)}{crop_plain(value, w - 9)}{RESET}")

    if cur[0] == "s":
        s, ws = cur[1], cur[2]
        put(f"{fg(MAUVE)}{BOLD}{crop_plain(s, w)}{RESET}")
        agents = [x for x in ws if is_agent(x)]
        put(f"{fg(DIM)}{len(ws)} tabs · {len(agents)} with an agent{RESET}")
        put()
        for x in ws:
            rgb = state_rgb(x)
            line = f"{fg(rgb)}{dot(x)}{RESET} {fg(SUB)}{fit(x.name, 20)}{RESET}"
            line += f"{fg(DIM)}{crop_plain(doing(x), max(0, w - 24))}{RESET}"
            put(line)
        return out[:height]

    win = cur[2]
    rgb = state_rgb(win)
    put(f"{fg(SNOW)}{BOLD}{crop_plain(win.name, w)}{RESET}")

    word = "serving" if win.server == "running" else STATE_WORD.get(win.state, "")
    if word:
        age = fmt_age(win.since)
        status = f"{dot(win)} {word}" + (f" · {age}" if age else "")
        put(f"{fg(rgb)}{crop_plain(status, w)}{RESET}")
    else:
        put(f"{fg(DIM)}no agent here{RESET}")
    # Spelled out here rather than left as the row's "+3", because this pane has
    # the room to say what the number counts.
    subs = sub_count(win)
    if subs:
        word = "subagent" if subs == 1 else "subagents"
        put(f"{fg(SAPPHIRE)}+{subs} {word} in flight{RESET}")
    put()

    branch, wt = git_info(win.path) if win.path else ("", "")
    if branch:
        field("branch", f"⑂ {branch}" if wt else branch, PEACH if wt else GREEN)
        if wt:
            field("worktree", wt, PEACH)
    home = os.path.expanduser("~")
    path = win.path.replace(home, "~", 1) if win.path.startswith(home) else win.path
    # The path is the one field that reliably outruns the pane, so it wraps under
    # its own label rather than being cropped to a useless prefix.
    plines = wrap_note(path, max(1, w - 9), 3) if path else []
    for i, ln in enumerate(plines):
        field("path" if i == 0 else "", ln)

    note = doing(win)
    if note:
        put()
        for ln in wrap_note(note, w, 4):
            put(f"{fg(rgb)}{ln}{RESET}")

    if win.cap:
        put()
        head = "── pane "
        put(f"{fg(SEP)}{head}{'─' * max(0, w - vis_width(head))}{RESET}")
        room = height - len(out)
        for ln in win.cap[-room:] if room > 0 else []:
            put(cell_ansi(ln, w))

    return out[:height]


def tree_move(sel, nav, rowlist, folded):
    """Where hjkl goes in a tree, and what it folds on the way.

    j/k walk every visible row, wrapping. l opens a folded session, else steps
    into it; h climbs from a tab to its header and folds an already-selected one,
    so h,h collapses whatever you're inside of. Returns (sel, fold_change) where
    fold_change is (session, folded) when the fold state has to be written back."""
    if not rowlist:
        return sel, None
    n = len(rowlist)
    if sel is None:
        return 0, None
    kind, s, _ = rowlist[sel]

    if nav == "j":
        return (sel + 1) % n, None
    if nav == "k":
        return (sel - 1) % n, None
    if nav == "l":
        if kind == "s":
            if folded.get(s):
                return sel, (s, False)
            # Already open: drop onto its first tab, when it has one.
            if sel + 1 < n and rowlist[sel + 1][0] == "w":
                return sel + 1, None
        return sel, None
    if nav == "h":
        if kind == "w":
            for i in range(sel - 1, -1, -1):
                if rowlist[i][0] == "s":
                    return i, None
            return sel, None
        if not folded.get(s):
            return sel, (s, True)
        # Folded already — climb to the previous session, so h keeps meaning "out".
        for i in range(sel - 1, -1, -1):
            if rowlist[i][0] == "s":
                return i, None
    return sel, None


# ------------------------------------------------------------------ grid view

def box_style(state, server):
    if server == "running":
        return bg(GREEN) + fg(INK) + BOLD
    if state in STATE:
        return bg(STATE[state]) + fg(INK) + BOLD
    return bg(OTHER) + fg(SNOW) + BOLD


def note_style(state, server):
    """@agent_note line: the box's fill colour used as ink on the dark background.

    The same accent inverted, and not bold — so the note reads as part of the box
    above it rather than as a second filled block competing with the label."""
    if server == "running":
        return bg(INK) + fg(GREEN)
    if state in STATE:
        return bg(INK) + fg(STATE[state])
    return bg(INK) + fg(SNOW)


def render_grid(cols, rows, sessions, wins, maxcols, sel, show_panes, agents_only, clear):
    if not sessions:
        return f"{ESC}[2J{at(1, 1)}no sessions", {}, [], []

    nsess = len(sessions)
    cell_w = max(6, (cols - (maxcols - 1)) // maxcols)
    content_h = max(1, (rows - 1 - nsess) // nsess)

    buf = [f"{ESC}[2J"] if clear else []
    boxes = []          # (ri, ci, cstart, cx, cell_w, content_h, label, note, state, server)
    sep_rows = []
    jumpmap = {}        # hotkey -> (session, idx)
    grid = []           # grid[ri] = [(session, idx), …] in column order, for nav/Enter
    hitboxes = []       # (top, left, bottom, right, (session, idx)) for mouse clicks
    g = 0               # running cell number across all sessions
    r = 1
    for ri, s in enumerate(sessions):
        # Stop before a band would run under the legend row: content_h's floor of
        # 1 means enough sessions on a short popup ask for more rows than exist,
        # and drawing them anyway would overwrite the legend and scroll the rest
        # off the bottom. Better to show the bands that fit.
        if r + content_h > rows - 1:
            break
        fill = max(0, cols - 4 - vis_width(s))
        buf.append(at(r, 1) + fg(MAUVE) + BOLD + f"━━ {s} " + "━" * fill + RESET)
        cstart = r + 1
        rec = wins[s]
        rowcells = []
        for c in range(maxcols):
            cx = c * (cell_w + 1) + 1
            if c < len(rec):
                w = rec[c]
                hotkey = HOTKEYS[g] if g < len(HOTKEYS) else None
                g += 1
                label = f"{hotkey} {w.name}" if hotkey else w.name
                if w.server == "running" and w.port:
                    label = f"{label}  {w.port}"
                # Subagents go inside the label box rather than beside it: the
                # box is the only part of a grid cell that isn't the tab's own
                # screen, and the port already sets the precedent.
                elif sub_count(w):
                    label = f"{label}  +{sub_count(w)}"
                if hotkey:
                    jumpmap[hotkey] = (s, w.idx)
                rowcells.append((s, w.idx))
                hitboxes.append((cstart, cx, cstart + content_h - 1, cx + cell_w - 1, (s, w.idx)))
                if show_panes:
                    disp = w.cap[-content_h:]
                    disp = [""] * (content_h - len(disp)) + disp
                    for i in range(content_h):
                        buf.append(at(cstart + i, cx) + cell_ansi(disp[i], cell_w))
                else:
                    for i in range(content_h):
                        buf.append(at(cstart + i, cx) + RESET + " " * cell_w)
                boxes.append((ri, c, cstart, cx, cell_w, content_h, label,
                              w.note, w.state, w.server))
            else:
                for i in range(content_h):
                    buf.append(at(cstart + i, cx) + RESET + " " * cell_w)
        grid.append(rowcells)
        sep_rows.extend(range(cstart, cstart + content_h))
        r = cstart + content_h

    for c in range(maxcols - 1):
        sx = (c + 1) * (cell_w + 1)
        for rr in sep_rows:
            buf.append(at(rr, sx) + fg(SEP) + "│" + RESET)

    for ri, ci, cstart, cx, cw_, ch_, label, note, state, server in boxes:
        style = box_style(state, server)
        # Each note line takes a row under the box, and the last of them has to
        # stay off the cell's bottom row where the selection frame draws — so a
        # cell fits n lines when ch_ >= n + 4.
        nlines = []
        if note and cw_ >= 8:
            nlines = wrap_note(note, cw_ - 4, min(NOTE_LINES, max(0, ch_ - 4)))
        if ch_ >= 3 and cw_ >= 8:
            lab = crop_plain(label, cw_ - 6)
            interior = vis_width(lab) + 4
            bw = interior + 2
            bx = cx + max(0, (cw_ - bw) // 2)
            # Box and notes are centred together as one (3 + n)-row unit, so the
            # box rises to make room instead of the notes hanging off the bottom.
            brow = cstart + max(0, (ch_ - (3 + len(nlines))) // 2)
            buf.append(at(brow, bx) + style + "┌" + "─" * interior + "┐" + RESET)
            buf.append(at(brow + 1, bx) + style + "│  " + lab + "  │" + RESET)
            buf.append(at(brow + 2, bx) + style + "└" + "─" * interior + "┘" + RESET)
            nstyle = note_style(state, server)
            for i, ln in enumerate(nlines):
                txt = f" {ln} "
                nx = cx + max(0, (cw_ - vis_width(txt)) // 2)
                buf.append(at(brow + 3 + i, nx) + nstyle + txt + RESET)
        else:
            buf.append(at(cstart, cx) + style + crop_plain(f" {label} ", cw_) + RESET)

    # Heavy peach frame around the selected cell, drawn last so it sits on top of
    # content, separators and the label box.
    if sel is not None:
        for ri, ci, cstart, cx, cw_, ch_, label, note, state, server in boxes:
            if (ri, ci) != sel:
                continue
            if cw_ >= 2 and ch_ >= 2:
                hl = fg(PEACH) + BOLD
                top, bottom, left, right = cstart, cstart + ch_ - 1, cx, cx + cw_ - 1
                buf.append(at(top, left) + hl + "┏" + "━" * (cw_ - 2) + "┓" + RESET)
                for rr in range(top + 1, bottom):
                    buf.append(at(rr, left) + hl + "┃" + RESET)
                    buf.append(at(rr, right) + hl + "┃" + RESET)
                buf.append(at(bottom, left) + hl + "┗" + "━" * (cw_ - 2) + "┛" + RESET)
            break

    buf.append(at(rows, 1) + legend(cols, "grid", show_panes, agents_only))
    return "".join(buf), jumpmap, grid, hitboxes


def grid_move(sel, nav, grid):
    """Next selection after an hjkl/arrow move, wrapping at every edge.

    From no selection we enter the grid in the pressed direction: l → top-left,
    h → top-right, j → second row (col 0), k → last row (col 0). Once selected,
    h/l wrap within the session band and j/k wrap across bands (clamping the
    column into the target band, which may be shorter)."""
    nrows = len(grid)
    if nrows == 0:
        return None
    if sel is None:
        if nav == "l":
            return (0, 0)
        if nav == "h":
            return (0, max(0, len(grid[0]) - 1))
        if nav == "j":
            return (1 % nrows, 0)
        if nav == "k":
            return (nrows - 1, 0)
        return None
    r, c = sel
    # The selection can outlive the band it pointed at: sessions come and go
    # between ticks, the / filter drops bands, and a short popup stops drawing
    # bands that would run under the legend — so `grid` is not always as long as
    # the session list. Fall back to no selection rather than index off the end.
    if r >= len(grid) or not grid[r]:
        return None
    if nav == "h":
        c = (c - 1) % len(grid[r])
    elif nav == "l":
        c = (c + 1) % len(grid[r])
    elif nav == "j":
        r = (r + 1) % nrows
        c = min(c, max(0, len(grid[r]) - 1))
    elif nav == "k":
        r = (r - 1) % nrows
        c = min(c, max(0, len(grid[r]) - 1))
    return (r, c)


def grid_at(where, sessions, wins):
    """(band, col) of a (session, window index) in the grid, against the FILTERED
    bands the caller is about to draw — None when the tab isn't among them."""
    if not where or where[0] not in wins:
        return None
    for c, w in enumerate(wins[where[0]]):
        if w.idx == where[1]:
            return sessions.index(where[0]), c
    return None


# ----------------------------------------------------------------------- main

ARROWS = {"\x1b[A": "k", "\x1b[B": "j", "\x1b[C": "l", "\x1b[D": "h",
          "\x1bOA": "k", "\x1bOB": "j", "\x1bOC": "l", "\x1bOD": "h"}
MOUSE_RE = re.compile(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])")


def open_target(target):
    """Go where the popup was pointed, after it has closed.

    The grid hands back a plain (session, index); the tree tags its rows, so a
    session header can switch sessions without also picking a tab for you —
    tmux's own current window for that session is the better answer there."""
    if len(target) == 3:
        kind, sname, idx = target
    else:
        kind, (sname, idx) = "w", target
    if kind == "w":
        tmux("select-window", "-t", f"{sname}:{idx}")
    tmux("switch-client", "-t", sname)


def main():
    if not sys.stdin.isatty():
        cols, rows = shutil.get_terminal_size((100, 30))
        view = opt(VIEW_OPT, "tree")
        detail = opt(DETAIL_OPT, "on") != "off"
        panes = opt(PANES_OPT, "on") != "off"
        agents_only = opt(AGENTS_OPT, "off") == "on"
        if view == "grid":
            sessions, wins, _ = gather(panes)
            sessions, wins, maxcols = filtered(sessions, wins, agents_only)
            frame = render_grid(cols, rows, sessions, wins, maxcols, None,
                                panes, agents_only, clear=True)[0]
        else:
            sessions, wins, folded = gather()
            rowlist = tree_rows(sessions, wins, folded, agents_only)
            frame = render_tree(cols, rows, rowlist, folded, 0, 0, detail,
                                agents_only, clear=True)[0]
        sys.stdout.write(frame)
        return
    run_live()


def run_live():
    import termios
    import tty

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    target = None
    view = opt(VIEW_OPT, "tree")
    detail = opt(DETAIL_OPT, "on") != "off"
    panes = opt(PANES_OPT, "on") != "off"
    agents_only = opt(AGENTS_OPT, "off") == "on"
    # Both views open on the tab prefix+o was pressed in. `placed` is what keeps
    # that a one-shot per view: the opening selection is a starting point, not a
    # pull, so once a view has taken it, moving away sticks — including when the
    # cursor lands back on nothing after a session vanishes under it.
    where = here()
    placed = set()
    gsel = None         # grid: (band, col), or None when nothing is selected
    tsel = 0            # tree: index into the visible row list
    top = 0             # tree: first row on screen
    rowlist, grid, folded = [], [], {}
    try:
        tty.setraw(fd)
        # hide cursor, disable autowrap, clear, enable SGR mouse reporting
        sys.stdout.write(f"{ESC}[?25l{ESC}[?7l{ESC}[2J{ESC}[?1000h{ESC}[?1006h")
        prev = None
        while True:
            cols, rows = shutil.get_terminal_size((100, 30))
            body_h = max(1, rows - 1)

            if view == "grid":
                sessions, wins, folded = gather(panes)
                sessions, wins, maxcols = filtered(sessions, wins, agents_only)
                # Drop a stale selection if the layout shrank under it. Measured
                # against the FILTERED bands, so turning / on with a high column
                # selected clears it instead of leaving it pointing past the end.
                if gsel is not None and (
                    gsel[0] >= len(sessions)
                    or gsel[1] >= len(wins.get(sessions[gsel[0]], []))
                ):
                    gsel = None
                if "grid" not in placed:
                    placed.add("grid")
                    gsel = grid_at(where, sessions, wins)
                dims = (view, cols, rows, len(sessions), maxcols, panes, agents_only)
                frame, jumpmap, grid, hitboxes = render_grid(
                    cols, rows, sessions, wins, maxcols, gsel, panes, agents_only,
                    clear=dims != prev)
            else:
                sessions, wins, folded = gather()
                rowlist = tree_rows(sessions, wins, folded, agents_only)
                if "tree" not in placed:
                    placed.add("tree")
                    tsel = tree_at(where, rowlist)
                tsel = max(0, min(tsel, len(rowlist) - 1)) if rowlist else 0
                # Keep the cursor on screen, scrolling only as far as it takes.
                top = max(0, min(top, max(0, len(rowlist) - body_h)))
                if tsel < top:
                    top = tsel
                elif tsel >= top + body_h:
                    top = tsel - body_h + 1
                # Exactly one snapshot per tick, of the tab the detail pane is
                # about to show — not a second pass over every window.
                if detail and cols >= 80 and rowlist and rowlist[tsel][0] == "w":
                    _, s, w = rowlist[tsel]
                    rowlist[tsel] = ("w", s, w._replace(cap=capture_pane(s, w.idx)))
                # `top` is deliberately NOT in dims: every body row is repainted
                # in full each tick, so scrolling needs no clear — and forcing
                # one would flash the whole popup on every j past the edge.
                dims = (view, cols, rows, len(rowlist), detail, agents_only)
                frame, jumpmap, hitboxes = render_tree(
                    cols, rows, rowlist, folded, tsel, top, detail, agents_only,
                    clear=dims != prev)

            sys.stdout.write(frame)
            sys.stdout.flush()
            prev = dims
            if not select.select([sys.stdin], [], [], INTERVAL)[0]:
                continue
            data = os.read(fd, 1024)
            if not data:
                continue
            s = data.decode("utf-8", "ignore")
            m = MOUSE_RE.search(s)
            if m:
                b, x, y, typ = int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4)
                if typ == "M" and (b & 0xE3) == 0:        # left press, no motion/wheel
                    hit = hit_test(hitboxes, x, y)
                    if hit:
                        target = hit
                        break
                continue
            for seq, kk in ARROWS.items():
                if s.startswith(seq):
                    s = kk
                    break
            ch = s[0] if s else ""

            # No length test here: holding j batches several bytes into one read,
            # and requiring exactly one would drop the lot. Escape sequences can't
            # be mistaken for a move — ARROWS has already rewritten the ones we
            # accept, and every other starts with ESC, not a letter.
            if ch in "hjkl":
                if view == "grid":
                    gsel = grid_move(gsel, ch, grid)
                else:
                    tsel, fold = tree_move(tsel, ch, rowlist, folded)
                    if fold:
                        tmux("set-option", "-t", fold[0], FOLD_OPT, "1" if fold[1] else "0")
                continue
            if ch == " ":
                view = "grid" if view == "tree" else "tree"
                set_opt(VIEW_OPT, view)
                continue
            if ch == "\t":
                if view == "grid":
                    panes = not panes
                    set_opt(PANES_OPT, "on" if panes else "off")
                else:
                    detail = not detail
                    set_opt(DETAIL_OPT, "on" if detail else "off")
                continue
            if ch == "/":
                agents_only = not agents_only
                set_opt(AGENTS_OPT, "on" if agents_only else "off")
                continue
            if ch in ("\r", "\n"):
                if view == "grid":
                    # Bounds-check rather than trust gsel: the bands can shrink
                    # under it between ticks, and an IndexError here would take
                    # the popup down with it (-E) as if Enter had simply quit.
                    if (gsel is not None and gsel[0] < len(grid)
                            and gsel[1] < len(grid[gsel[0]])):
                        target = grid[gsel[0]][gsel[1]]
                        break
                elif rowlist:
                    kind, sname, payload = rowlist[tsel]
                    target = ("s", sname, None) if kind == "s" else ("w", sname, payload.idx)
                    break
                continue
            # A bare ESC quits, but an escape *sequence* must not: PageUp, Home,
            # Delete, F-keys and modified arrows all arrive as ESC + more, and
            # closing the popup on those is the opposite of ignoring them.
            if ch in ("q", "\x03") or (ch == "\x1b" and len(s) == 1):
                break
            if ch in jumpmap:
                target = jumpmap[ch]
                break
            # anything else: ignore (do not close)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        # disable mouse, restore autowrap + cursor
        sys.stdout.write(f"{ESC}[?1000l{ESC}[?1006l{ESC}[?7h{ESC}[?25h{RESET}")
    if target:
        open_target(target)


if __name__ == "__main__":
    main()
